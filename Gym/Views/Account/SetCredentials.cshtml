@model Gym.Models.SetCredentialsViewModel

@{
    ViewData["Title"] = "Set Account Credentials";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Included Bootstrap Icons for eye toggles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            padding: 0;
            margin: 0;
        }

        body {
            min-height: 100vh;
            width: 100vw;
            background: rgb(96,94,105);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            font-family: 'Inria Serif', serif;
        }

        .login-wrap {
            position: relative;
            width: 100vw;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bg {
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .login-form {
            position: relative;
            z-index: 2;
            width: 90%;
            max-width: 450px;
            max-height: 90vh;
            background-color: rgba(255, 255, 255, 0.85);
            display: flex;
            flex-direction: column;
            padding: 30px;
            border-radius: 40px;
            border: 3px solid rgb(96,94,105);
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2);
            overflow-y: auto;
        }

            .login-form::-webkit-scrollbar {
                width: 6px;
            }

            .login-form::-webkit-scrollbar-thumb {
                background-color: rgba(0,0,0,0.2);
                border-radius: 10px;
            }

        .title {
            text-align: center;
            margin-bottom: 12px;
        }

            .title img {
                height: 70px;
                width: 70px;
                border-radius: 50%;
                border: 2px solid rgb(255,255,255);
                object-fit: cover;
                margin-bottom: 10px;
            }

        .role {
            display: flex;
            align-items: center;
            justify-content: center;
            text-transform: uppercase;
            font-size: 18px;
            font-style: italic;
            font-weight: 300;
            color: rgba(0,0,0,0.6);
            letter-spacing: 1px;
        }

            .role::before,
            .role::after {
                content: "";
                flex: 1;
                border-bottom: 2px dotted rgba(0,0,0,0.4);
                margin: 0 10px;
            }

        .reminder {
            text-align: center;
            margin-bottom: 20px;
        }

            .reminder h6 {
                font-size: 0.85rem;
                color: rgba(0,0,0,0.6);
                letter-spacing: 0.5px;
                line-height: 1.4;
                margin: 0;
            }

            .reminder .highlight {
                font-weight: 700;
                color: rgba(0,0,0,0.7);
            }

        form {
            display: flex;
            flex-direction: column;
            width: 100%;
            gap: 15px;
        }

        .form-group label {
            color: rgb(14,197,45);
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 4px;
            display: block;
        }

        .form-group input {
            border: 1px solid rgb(14,197,45);
            padding: 10px 12px;
            width: 100%;
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.2s ease-in-out;
        }

            .form-group input::placeholder {
                color: rgba(14,197,45, 0.6);
            }

            .form-group input:focus,
            .form-group input:hover {
                border-color: rgb(14,197,45);
                box-shadow: 2px 2px 4px rgba(96,94,105, 0.3);
                background: #fff;
            }

        /* --- Password Input Container & Eye Toggle CSS --- */
        .password-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

            .password-wrapper input {
                padding-right: 40px; /* Leave space so text doesn't overlap eye icon */
            }

        .toggle-password {
            position: absolute;
            right: 12px;
            cursor: pointer;
            color: rgb(14,197,45);
            font-size: 1.2rem;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-submit {
            width: 100%;
            height: 45px;
            margin-top: 10px;
            background: rgb(178,233,197);
            color: #000;
            border: none;
            font-size: 1.05rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s ease-in-out, color 0.2s ease-in-out;
        }

            .btn-submit:hover {
                background: rgb(14,197,45);
                color: #fff;
            }
    </style>
</head>
<body>
    <section class="login-wrap">
        <img src="~/images/login.png" alt="background" class="bg" />

        <div class="login-form">
            <div class="title">
                <img src="~/images/Yokok.jpg" alt="Gym logo" />
                <div class="role"> <h3>ACCOUNT SETUP</h3> </div>
            </div>

            <div class="reminder">
                <h6>
                    Please set up your <span class="highlight">Username and Password</span> to finalize registration and activate your account.
                </h6>
            </div>

            <form asp-controller="Account" asp-action="SetCredentials" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small text-center"></div>

                <div class="form-group">
                    <label asp-for="Username" class="form-label">Choose Username</label>
                    <input asp-for="Username" class="form-control" placeholder="Enter desired username" autocomplete="off" required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="password-wrapper">
                        <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="Enter password" required />
                        <span class="toggle-password" onclick="togglePassword('passwordInput', this)">
                            <i class="bi bi-eye-slash"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <div class="password-wrapper">
                        <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control" placeholder="Re-enter password" required />
                        <span class="toggle-password" onclick="togglePassword('confirmPasswordInput', this)">
                            <i class="bi bi-eye-slash"></i>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-submit">Set Credentials & Activate</button>
            </form>
        </div>
    </section>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- JavaScript to toggle show/hide functionality -->
    <script>
        function togglePassword(inputId, toggleContainer) {
            const input = document.getElementById(inputId);
            const icon = toggleContainer.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            }
        }
    </script>
</body>
</html>