@model Gym.Models.StaffViewModel
@{
    ViewData["Title"] = "Staff Registration";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        padding: 0;
        margin: 0;
    }

    body {
        min-height: 100vh;
        width: 100vw;
        background: #171b18;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        font-family: 'Inria Serif', serif;
    }

    body > main,
    body > main > div {
        background: #171b18;
    }

    .login-wrap {
        position: relative;
        width: 100vw;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: #171b18;
    }

    .login-form {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: none;
        min-height: 100vh;
        max-height: 100vh;
        background-color: #171b18;
        display: flex;
        flex-direction: column;
        padding: 30px 35px;
        border-radius: 10px;
        border: 1px solid #59635c;
        box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2);
        overflow-y: auto;
    }

        .login-form::-webkit-scrollbar {
            width: 6px;
        }

        .login-form::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.2);
            border-radius: 10px;
        }

    .title {
        text-align: center;
        margin-bottom: 12px;
    }

        .title img {
            height: 60px;
            width: 60px;
            border-radius: 50%;
            border: 2px solid rgb(255,255,255);
            object-fit: cover;
            margin-bottom: 8px;
        }

    .role {
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        font-size: 18px;
        font-style: italic;
        font-weight: 300;
        color: #fff;
        letter-spacing: 1px;
    }

        .role::before,
        .role::after {
            content: "";
            flex: 1;
            border-bottom: 2px dotted #7b847d;
            margin: 0 10px;
        }

    .reminder {
        text-align: center;
        margin-bottom: 15px;
    }

        .reminder h6 {
            font-size: 0.85rem;
            color: #fff;
            letter-spacing: 0.5px;
            line-height: 1.4;
        }

    form {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .staff-fields-wrapper {
        width: 100%;
        padding: 22px;
        border-radius: 9px;
        background: #5e5d63;
    }

    .form-group label {
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 4px;
        display: block;
    }

    .form-group input,
    .form-group select {
        border: 1px solid #a8df32;
        background: transparent;
        color: #fff;
        padding: 8px 12px;
        width: 100%;
        border-radius: 8px;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease-in-out;
    }

        .form-group input::placeholder {
            color: #c5ccc7;
        }

        .form-group input:focus,
        .form-group input:hover,
        .form-group select:focus,
        .form-group select:hover {
            border-color: #a8df32;
            box-shadow: 0 0 0 4px rgba(168, 223, 50, .22);
            background: transparent;
        }

    /* --- Form Divider & Button Styling --- */
    .btn-submit {
        min-width: 210px;
        height: 45px;
        margin: 0;
        background: #a8df32;
        color: #101510;
        border: none;
        font-size: 1.05rem;
        font-weight: 600;
        border-radius: 0;
        cursor: pointer;
        transition: background 0.2s ease-in-out, color 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

        .btn-submit:hover {
            background: #171b18;
            color: #b7ff1b;
            border: 1px solid #b7ff1b;
        }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 12px 0;
        color: rgba(0,0,0,0.5);
        font-size: 0.85rem;
        font-weight: 600;
    }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(0, 0, 0, 0.2);
        }

        .divider:not(:empty)::before {
            margin-right: .5em;
        }

        .divider:not(:empty)::after {
            margin-left: .5em;
        }

    .btn-back {
        min-width: 130px;
        height: 45px;
        background: transparent;
        color: #fff;
        border: 1px solid #8d958f;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 0;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

        .btn-back:hover {
            background: transparent;
            color: #b7ff1b;
            border-color: #b7ff1b;
        }

    .staff-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .form-group select option {
        background: #171b18;
        color: #fff;
    }

    .form-group select {
        border: 1px solid #fff;
        box-shadow: none;
    }

    .form-group select:hover,
    .form-group select:focus {
        border: 1px solid #fff;
        box-shadow: none;
    }

    .form-group select option:hover,
    .form-group select option:checked {
        background: #171b18;
        color: #a8df32;
    }

    .form-group input[type="date"] {
        color-scheme: dark;
    }

    .form-group input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(1);
        opacity: 1;
    }

    /* Mobile Responsive Optimizations */
    @@media (max-width: 576px) {
        .login-form {
            padding: 20px;
            border-radius: 10px;
        }

        .role h3 {
            font-size: 1.2rem;
        }
    }
</style>

<section class="login-wrap">
    <div class="login-form">
        <div class="title">
            <img src="~/images/Yokok.jpg" alt="Gym Logo" />
            <div class="role"> <h3>STAFF REGISTRATION</h3> </div>
        </div>

        <div class="reminder">
            <h6>Register new staff accounts for Yokoks Gym management.</h6>
        </div>

        <form asp-controller="Account" asp-action="RegisterStaff" method="post">
            @Html.AntiForgeryToken()
            <div class="staff-fields-wrapper">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small text-center"></div>

                <!-- Full Name -->
                <div class="row g-2 mb-2">
                    <div class="col-12 form-group">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Temporary account credentials set by the administrator -->
                <div class="row g-2 mb-2">
                    <div class="col-12 form-group">
                        <label asp-for="Username" class="form-label">Temporary Username</label>
                        <input asp-for="Username" class="form-control" autocomplete="off" placeholder="Enter temporary username" required />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6 form-group">
                        <label asp-for="Password" class="form-label">Temporary Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="At least 6 characters" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat temporary password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Email & Phone Number -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6 form-group">
                        <label asp-for="Email" class="form-label">Gmail Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@gmail.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="09123456789" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Birthday & Sex -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6 form-group">
                        <label asp-for="Birthday" class="form-label">Birthday</label>
                        <input asp-for="Birthday" type="date" class="form-control" required />
                        <span asp-validation-for="Birthday" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="Sex" class="form-label">Sex</label>
                        <select asp-for="Sex" class="form-select" required>
                            <option value="">Select Sex</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Sex" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Role & Address -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6 form-group">
                        <label asp-for="Role" class="form-label">Role</label>
                        <select asp-for="Role" class="form-select" required>
                            <option value="">Select Role</option>
                            <option value="Trainer">Trainer</option>
                            <option value="Staff">Staff / Front Desk</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Enter Full Address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="staff-form-actions">
                <button type="button" class="btn-back" onclick="cancelStaffRegistration()">Cancel</button>
                <button type="submit" class="btn-submit">✓ &nbsp; Register Staff Member</button>
            </div>
        </form>
    </div>
</section>

<script>
    function cancelStaffRegistration() {
        if (window.parent !== window && typeof window.parent.closeStaffRegistry === 'function') {
            window.parent.closeStaffRegistry();
            return;
        }
        window.history.back();
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
