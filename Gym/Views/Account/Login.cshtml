@model Gym.Models.LoginViewModel
@{
    ViewData["Title"] = "Login Page";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        padding: 0;
        margin: 0;
    }

    body {
        min-height: 100vh;
        width: 100%;
        background: #000;
        font-family: 'Inria Serif', serif;
        overflow-x: hidden;
        margin-bottom: 0 !important;
    }

    body:has(#login-access) main > .pb-3 {
        padding-bottom: 0 !important;
    }

    .login-wrap {
        position: relative;
        width: 100%;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: transparent;
    }

    .bg {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .login-form {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 450px;
        max-height: calc(100vh - 40px);
        background-color: #171b18;
        color: #fff;
        font-size: 15px;
        display: flex;
        flex-direction: column;
        padding: 30px;
        border-radius: 30px;
        border: 3px solid rgb(96,94,105);
        box-shadow: 0 18px 48px rgba(0, 0, 0, .78), 0 0 28px rgba(168, 223, 50, .24);
        overflow-y: auto;
    }

    @@media (min-height: 900px) {
        body:has(#login-access) {
            overflow-y: hidden;
        }
    }

        .login-form::-webkit-scrollbar {
            width: 6px;
        }

        .login-form::-webkit-scrollbar-thumb {
            background-color: rgba(0, 0, 0, 0.2);
            border-radius: 10px;
        }

    .title {
        text-align: center;
        margin-bottom: 12px;
    }

        .title img {
            height: 75px;
            width: 75px;
            border-radius: 50%;
            border: 2px solid #fff;
            object-fit: cover;
            margin-bottom: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

    .role {
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        font-size: 1.1rem;
        font-style: italic;
        font-weight: 300;
        color: #fff;
        letter-spacing: 1px;
    }

        .role h1 {
            margin: 0;
            font-size: 30px !important;
        }

        .role::before,
        .role::after {
            content: "";
            flex: 1;
            border-bottom: 2px dotted rgba(255, 255, 255, .5);
            margin: 0 10px;
        }

    .reminder {
        text-align: center;
        margin-bottom: 20px;
    }

        html body #login-access .reminder h2 {
            font-size: 16px !important;
            color: #fff;
            letter-spacing: 0.5px;
            line-height: 1.4;
            margin: 0;
        }

        .reminder .highlight {
            font-weight: 700;
            color: #fff;
        }

    form {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 15px;
    }

    html body #login-access .form-group label {
        color: rgb(14, 160, 38);
        font-weight: 700;
        font-size: 16px !important;
        margin-bottom: 6px;
        display: block;
    }

    html body #login-access .form-group input.form-control {
        border: 1.5px solid rgb(14, 197, 45) !important;
        padding: 10px 14px;
        width: 100%;
        border-radius: 8px;
        font-size: 16px !important;
        outline: none;
        background: #fff;
        transition: all 0.2s ease-in-out;
    }

        html body #login-access .form-group input::placeholder {
            color: rgba(14, 160, 38, 0.5);
            font-size: 14px !important;
        }

        html body #login-access .form-group input.form-control:focus {
            border-color: rgb(14, 197, 45) !important;
            box-shadow: 0 0 0 3px rgba(14, 197, 45, 0.2);
        }

    .btn-submit {
        width: 100%;
        height: 45px;
        background: rgb(178, 233, 197);
        color: #000;
        border: none;
        font-size: 20px;
        font-weight: 700;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background 0.2s ease-in-out, color 0.2s ease-in-out;
    }

        .btn-submit:hover {
            background: rgb(14, 197, 45);
            color: #fff;
        }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        margin: 2px 0;
    }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(255, 255, 255, .45);
        }

        .divider span {
            padding: 0 10px;
        }

    .login-form .small,
    .login-form small {
        font-size: 15px !important;
    }

    html body #loginForm .login-action {
        appearance: none !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        min-height: 45px !important;
        height: 45px !important;
        padding: 0 14px !important;
        border: 0 !important;
        border-radius: 8px !important;
        background: rgb(178, 233, 197) !important;
        color: #000 !important;
        font-family: "Inria Serif", serif !important;
        font-size: 16px !important;
        font-weight: 700 !important;
        line-height: 1 !important;
        letter-spacing: 0 !important;
        text-decoration: none !important;
        text-transform: none !important;
        text-align: center !important;
        cursor: pointer !important;
    }

    html body #loginForm .login-action:hover,
    html body #loginForm .login-action:focus {
        background: rgb(14, 197, 45) !important;
        color: #fff !important;
    }
</style>

<section class="login-wrap">
    <img src="~/images/login.png" alt="login background" class="bg" />

    <div class="login-form" id="login-access">
        <div class="title">
            <img src="~/images/Yokok.jpg" alt="Gym logo" />
            <div class="role">
                <h1>LOGIN ACCESS</h1>
            </div>
        </div>

        <div class="reminder">
            <h2>
                To access your role account, please sign in with your <span class="highlight">verified Username and Password</span>.
                <br /><br />
                <span>Access is restricted to authorized Yokoks staff.</span>
            </h2>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center py-2 mb-3 small">
                @TempData["SuccessMessage"]
            </div>
        }

        <form id="loginForm" asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small text-center"></div>

            <div class="form-group">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" placeholder="Enter Username" required />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter Password" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <a asp-controller="PasswordRecovery" asp-action="Index" style="display:block;text-align:right;margin:12px 0;color:#b7ff1b;">Forgot password?</a>
            <button type="submit" class="btn-submit login-action mt-2"
                    style="height:45px!important;min-height:45px!important;padding:0 14px!important;font-family:'Inria Serif',serif!important;font-size:16px!important;font-weight:700!important;line-height:1!important;">
                Login
            </button>

            <div class="divider">
                <span>OR</span>
            </div>

            <a asp-controller="MainHomepage" asp-action="Index" class="btn-submit login-action"
               style="height:45px!important;min-height:45px!important;padding:0 14px!important;font-family:'Inria Serif',serif!important;font-size:16px!important;font-weight:700!important;line-height:1!important;">
                Back to Home Page
            </a>
        </form>
    </div>
</section>
