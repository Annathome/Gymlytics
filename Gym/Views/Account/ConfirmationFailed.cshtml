@{
    ViewData["Title"] = "Confirmation Failed";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="container mt-5 text-center" style="max-width: 450px;">
    <div class="card shadow-sm p-4">
        <h3 class="mb-3 text-danger">✕ Registration Failed</h3>
        <p class="text-muted">
            @(ViewBag.Error ?? "This confirmation link is invalid or has expired (30-minute limit). Please ask an admin to send a new invitation.")
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary w-100 mt-2">Back to Login</a>
    </div>
</div>