@model Gym.Models.ChangePasswordViewModel
@{ Layout = null; ViewData["Title"] = "Set Credentials"; }
<!DOCTYPE html>
<html lang="en"><head><link rel="stylesheet" href="~/css/system-typography.css" asp-append-version="true" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Set Credentials - YOKOKS</title><link rel="stylesheet" href="~/css/view-theme.css" asp-append-version="true"/><link href="https://fonts.googleapis.com/css2?family=Inria+Serif:wght@300;400;700&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#eef5f1;font-family:Arial,sans-serif;color:#102630}.credential-card{width:min(480px,100%);padding:30px;background:#fff;border-top:7px solid #083d02;border-radius:9px;box-shadow:0 12px 32px rgba(17,48,31,.14)}h1{margin:0 0 7px;}p{margin:0 0 24px;color:#637069;line-height:1.45}.validation-summary-errors{margin-bottom:16px;padding:11px 13px;border:1px solid #efb3b3;border-radius:6px;background:#fff0f0;color:#a51f1f}.validation-summary-valid{display:none}.field{margin-bottom:16px}.field label{display:block;margin-bottom:6px;font-weight:700}.field input{width:100%;height:45px;padding:0 13px;border:1px solid #c9d5ce;border-radius:6px;background:#f8fbf9;}.field input:focus{outline:2px solid rgba(8,75,2,.18);border-color:#084b02}.error{display:block;margin-top:5px;color:#b91c1c;}.actions{display:flex;gap:12px;margin-top:24px}.back,.save{height:44px;border-radius:6px;font-weight:700}.back{flex:1;display:grid;place-items:center;border:1px solid #bcc8c1;color:#445149;text-decoration:none;background:#fff}.save{flex:1.35;border:0;background:#084b02;color:#fff;cursor:pointer}.hint{color:#76827b;margin-top:-7px;margin-bottom:15px}
</style></head><body><main class="credential-card"><h1>Change Credentials</h1><p>Confirm your current credentials, then choose the username and password you want to use.</p>
<form asp-controller="Account" asp-action="ChangePassword" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div>
<div class="field"><label asp-for="CurrentUsername"></label><input asp-for="CurrentUsername" autocomplete="username"/><span class="error" asp-validation-for="CurrentUsername"></span></div>
<div class="field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password"/><span class="error" asp-validation-for="CurrentPassword"></span></div>
<div class="field"><label asp-for="NewUsername"></label><input asp-for="NewUsername" autocomplete="username"/><span class="error" asp-validation-for="NewUsername"></span></div>
<div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password"/><span class="error" asp-validation-for="NewPassword"></span></div><div class="hint">Use at least 6 characters.</div>
<div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password"/><span class="error" asp-validation-for="ConfirmPassword"></span></div>
<div class="actions"><a class="back" href="javascript:history.back()">Cancel</a><button class="save" type="submit">Save credentials</button></div></form></main></body></html>

<script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/form-errors.js" asp-append-version="true"></script>
