@model IEnumerable<Gym.Models.NotificationViewModel>
@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "Notifications";
    var notifications = Model?.ToList() ?? new List<Gym.Models.NotificationViewModel>();
}

<style>
    .trainer-notifications { width: min(1000px, calc(100vw - 340px)); margin: 30px auto; color: #f0f7f1; font-size: 15px; }
    .tn-title { margin: 0 0 22px; color: #7cef72; font-size: 29px; }
    .tn-list { overflow: hidden; border: 1px solid #287524; border-radius: 9px; background: #083013; }
    .tn-item { display: grid; grid-template-columns: 42px 1fr auto; gap: 15px; align-items: start; padding: 18px 20px; border-bottom: 1px solid rgba(124,239,114,.17); }
    .tn-item:last-child { border-bottom: 0; }
    .tn-icon { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: rgba(124,239,114,.15); color: #7cef72; }
    .tn-item.cancelled .tn-icon { background: rgba(239,68,68,.14); color: #ff8b8b; }
    .tn-copy h2 { margin: 0 0 6px; color: #fff; font-size: 17px; }
    .tn-copy p { margin: 0; color: #b9cbbb; line-height: 1.45; }
    .tn-date { color: #91a393; font-size: 12px; white-space: nowrap; }
    .tn-empty { padding: 50px 20px; text-align: center; color: #b9cbbb; }
    @@media (max-width: 700px) { .trainer-notifications { width: calc(100vw - 36px); } .tn-item { grid-template-columns: 36px 1fr; } .tn-date { grid-column: 2; } }
</style>

<main class="trainer-notifications">
    <h1 class="tn-title">Notifications</h1>
    <section class="tn-list">
        @if (notifications.Count == 0)
        {
            <div class="tn-empty">No notifications yet.</div>
        }
        @foreach (var item in notifications)
        {
            var cancelled = item.NotificationType.EndsWith(":Cancelled", StringComparison.OrdinalIgnoreCase);
            var assigned = item.NotificationType == "NewMemberAssigned";
            <article class="tn-item @(cancelled ? "cancelled" : "")">
                <span class="tn-icon"><i class="bi @(assigned ? "bi-person-plus-fill" : cancelled ? "bi-x-lg" : "bi-check-lg")"></i></span>
                <div class="tn-copy"><h2>@item.Title</h2><p>@item.Message</p></div>
                <time class="tn-date">@item.CreatedDate.ToString("MMM d, yyyy h:mm tt")</time>
            </article>
        }
    </section>
</main>
