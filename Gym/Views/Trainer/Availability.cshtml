@model Gym.Models.TrainerAvailabilityViewModel
@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "Weekly Availability";
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    var timeOptions = Enumerable.Range(0, 33)
        .Select(index => TimeSpan.FromHours(6).Add(TimeSpan.FromMinutes(index * 30)))
        .ToList();
}

<style>
    .availability-page {
        max-width: 1050px;
        margin: 32px auto;
        color: #d9eadc;
        font: 15px Arial, sans-serif;
    }

        .availability-page h1 {
            margin: 0 0 7px;
            color: #63ff43;
            font-size: 31px;
        }

        .availability-page .lead {
            margin: 0 0 28px !important;
            color: #a9bdaa;
        }

    .availability-alert {
        margin-bottom: 18px;
        padding: 13px 16px;
        border: 1px solid #2a8c32;
        border-radius: 8px;
        background: #0b3c1b;
        color: #bff7c5;
    }

    .availability-card {
        padding: 27px;
        border: 1px solid #227a2b;
        border-radius: 10px;
        background: #073418;
    }

        .availability-card h2 {
            margin: 0 0 20px;
            color: #65ff49;
            font-size: 21px;
        }

    .availability-days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 10px;
    }

    .day-choice input {
        position: absolute;
        opacity: 0;
    }

    .day-choice span {
        display: block;
        padding: 14px 5px;
        border: 1px solid #2c7533;
        border-radius: 7px;
        color: #c6d9c8;
        text-align: center;
        cursor: pointer;
    }

    .day-choice input:checked + span {
        border-color: #69ff50;
        background: #175820;
        color: #fff;
        box-shadow: inset 0 3px #69ff50;
    }

    .availability-fields {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 18px;
        margin-top: 24px;
    }

    .availability-field label {
        display: block;
        margin-bottom: 7px;
        font-weight: 700;
    }

    .availability-field input,
    .availability-field select {
        width: 100%;
        height: 46px;
        padding: 0 12px;
        border: 1px solid #34743a;
        border-radius: 7px;
        background: transparent;
        color: #fff;
        box-sizing: border-box;
    }

    .availability-field select {
        background: #171b18;
        color: #fff;
        color-scheme: dark;
    }

    .availability-field select option {
        background: #171b18;
        color: #fff;
    }

    .availability-field select option:hover,
    .availability-field select option:checked {
        background: #171b18;
        color: #a8df32;
    }

    .availability-note {
        margin: 22px 0 0;
        padding: 14px;
        color: #b7cbb9;
        line-height: 1.5;
        font-size: 15px;
    }

    .availability-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 24px;
    }

    .availability-save {
        padding: 12px 22px;
        border: 0;
        border-radius: 7px;
        background: #61f13f;
        color: #06230d;
        font-weight: 800;
        cursor: pointer;
    }

    .validation-summary-errors,
    .field-validation-error {
        color: #ff9c9c;
    }

    @@media (max-width: 800px) {
        .availability-days {
            grid-template-columns: repeat(2, 1fr);
        }

        .availability-fields {
            grid-template-columns: 1fr;
        }
    }
</style>

<main class="availability-page">
    <h1>Weekly Availability</h1>
    <p class="lead">Set the days and hours you are in the gym and the number of members you can manage each week.</p>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="availability-alert">@success</div>
    }

    <form method="post" asp-action="Availability" class="availability-card">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>

        <h2>Days available</h2>
        <div class="availability-days">
            @foreach (var day in days)
            {
                <label class="day-choice">
                    <input type="checkbox" name="SelectedDays" value="@day" checked="@Model.SelectedDays.Contains(day)" />
                    <span>@day[..3]</span>
                </label>
            }
        </div>
        <span asp-validation-for="SelectedDays"></span>

        <div class="availability-fields">
            <div class="availability-field">
                <label asp-for="StartTime">Gym start time</label>
                <select asp-for="StartTime">
                    @foreach (var time in timeOptions)
                    {
                        <option value="@time.ToString(@"hh\:mm")">@DateTime.Today.Add(time).ToString("hh:mm tt")</option>
                    }
                </select>
                <span asp-validation-for="StartTime"></span>
            </div>
            <div class="availability-field">
                <label asp-for="EndTime">Gym end time</label>
                <select asp-for="EndTime">
                    @foreach (var time in timeOptions)
                    {
                        <option value="@time.ToString(@"hh\:mm")">@DateTime.Today.Add(time).ToString("hh:mm tt")</option>
                    }
                </select>
                <span asp-validation-for="EndTime"></span>
            </div>
            <div class="availability-field">
                <label asp-for="WeeklyMemberLimit">Members per week</label>
                <input asp-for="WeeklyMemberLimit" type="number" min="1" max="100" />
                <span asp-validation-for="WeeklyMemberLimit"></span>
            </div>
        </div>

        <div class="availability-note">
            You currently have <strong>@Model.CurrentlyAssignedMembers</strong> assigned member(s).
            This schedule repeats every week and does not change unless you save a new one.
            @if (Model.LastUpdatedAt.HasValue)
            {
                <span> Last updated @Model.LastUpdatedAt.Value.ToString("MMM d, yyyy · h:mm tt")</span>
            }
        </div>

        <div class="availability-actions">
            <button class="availability-save" type="submit">Save weekly availability</button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
