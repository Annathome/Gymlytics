@model Gym.Models.FrontDeskEquipmentViewModel
@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewData["Title"] = "Equipment Report";
}

<style>
    .te-photo { color: #b7ff1b !important; text-decoration: none; }
    .te-photo:hover, .te-photo:focus-visible { color: #b7ff1b !important; text-decoration: underline; }

    .trainer-equipment {
        width: min(1100px, calc(100vw - 340px));
        margin: 30px auto;
        color: #102630;
        
    }

    .te-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 30px;
    }

        .te-header h1 {
            margin: 0 auto 0 0;
            
        }

    .te-search {
        display: flex;
        align-items: stretch;
        gap: 8px;
    }

        .te-search input {
            width: 280px;
            height: 56px !important;
            padding: 0 13px;
            border: 1px solid #c8d4cd;
            border-radius: 6px;
        }

        .te-search button {
            height: 56px !important;
            padding: 0 18px;
            border: 0;
            border-radius: 6px;
            background: #084b02;
            color: #fff;
            font-weight: 700;
        }

    .te-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .te-stat {
        padding: 18px;
        border-left: 4px solid #0ec52d;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 5px 15px rgba(30, 54, 42, .09);
    }

        .te-stat.maintenance {
            border-color: #d78a00;
        }

        .te-stat.out {
            border-color: #c62828;
        }

        .te-stat span {
            color: #fff;
            
            font-weight: 700;
        }

        .te-stat strong {
            display: block;
            margin-top: 12px;
            
        }

    .te-card {
        overflow: hidden;
        border: none;
        border-radius: 9px;
        background: #fff;
        box-shadow: 0 8px 22px rgba(0, 0, 0, .28);
    }

        .te-card h2 {
            margin: 0;
            padding: 17px 18px;
            
        }

    .te-table {
        width: 100%;
        border-collapse: collapse;
    }

        .te-table th {
            padding: 13px 18px;
            background: #394c55;
            color: #fff;
            text-align: left;
            
        }

        .te-table td {
            padding: 15px 18px;
            border-top: 1px solid #e6ebe8;
        }

    .te-name strong,
    .te-name small {
        display: block;
    }

    .te-name small {
        color: #6b766f;
    }

    .te-condition {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #e8efe9;
        
        font-weight: 700;
    }

        .te-condition.good {
            background: #caf3ce;
            color: #176b2c;
        }

        .te-condition.needs-maintenance {
            background: #fff0c9;
            color: #9b5a00;
        }

        .te-condition.out-of-order {
            background: #f8d5d5;
            color: #a71920;
        }

    .te-footer {
        display: flex;
        align-items: center;
        min-height: 66px;
        padding: 14px 18px;
        background: transparent;
    }

    .te-pager {
        display: flex;
        gap: 8px;
        margin-left: auto;
    }

        .te-pager a {
            width: 46px;
            height: 36px;
            display: grid;
            place-items: center;
            border: 1px solid #0ec52d;
            border-radius: 6px;
            color: #fff0c9;
            text-decoration: none;
        }

            .te-pager a.disabled {
                pointer-events: none;
                opacity: .45;
            }

    @@media (max-width: 800px) {
        .trainer-equipment {
            width: calc(100vw - 38px);
        }

        .te-header {
            align-items: stretch;
            flex-direction: column;
        }

        .te-search input {
            width: 100%;
        }

        .te-stats {
            grid-template-columns: 1fr;
        }

        .te-card {
            overflow-x: auto;
        }

        .te-table {
            min-width: 720px;
        }
    }
</style>

<main class="trainer-equipment">
    @if (TempData["ErrorMessage"] is string error) { <div role="alert" style="color:#ffb4b4">@error</div> }
    @if (TempData["SuccessMessage"] is string success) { <div role="status" style="color:#b7ff1b">@success</div> }
    <header class="te-header">
        <h1 style="font-weight:700!important;margin-bottom: 0px !important;">Equipment Report</h1>
        <button class="te-report-button" type="button" onclick="document.getElementById('trainerEquipmentReport').showModal()">＋ Report equipment issue</button>
    </header>

    <section class="te-stats">
        <div class="te-stat">
            <span>TOTAL ASSETS</span>
            <strong style="">@Model.TotalAssets</strong>
        </div>
        <div class="te-stat good">
            <span>GOOD EQUIPMENT</span>
            <strong style="">@Model.GoodQuantity</strong>
        </div>
        <div class="te-stat maintenance">
            <span>IN MAINTENANCE</span>
            <strong style="">@Model.InMaintenance</strong>
        </div>
        <div class="te-stat out">
            <span>OUT OF ORDER</span>
            <strong style="">@Model.OutOfOrder</strong>
        </div>
    </section>

    <form class="te-search" method="get" asp-action="Equipment">
        <input name="searchTerm" value="@Model.SearchTerm" placeholder="Search equipment..." />
        <button type="submit" class="equipment-search-button">Search</button>
    </form>

    <section class="te-card">
        <h2 class="table-title-bar">Equipment List</h2>
        <table class="te-table">
            <thead>
                <tr>
                    <th>ASSET NAME</th>
                    <th>CATEGORY</th>
                    <th>REPORTED QUANTITY</th>
                    <th>AVAILABLE QUANTITY</th>
                    <th>CONDITION</th>
                    <th>EVIDENCE</th>
                    <th>LAST MAINTENANCE</th>
                    <th>ADDED DATE</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;text-align:center">No equipment found.</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    var conditionClass = item.Status.ToLowerInvariant().Replace(' ', '-');
                    <tr>
                        <td class="te-name" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            <strong style="">@item.EquipmentName</strong>
                            <small style="">ID: EQ-@item.EquipmentId.ToString("D4")</small>
                        </td>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.Category</td>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.Quantity</td>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@Model.AvailableByEquipment.GetValueOrDefault(item.EquipmentName)</td>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;"><span class="te-condition @conditionClass" style="background:transparent!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;">@item.Status</span></td>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            @if (!string.IsNullOrWhiteSpace(item.EvidencePhotoPath))
                            {
                                <a class="te-photo" href="@item.EvidencePhotoPath" target="_blank" rel="noopener">View photo</a>
                            }
                            else { <span style="">—</span> }
                        </td>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@(item.LastMaintenanceDate?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.AddedDate.ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>

        <footer class="te-footer">
            <span class="pagination-summary">Showing @Model.Items.Count of @Model.TotalCount assets</span>
            <nav class="te-pager">
                <a asp-action="Equipment"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page - 1)"
                   class="@(Model.Page <= 1 ? "disabled" : "")">Previous</a>
                <a asp-action="Equipment"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page + 1)"
                   class="@(Model.Page >= Model.TotalPages ? "disabled" : "")">Next</a>
            </nav>
        </footer>
    </section>
</main>
<style>
    body.trainer-shell .trainer-equipment .te-header {
        min-height: 0 !important;
        padding-bottom: 0 !important;
        margin-bottom: 24px !important;
        border-bottom: none !important;
        box-shadow: none !important;
    }
    body.trainer-shell .trainer-equipment .te-stats { margin-bottom: 16px !important; }
    body.trainer-shell .trainer-equipment .te-search { margin-bottom: 32px !important; }
    html body.trainer-shell .trainer-equipment .te-search input,
    html body.trainer-shell .trainer-equipment .te-search button[type="submit"] {
        height: 56px !important;
        min-height: 56px !important;
        max-height: none !important;
        box-sizing: border-box !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }
    .te-report-button { background:#b7ff1b; color:#000; border:1px solid #b7ff1b; padding:14px 20px; cursor:pointer; }
    .te-report-button:hover { background:#1b201c; color:#b7ff1b; }
    #trainerEquipmentReport { width:min(540px,92vw); max-height:90vh; overflow:auto; background:#1b201c; color:#fff; border:1px solid #3c443d; padding:24px; }
    #trainerEquipmentReport::backdrop { background:rgba(0,0,0,.65); }
    #trainerEquipmentReport label { display:block; margin:16px 0 6px; }
    #trainerEquipmentReport input, #trainerEquipmentReport select { width:100%; padding:10px; background:#1b201c; color:#fff; border:1px solid #697169; }
    #trainerEquipmentReport .te-report-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:22px; }
    #trainerEquipmentReport .te-report-cancel { background:#292d2a; color:#fff; border:1px solid #586058; padding:10px 18px; cursor:pointer; }
    #trainerEquipmentReport .te-report-cancel:hover { border-color:#b7ff1b; color:#b7ff1b; }
</style>
<dialog id="trainerEquipmentReport" aria-labelledby="trainerReportTitle">
    <h2 id="trainerReportTitle" class="form-dialog-title">Report equipment issue</h2>
    <form asp-controller="Trainer" asp-action="AddEquipment" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label for="trainerReportName">Equipment name</label>
        <select id="trainerReportName" name="EquipmentName" required>
            <option value="">Select equipment</option>
            @foreach (var item in Model.EquipmentNames) { <option value="@item.Name">@item.Name</option> }
        </select>
        <label for="trainerReportQuantity">Quantity affected</label>
        <input id="trainerReportQuantity" name="Quantity" type="number" min="1" max="10000" value="1" required />
        <label for="trainerReportCondition">Condition</label>
        <select id="trainerReportCondition" name="Condition" required>
            <option value="Needs Maintenance">Needs Maintenance</option>
            <option value="Out of Order">Out of Order</option>
        </select>
        <label for="trainerReportPhoto">Evidence photo</label>
        <input id="trainerReportPhoto" name="EvidencePhoto" type="file" accept="image/jpeg,image/png,image/webp" required />
        <small>JPG, PNG, or WebP; maximum 5 MB.</small>
        @if (Model.EquipmentNames.Count == 0) { <p>No equipment has been added by the administrator yet.</p> }
        <div class="te-report-actions">
            <button class="te-report-cancel" type="button" onclick="document.getElementById('trainerEquipmentReport').close()">Cancel</button>
            <button class="te-report-button" type="submit" disabled="@(Model.EquipmentNames.Count == 0)">Submit report</button>
        </div>
    </form>
</dialog>


