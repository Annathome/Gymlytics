@model Gym.Models.AttendanceMonitoringViewModel

@{
    Layout = "~/Views/Shared/_FrontDeskLayout.cshtml";
    ViewData["Title"] = "Attendance Monitoring";
}

<style>
    body > .container {
        max-width: none;
        margin: 0;
        padding: 0 28px;
    }

    .am-page {
        width: min(1160px, calc(100vw - 360px));
        margin: 24px auto;
        font-family:Arial, sans-serif;
        color: #102630;
    }

    .am-title {
        margin: 0 0 22px;
        
        color: rgb(8, 75, 2);
    }

    .atten-searchbar
    {
        margin-top: 40px;
        margin-bottom: 20px;
    }

    /* Keep the title-to-search spacing at exactly 5px. This page-local rule
       is intentionally last in the view so shared theme rules cannot replace it. */
    main.am-page > header.role-page-header {
        min-height: 0 !important;
        height: auto !important;
        margin: 0 0 5px !important;
        padding: 0 !important;
        border: 0 !important;
    }
    main.am-page > .atten-searchbar {
        margin-top: 0 !important;
    }

    .am-search {
        display: flex;
        gap: 14px;
        padding: 16px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 5px 16px rgba(24, 50, 61, 0.09);
        margin-bottom: 22px;
    }

        .am-search input {
            flex: 1;
            height: 42px;
            border: 1px solid #c8d4cd;
            border-radius: 5px;
            padding: 0 14px;
            
        }

        .am-search button {
            width: 100px;
            border: 0;
            border-radius: 5px;
            background: rgb(8, 61, 2);
            color: #fff;
            
            font-weight: 700;
        }

    .am-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 5px 16px rgba(24, 50, 61, 0.09);
        overflow: visible;
    }

    .am-card-head h2 {
        color: #ffffff !important;
        
        font-weight: 700;
    }

    .am-table {
        width: 100%;
        border-collapse: collapse;
    }

        .am-table th {
            padding: 13px 16px;
            background: #394c55;
            color: #fff;
            text-align: left;
            
            letter-spacing: 0.5px;
        }

            .am-table th.action-heading {
                text-align: center;
                width: 74px;
            }

        .am-table td {
            padding: 8px 16px;
            border-bottom: 1px solid #e6ebe8;
            height: 56px;
            vertical-align: middle;
        }

    .member {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #e7f0e9;
        color: #176328;
        
        font-weight: 700;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 999px;
        
        font-weight: 700;
        text-transform: uppercase;
    }

    .badge-active {
        background: #27372b;
        color: #b7ff1b;
    }

    .badge-none {
        background: #303831;
        color: #d7ddd8;
    }

    .action-cell {
        position: relative;
        text-align: center;
    }

        .action-cell form {
            margin: 0;
        }

        .action-cell button {
            min-width: 74px;
            padding: 5px 8px;
            border: 0;
            border-radius: 5px;
            background: rgb(8, 75, 2);
            color: #fff;
            font-weight: 700;
            cursor: pointer;
        }

            .action-cell button:disabled {
                background: #dfe5e1;
                color: #718078;
                cursor: not-allowed;
            }

    .am-footer {
        display: flex;
        align-items: center;
        min-height: 76px;
        padding: 16px 20px;
        background: #e8f6fc;
        color: #111;
        
    }

    .pager {
        margin-left: auto;
        display: flex;
        gap: 10px;
    }

        .pager a {
            width: 55px;
            height: 43px;
            display: grid;
            place-items: center;
            border: 1px solid #d5e1e5;
            border-radius: 6px;
            background: #f7fbfc;
            color: #879397;
            text-decoration: none;
            
            font-weight: 400;
        }

            .pager a.disabled {
                pointer-events: none;
                opacity: 0.5;
            }

    .notice {
        padding: 11px 14px;
        border-radius: 6px;
        margin-bottom: 14px;
    }

    .success {
        background: #eaf8ec;
        color: #176328;
        border: 1px solid #a8d8af;
    }

    .error {
        background: #fff0f0;
        color: #a02020;
        border: 1px solid #e9b1b1;
    }

    @@media (max-width: 760px) {
        .am-page {
            width: calc(100vw - 40px);
        }

        .am-card {
            overflow-x: auto;
        }

        .am-table {
            min-width: 850px;
        }

        .am-search {
            flex-direction: column;
        }

            .am-search button {
                width: 100%;
                height: 42px;
            }
    }

    /* Final attendance spacing override. */
    main.am-page > header.role-page-header {
        min-height: 0 !important;
        height: auto !important;
        padding: 0 !important;
        border: 0 !important;
    }
    main.am-page > .atten-searchbar { margin-top: 0 !important; }
</style>

<main class="am-page">

    <div class="attendance-page title">
        <header class="role-page-header">
            <h1 class="am-title" style="font-weight:700!important;color:#fff !important;">Attendance Monitoring</h1>
        </header>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="notice success">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="notice error">@error</div>
    }

    <div class="atten-searchbar">
        <form class="am-search" method="get" asp-action="AttendanceMonitoring">
            <input name="searchTerm" value="@Model.SearchTerm" placeholder="Search members, IDs, membership, or check-in status..." />
            <button type="submit" class="attendance-search-button">Search</button>
        </form>
    </div>

    <section class="am-card">

       

        <div class="am-card-head">
            <h2>Daily Check-in Log</h2>
        </div>

        <table class="am-table">

            <thead>
                <tr>
                    <th>MEMBER NAME</th>
                    <th>DATE</th>
                    <th>CHECK-IN</th>
                    <th>MEMBERSHIP</th>
                    <th>STATUS</th>
                    <th class="action-heading" aria-label="Actions"></th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Members.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;text-align:center;color:#738078">No members found.</td>
                    </tr>
                }

                @foreach (var member in Model.Members)
                {
                    var badgeClass = member.Status == "Checked in" ? "badge-active" : "badge-none";

                    <tr>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            <div class="member" style="">
                                <span class="avatar" style="">@member.Initials</span>
                                <span style="">@member.FullName</span>
                            </div>
                        </td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@(member.CheckInAt?.ToString("MMM d, yyyy") ?? "-")</td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@(member.CheckInAt?.ToString("hh:mm tt") ?? "-")</td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@member.Membership</td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            <span class="badge @badgeClass" style="background:transparent!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;">@member.Status</span>
                        </td>

                        <td class="action-cell" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            <form asp-action="UpdateAttendance" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@member.ClientId"  style=""/>
                                <input type="hidden" name="attendanceAction" value="checkin"  style=""/>
                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm"  style=""/>
                                <input type="hidden" name="page" value="@Model.Page"  style=""/>
                                @if (member.CanCheckIn)
                                {
                                    <button type="submit" class="@(member.ReminderEmailFailed ? "email-failed-checkin" : "")" style="">Check In</button>
                                }
                                else
                                {
                                    <button type="button" class="@(member.ReminderEmailFailed ? "email-failed-checkin" : "")" disabled style="">@(member.CheckInAt.HasValue ? "Checked In" : "Unavailable")</button>
                                }
                            </form>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <footer class="am-footer">

            <span class="pagination-summary">
                Showing @Model.Members.Count of @Model.TotalCount
                (page @Model.Page of @Model.TotalPages)
            </span>

            <nav class="pager">
                <a asp-action="AttendanceMonitoring"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page - 1)"
                   class="@(Model.Page <= 1 ? "disabled" : "")">
                    Previous
                </a>

                <a asp-action="AttendanceMonitoring"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page + 1)"
                   class="@(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    Next
                </a>
            </nav>

        </footer>

    </section>

</main>
