@model Gym.Models.AttendanceMonitoringViewModel

@{
    Layout = "~/Views/Shared/_FrontDeskLayout.cshtml";
    ViewData["Title"] = "Attendance Monitoring";
}

<style>
    body > .container {
        max-width: none;
        margin: 0;
        padding: 0 28px;
    }

    .am-page {
        width: min(1160px, calc(100vw - 360px));
        margin: 24px auto;
        font: 15px Arial, sans-serif;
        color: #102630;
    }

    .am-title {
        margin: 0 0 22px;
        font-size: 23px;
        color: rgb(8, 75, 2);
    }

    .atten-searchbar
    {
        margin-top: 40px;
        margin-bottom: 20px;
    }

    .am-search {
        display: flex;
        gap: 14px;
        padding: 16px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 5px 16px rgba(24, 50, 61, 0.09);
        margin-bottom: 22px;
    }

        .am-search input {
            flex: 1;
            height: 42px;
            border: 1px solid #c8d4cd;
            border-radius: 5px;
            padding: 0 14px;
            font-size: 15px;
        }

        .am-search button {
            width: 100px;
            border: 0;
            border-radius: 5px;
            background: rgb(8, 61, 2);
            color: #fff;
            font-size: 15px;
            font-weight: 700;
        }

    .am-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 5px 16px rgba(24, 50, 61, 0.09);
        overflow: visible;
    }

    .am-card-head h2 {
        color: #ffffff !important;
        font-size: 15px;
        font-weight: 700;
    }

    .am-table {
        width: 100%;
        border-collapse: collapse;
    }

        .am-table th {
            padding: 13px 16px;
            background: #394c55;
            color: #fff;
            text-align: left;
            font-size: 12px;
            letter-spacing: 0.5px;
        }

            .am-table th.action-heading {
                text-align: center;
                width: 74px;
            }

        .am-table td {
            padding: 12px 16px;
            border-bottom: 1px solid #e6ebe8;
            height: 72px;
        }

    .member {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #e7f0e9;
        color: #176328;
        font-size: 12px;
        font-weight: 700;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .badge-active {
        background: #c9f4c9;
        color: #176328;
    }

    .badge-checked {
        background: #d9edf5;
        color: #355963;
    }

    .badge-none {
        background: #ecefed;
        color: #647069;
    }

    .action-cell {
        position: relative;
        text-align: center;
    }

        .action-cell form {
            margin: 0;
        }

        .action-cell button {
            min-width: 92px;
            padding: 9px 12px;
            border: 0;
            border-radius: 5px;
            background: rgb(8, 75, 2);
            color: #fff;
            font-weight: 700;
            cursor: pointer;
        }

            .action-cell button:disabled {
                background: #dfe5e1;
                color: #718078;
                cursor: not-allowed;
            }

    .action-menu {
        position: relative;
        display: inline-block;
    }

        .action-menu summary {
            list-style: none;
            cursor: pointer;
            width: 32px;
            height: 34px;
            display: grid;
            place-items: center;
            border: 0;
            background: transparent;
            color: #37433c;
            border-radius: 6px;
            font-size: 24px;
            font-weight: 800;
            line-height: 1;
        }

            .action-menu summary:hover {
                background: #eef3f0;
            }

            .action-menu summary::-webkit-details-marker {
                display: none;
            }

    .action-pop {
        position: absolute;
        right: 0;
        top: 36px;
        width: 140px;
        background: #fff;
        border: 1px solid #d8e0db;
        border-radius: 6px;
        box-shadow: 0 7px 20px rgba(0, 0, 0, 0.14);
        z-index: 30;
        overflow: hidden;
    }

        .action-pop form {
            margin: 0;
        }

        .action-pop button {
            width: 100%;
            border: 0;
            background: #fff;
            text-align: left;
            padding: 11px 14px;
            font-size: 13px;
            cursor: pointer;
        }

            .action-pop button:hover {
                background: #edf6ef;
            }

            .action-pop button:disabled {
                color: #aab2ad;
                cursor: not-allowed;
            }

    .am-footer {
        display: flex;
        align-items: center;
        min-height: 76px;
        padding: 16px 20px;
        background: #e8f6fc;
        color: #111;
        font-size: 15px;
    }

    .pager {
        margin-left: auto;
        display: flex;
        gap: 10px;
    }

        .pager a {
            width: 55px;
            height: 43px;
            display: grid;
            place-items: center;
            border: 1px solid #d5e1e5;
            border-radius: 6px;
            background: #f7fbfc;
            color: #879397;
            text-decoration: none;
            font-size: 13px;
            font-weight: 400;
        }

            .pager a.disabled {
                pointer-events: none;
                opacity: 0.5;
            }

    .notice {
        padding: 11px 14px;
        border-radius: 6px;
        margin-bottom: 14px;
    }

    .success {
        background: #eaf8ec;
        color: #176328;
        border: 1px solid #a8d8af;
    }

    .error {
        background: #fff0f0;
        color: #a02020;
        border: 1px solid #e9b1b1;
    }

    @@media (max-width: 760px) {
        .am-page {
            width: calc(100vw - 40px);
        }

        .am-card {
            overflow-x: auto;
        }

        .am-table {
            min-width: 850px;
        }

        .am-search {
            flex-direction: column;
        }

            .am-search button {
                width: 100%;
                height: 42px;
            }
    }
</style>

<main class="am-page">

    <header class="role-page-header">
        <h1 class="am-title" style="color:#fff !important;">Attendance Monitoring</h1>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="notice success">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="notice error">@error</div>
    }

    <div class="atten-searchbar">
        <form class="am-search" method="get" asp-action="AttendanceMonitoring">
            <input name="searchTerm" value="@Model.SearchTerm" placeholder="Search members, IDs, membership, or check-in status..." />
            <button type="submit" class="attendance-search-button">Search</button>
        </form>
    </div>

    <section class="am-card">

       

        <div class="am-card-head">
            <h2>Daily Check-in Log</h2>
        </div>

        <table class="am-table">

            <thead>
                <tr>
                    <th>MEMBER NAME</th>
                    <th>DATE</th>
                    <th>CHECK-IN</th>
                    <th>MEMBERSHIP</th>
                    <th>STATUS</th>
                    <th class="action-heading">ACTION</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Members.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="text-align:center;color:#738078">No members found.</td>
                    </tr>
                }

                @foreach (var member in Model.Members)
                {
                    var badgeClass = member.Status == "Checked in" ? "badge-active" : "badge-none";

                    <tr>
                        <td>
                            <div class="member">
                                <span class="avatar">@member.Initials</span>
                                <span>@member.FullName</span>
                            </div>
                        </td>

                        <td>@(member.CheckInAt?.ToString("MMM d, yyyy") ?? "-")</td>

                        <td>@(member.CheckInAt?.ToString("hh:mm tt") ?? "-")</td>

                        <td>@member.Membership</td>

                        <td>
                            <span class="badge @badgeClass">@member.Status</span>
                        </td>

                        <td class="action-cell">
                            <form asp-action="UpdateAttendance" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@member.ClientId" />
                                <input type="hidden" name="attendanceAction" value="checkin" />
                                @if (member.CanCheckIn)
                                {
                                    <button type="submit">Check In</button>
                                }
                                else
                                {
                                    <button type="button" disabled>Checked In</button>
                                }
                            </form>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <footer class="am-footer">

            <span>
                Showing @Model.Members.Count of @Model.TotalCount
                (page @Model.Page of @Model.TotalPages)
            </span>

            <nav class="pager">
                <a asp-action="AttendanceMonitoring"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page - 1)"
                   class="@(Model.Page <= 1 ? "disabled" : "")">
                    Previous
                </a>

                <a asp-action="AttendanceMonitoring"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page + 1)"
                   class="@(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    Next
                </a>
            </nav>

        </footer>

    </section>

</main>
