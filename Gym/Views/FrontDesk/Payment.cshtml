@model Gym.Models.FrontDeskPaymentViewModel

@{
    Layout = "~/Views/Shared/_FrontDeskLayout.cshtml";
    ViewData["Title"] = "Payments";
}

<style>
    body > .container {
        max-width: none;
        margin: 0;
        padding: 0 28px;
    }

    .pay-page {
        width: min(1160px, calc(100vw - 370px));
        margin: 24px auto;
        font: 15px Arial, sans-serif;
        color: #102630;
    }

    /* Header */
    .pay-head h1 {
        margin: 0 0 5px;
        font-size: 26px;
    }

    .pay-head p {
        margin: 0 0 30px;
        color: #5e6963;
    }

    .pay-action
    {
        display:flex;
        justify-content: space-between;
        flex-direction: row;
        position:relative;
    }

    /* Renewal Card */
    .renew-card {
        width: 300px;
        margin: 28px 0 20px;
        padding: 18px;
        background: #fff;
        border: 1px solid #dce5e1;
        border-radius: 8px;
        box-shadow: 0 5px 14px rgba(24, 50, 61, 0.08);
    }

    .renew-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .renew-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 5px;
        background: #e9f4eb;
        color: #18712c;
        font-size: 23px;
    }

    .renew-period {
        padding: 6px 10px;
        border-radius: 999px;
        background: #dff1f8;
        color: #48636c;
        font-size: 12px;
    }

    .renew-label {
        margin: 16px 0 5px;
        color: #526058;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .renew-bottom {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }

    .renew-count {
        font-size: 34px;
        font-weight: 700;
    }

    .renew-link {
        color: #07551a;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

    /* Payments Card */
    .pay-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #dce5e1;
        border-radius: 8px;
    }

        .pay-card h2{
            font-size: 15px;

        }
    /* Toolbar */
    .pay-toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 15px 18px;
        background: #f5fbfe;
    }

        .pay-toolbar h2 {
            margin: 0 auto 0 0;
            font-size: 19px;
        }

    .pay-search {
        display: flex;
        gap: 9px;
    }

        .pay-search input {
            width: 270px;
            height: 39px;
            padding: 0 13px;
            border: 1px solid #c7d3cd;
            border-radius: 5px;
            font-size: 14px;
            box-sizing: border-box;
        }

        .pay-search button {
            width: 80px;
            border: 0;
            border-radius: 5px;
            background: #084b0b;
            color: #fff;
            font-weight: 700;
            cursor: pointer;
        }

    .pay-status {
        height: 39px;
        padding: 0 12px;
        border: 1px solid #c7d3cd;
        border-radius: 5px;
        background: #fff;
    }

    /* Table */
    .pay-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pay-table th {
            padding: 14px 16px;
            background: #394c55;
            color: #fff;
            text-align: left;
            font-size: 12px;
            letter-spacing: 0.6px;
        }

        .pay-table td {
            padding: 16px;
            border-top: 1px solid #e7ece9;
        }

    .pay-member {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .pay-avatar {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #e6f2e8;
        color: #126726;
        font-size: 12px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .pay-amount {
        font-weight: 700;
    }

    .pay-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

    .paid {
        background: #e2f7e4;
        color: #176b2c;
    }

    .pending {
        background: #e0eff5;
        color: #3d626e;
    }

    .overdue,
    .unpaid {
        background: #fde4e4;
        color: #aa2020;
    }

    .pay-method {
        white-space: nowrap;
    }

    .pay-empty {
        text-align: center;
        color: #748078;
    }

    .pay-row-action { position:relative; text-align:center; }
    .pay-row-action details { position:relative; display:inline-block; }
    .pay-row-action summary { list-style:none; width:34px; height:34px; display:grid; place-items:center; cursor:pointer; border:1px solid #ccd6d0; border-radius:5px; }
    .pay-row-action summary::-webkit-details-marker { display:none; }
    .pay-action-menu { position:absolute; right:0; top:39px; z-index:20; width:170px; padding:5px 0; background:#fff; border:1px solid #d8e0db; border-radius:6px; box-shadow:0 8px 22px rgba(0,0,0,.14); }
    .pay-action-menu button { width:100%; padding:11px 14px; border:0; background:#fff; text-align:left; cursor:pointer; }
    .pay-action-menu button:hover { background:#edf6ef; }
    .pay-action-menu button:disabled { color:#9ba59f; cursor:not-allowed; }
    .pay-modal { position:fixed; inset:0; z-index:2400; display:none; align-items:center; justify-content:center; padding:20px; background:rgba(0,0,0,.58); }
    .pay-modal-card { width:min(520px,94vw); padding:24px; border-radius:8px; background:#fff; box-shadow:0 20px 60px rgba(0,0,0,.25); }
    .pay-modal-card h3 { margin:0 0 8px; }
    .pay-modal-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px 16px; margin:16px 0; padding:14px; background:#f2f8f4; border:1px solid #dce8df; border-radius:7px; }
    .pay-modal-grid small { display:block; color:#6c7871; }
    .pay-modal-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:18px; }
    .pay-modal-actions button { min-height:40px; padding:0 16px; border-radius:5px; cursor:pointer; }
    .pay-modal-cancel { border:1px solid #ccd5d0; background:#fff; }
    .pay-modal-save { border:0; background:#084b0b; color:#fff; font-weight:700; }

    /* Footer / Pagination */
    .pay-foot {
        min-height: 76px;
        display: flex;
        align-items: center;
        padding: 16px 20px;
        background: #e8f6fc;
        color: #111;
        font-size: 15px;
    }

    .pay-pager {
        margin-left: auto;
        display: flex;
        gap: 10px;
    }

        .pay-pager a {
            width: 55px;
            height: 43px;
            display: grid;
            place-items: center;
            border: 1px solid #d5e1e5;
            border-radius: 6px;
            background: #f7fbfc;
            color: #879397;
            text-decoration: none;
            font-size: 13px;
        }

            .pay-pager a.disabled {
                pointer-events: none;
                opacity: 0.5;
            }

    /* Responsive */
    @@media (max-width: 800px) {
        .pay-page {
            width: calc(100vw - 40px);
        }

        .pay-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .pay-search {
            display: grid;
            grid-template-columns: 1fr 80px;
        }

            .pay-search input {
                width: 100%;
            }

        .pay-status {
            width: 100%;
        }

        .pay-card {
            overflow-x: auto;
        }

        .pay-table {
            min-width: 850px;
        }

        .renew-card {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<main class="pay-page">

    <header class="pay-head">
        <h1>Payments</h1>

        <p>
            Monitor member and walk-in payment transactions.
        </p>
    </header>
    <div class="pay-action">
            <form class="pay-search"
                        method="get"
                        asp-action="Payment">

                    <input name="searchTerm"
                            value="@Model.SearchTerm"
                            placeholder="Search transactions..." />

                    <input type="hidden"
                            name="selectedStatus"
                            value="@Model.SelectedStatus" />

                    <button type="submit" class="pay-search-button">
                        Search
                    </button>

            </form>

             <form method="get"
                  asp-action="Payment">

                <input type="hidden"
                       name="searchTerm"
                       value="@Model.SearchTerm" />

                <select class="pay-status"
                        name="selectedStatus"
                        onchange="this.form.submit()">

                    <option value="">
                        Status Filter: All
                    </option>

                    @foreach (var status in Enum.GetValues<Gym.Models.PaymentStatus>())
                    {
                        <option value="@status"
                                selected="@(Model.SelectedStatus == status)">
                            @status
                        </option>
                    }

                </select>

            </form>
    </div>

    <section class="pay-card">

            <h2>
                Recent Transactions
            </h2>

        <!-- Payment Table -->
        <table class="pay-table">

            <thead>
                <tr>
                    <th>TRANSACTION CODE</th>
                    <th>MEMBER NAME</th>
                    <th>DATE</th>
                    <th>AMOUNT</th>
                    <th>STATUS</th>
                    <th>ACTION</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Payments.Count == 0)
                {
                    <tr>
                        <td class="pay-empty" colspan="6">
                            No payment transactions found.
                        </td>
                    </tr>
                }

                @foreach (var item in Model.Payments)
                {
                    var statusClass = item.Status
                        .ToString()
                        .ToLowerInvariant();

                    <tr>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.TransactionCode)
                                ? $"TXN-{item.PaymentId:D6}"
                                : item.TransactionCode)
                        </td>

                        <td>
                            <div class="pay-member">

                                <span class="pay-avatar">
                                    @item.Initials
                                </span>

                                <strong>
                                    @item.MemberName
                                </strong>

                            </div>
                        </td>

                        <td>
                            @item.PaymentDate.ToString("MMM d, yyyy")
                        </td>

                        <td class="pay-amount">
                            ₱@item.Amount.ToString("N2")
                        </td>

                        <td>
                            <span class="pay-badge @statusClass">
                                @item.Status
                            </span>
                        </td>

                        <td class="pay-row-action">
                            <details>
                                <summary aria-label="Payment actions">⋮</summary>
                                <div class="pay-action-menu">
                                    @if (item.MemberStatus != MemberStatus.Terminated &&
                                         item.MembershipEndDate.HasValue &&
                                         item.MembershipEndDate.Value.Date < DateTime.Today)
                                    {
                                        <button type="button"
                                                data-client-id="@item.ClientId"
                                                data-member-name="@item.MemberName"
                                                data-plan-name="@MembershipPlanPricing.GetName(item.Plan)"
                                                data-plan-price="@item.PlanPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-expired-date="@item.MembershipEndDate.Value.ToString("MMM d, yyyy")"
                                                onclick="openRenewalAction(this)">Renew membership</button>
                                    }
                                    else
                                    {
                                        <button type="button" disabled>Renew membership</button>
                                    }
                                </div>
                            </details>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <!-- Pagination -->
        <footer class="pay-foot">

            <span>
                Showing @Model.Payments.Count of @Model.TotalCount
                (page @Model.Page of @Model.TotalPages)
            </span>

            <nav class="pay-pager">

                <a asp-action="Payment"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-selectedStatus="@Model.SelectedStatus"
                   asp-route-page="@(Model.Page - 1)"
                   class="@(Model.Page <= 1 ? "disabled" : "")">
                    Previous
                </a>

                <a asp-action="Payment"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-selectedStatus="@Model.SelectedStatus"
                   asp-route-page="@(Model.Page + 1)"
                   class="@(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    Next
                </a>

            </nav>

        </footer>

    </section>

</main>

<div id="renewalActionModal" class="pay-modal">
    <div class="pay-modal-card" role="dialog" aria-modal="true" aria-labelledby="renewalActionTitle">
        <h3 id="renewalActionTitle">Confirm membership renewal</h3>
        <p>The current membership has ended. Confirm the full cash payment to start the next membership period. A digital receipt will be emailed after renewal.</p>
        <div class="pay-modal-grid">
            <div><small>Member</small><strong id="renewalMemberName"></strong></div>
            <div><small>Plan</small><strong id="renewalPlanName"></strong></div>
            <div><small>Previous plan ended</small><strong id="renewalExpiredDate"></strong></div>
            <div><small>Renewal payment</small><strong id="renewalPlanPrice"></strong></div>
        </div>
        <form asp-action="RenewMembership" asp-controller="FrontDesk" method="post" onsubmit="return lockRenewalAction(this)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="renewalClientId" name="id" />
            <input type="hidden" id="renewalAmount" name="amount" />
            <div class="pay-modal-actions">
                <button type="button" class="pay-modal-cancel" onclick="closeRenewalAction()">Cancel</button>
                <button type="submit" class="pay-modal-save">Pay and renew</button>
            </div>
        </form>
    </div>
</div>

<script>
    function peso(value) {
        return '₱' + Number(value).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function openRenewalAction(button) {
        document.getElementById('renewalClientId').value = button.dataset.clientId;
        document.getElementById('renewalAmount').value = button.dataset.planPrice;
        document.getElementById('renewalMemberName').textContent = button.dataset.memberName;
        document.getElementById('renewalPlanName').textContent = button.dataset.planName;
        document.getElementById('renewalExpiredDate').textContent = button.dataset.expiredDate;
        document.getElementById('renewalPlanPrice').textContent = peso(button.dataset.planPrice);
        document.getElementById('renewalActionModal').style.display = 'flex';
    }
    function closeRenewalAction() {
        document.getElementById('renewalActionModal').style.display = 'none';
    }
    function lockRenewalAction(form) {
        const submit = form.querySelector('button[type="submit"]');
        submit.disabled = true;
        submit.textContent = 'Processing...';
        return true;
    }
</script>
