@model IReadOnlyList<Gym.Models.FrontDeskEmailNotification>

@{
    var isAdmin = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);
    Layout = isAdmin ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_FrontDeskLayout.cshtml";
    ViewData["Title"] = isAdmin ? "Admin Notifications" : "Email Notifications";
    var currentPageNumber = ViewBag.Page is int currentPage ? currentPage : 1;
    var totalPages = ViewBag.TotalPages is int pageCount ? pageCount : 1;
    var totalCount = ViewBag.TotalCount is int itemCount ? itemCount : Model.Count;
}

<style>
    .email-notifications {
        width: min(1180px, calc(100vw - 380px));
        margin: 24px auto;
        transform: translateX(10px);
        color: #102630;
        font: 15px Arial, Helvetica, sans-serif;
    }
    .email-notifications h1 { margin: 0 0 6px; font-size: 25px; }
    .email-notifications .subtitle { margin: 0 0 22px; color: #68756e; }
    .email-log { overflow: hidden; border: 1px solid #d8e3dd; border-radius: 9px; background: #fff; }
    .email-log-header, .email-log-row {
        display: grid;
        grid-template-columns: minmax(175px, .65fr) minmax(480px, 1.9fr) minmax(210px, .8fr);
        gap: 20px;
        align-items: center;
        padding: 16px 20px;
    }
    .email-log-header { background: #394f59; color: #fff; font-weight: 700; font-size: 13px; }
    .email-log-row { border-top: 1px solid #e5ebe7; }
    .email-status { width: fit-content; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .email-status.sent { background: #dcf5df; color: #08752a; }
    .email-status.failed { background: #fde2e2; color: #a71919; }
    .email-title { font-weight: 700; }
    .email-message { color: #536159; line-height: 1.45; overflow-wrap: anywhere; }
    .email-date { color: #68756e; font-size: 13px; }
    .email-empty { padding: 54px 20px; color: #68756e; text-align: center; }
    .email-pagination { display:flex; align-items:center; justify-content:space-between; min-height:80px; padding:14px 20px; border-top:1px solid #313632; }
    .email-pagination nav { display:flex; gap:12px; }
    .email-pagination a { min-width:102px; height:50px; display:inline-flex; align-items:center; justify-content:center; border:1px solid #59635c; border-radius:5px; color:#fff; text-decoration:none; font-size:10px; font-weight:700; text-transform:uppercase; }
    .email-pagination a.disabled { opacity:.4; pointer-events:none; }
    @@media (max-width: 900px) {
        .email-notifications { width: calc(100vw - 48px); transform: none; }
        .email-log { overflow-x: auto; }
        .email-log-header, .email-log-row { min-width: 900px; }
    }
</style>

<main class="email-notifications">
    <header class="role-page-header">
        <div>
            <h1 style="color:#fff !important;">@(isAdmin ? "Admin Notifications" : "Email Notifications")</h1>
            <p class="subtitle">@(isAdmin ? "Security, reminders, trainer availability, and membership activity." : "Delivery activity for emails sent by the Front Desk.")</p>
        </div>
    </header>

    <section class="email-log">
        <div class="email-log-header"><span>EMAIL TYPE</span><span>RECIPIENT / DETAILS</span><span>DATE &amp; TIME</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="email-empty">No member or walk-in email activity has been recorded yet.</div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var sent = item.Status.Equals("Sent", StringComparison.OrdinalIgnoreCase);
                <article class="email-log-row">
                    <span class="email-title">@item.EmailType</span>
                    <span class="email-message">@item.Message</span>
                    <time class="email-date">@item.CreatedDate.ToString("MMM d, yyyy · h:mm tt")</time>
                </article>
            }
        }
        <footer class="email-pagination">
            <span>Showing @Model.Count of @totalCount (page @currentPageNumber of @totalPages)</span>
            <nav aria-label="Email notification pages">
                <a asp-action="Notifications" asp-route-page="@(currentPageNumber - 1)" class="@(currentPageNumber <= 1 ? "disabled" : "")">Previous</a>
                <a asp-action="Notifications" asp-route-page="@(currentPageNumber + 1)" class="@(currentPageNumber >= totalPages ? "disabled" : "")">Next</a>
            </nav>
        </footer>
    </section>
</main>
