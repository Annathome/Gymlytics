@model Gym.Models.MembersPageViewModel

@{
    ViewData["Title"] = "Register Member";
    Layout = null;

    var addMember = Model.AddMemberViewModel;
    var hasMembershipPlans = addMember.PlanOptions.Any();
    var planPrices = MembershipPlanPricing.GetActivePlans()
        .ToDictionary(item => ((int)item.Plan).ToString(), item => item.Price);
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inria+Serif:wght@300;400;700&display=swap');

    * {
        font-family: "Inria Serif", serif;
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
        background: #242824;
        color: #fff;
    }

    body {
        padding: 28px;
    }

    .add-member-container {
        width: 100%;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Inria Serif", serif;
        color: #fff;
        background: #242824;
    }


    .add-member-header {
        margin-bottom: 20px;
    }

        .add-member-header h1 {
            font-size: 30px; 
            font-weight: 700;
            margin: 0;
        }

    .add-member-subtitle {
        font-size: 15px; 
        color: #fff;
        margin-top: 4px;
    }

    .member-form {
        width: 100%;
    }

    .form-section {
        border: 1px solid #000;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 16px;
        background: #5e5d63;
    }

    .section-title {
        font-size: 15px;
        color: #fff;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
        text-transform: uppercase;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }

        .form-row:last-child {
            margin-bottom: 0;
        }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

    .form-label {
        font-size: 12px; /* Larger labels */
        font-weight: 600;
        color: #fff;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        width: 100%;
        height: 38px; /* Taller input for better click target */
        padding: 6px 12px;
        border: 1px solid #fff;
        border-radius: 6px;
        background-color: #252a26;
        color: #fff;
        font-size: 13px; /* Larger text inside inputs */
        box-sizing: border-box;
        outline: none;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #b9ff20;
        }

    .form-control::placeholder {
        color: #fff;
        opacity: .72;
    }

    .form-control {
        background-color: transparent;
    }

    .form-select option {
        background: #000;
        color: #fff;
    }

    .form-select option:hover,
    .form-select option:checked {
        color: #b7ff1b;
        background: #000;
    }

    .form-select {
        background-color: transparent;
    }

    input[type="date"] {
        color-scheme: light;
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
        filter: brightness(0);
        opacity: 1;
        cursor: pointer;
    }

    .required-mark {
        color: #fff;
        font-weight: 800;
    }

    textarea.form-control {
        height: 70px; /* Taller text area */
        resize: vertical;
    }

    .training-days {
        display: flex;
        gap: 8px;
        width: 100%;
    }

    .day-button {
        flex: 1;
        height: 36px; /* Taller day buttons */
        border: 1px solid #59635c;
        border-radius: 6px;
        background: transparent;
        color: #fff;
        font-size: 12px; /* Larger text for days */
        font-weight: 500;
        cursor: pointer;
    }

    .day-button.selected {
            background-color: #184d2b;
            border-color: #6ff59a;
            color: #6ff59a;
            font-weight: 600;
        }

    .day-button:disabled {
        cursor: not-allowed;
        opacity: 1;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 12px;
    }

    .btn-cancel {
        height: 38px;
        min-width: 130px;
        padding: 0 24px;
        border: 1px solid #9ba49d;
        border-radius: 0;
        background: transparent;
        color: #fff;
        font-size: 13px; /* Larger action text */
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
    }

    .btn-register {
        height: 38px;
        min-width: 210px;
        padding: 0 28px;
        border: 1px solid #a8df32;
        border-radius: 0;
        background: #a8df32;
        color: #293029;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 800;
        text-transform: uppercase;
    }

        .btn-register:hover {
            border-color: #171a18;
            background-color: #171a18;
            color: #b7ff1b;
        }

    .btn-cancel:hover {
        background-color: rgba(255, 255, 255, .08);
        color: #b7ff1b;
    }

    .validation-message {
        color: #ffb4b4;
        font-size: 11px; /* Larger validation text */
        margin-top: 4px;
    }

    .validation-summary {
        color: #ffb4b4;
        font-size: 12px;
        margin-bottom: 12px;
    }

    @@media (max-width: 700px) {
        body {
            padding: 20px 16px;
        }

        .add-member-container {
            width: 100%;
            padding: 0;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }

        .training-days {
            flex-wrap: wrap;
        }

        .day-button {
            flex: 0 0 calc(25% - 6px);
        }
    }
</style>

@if (ViewBag.ReturnToAdmin == true)
{
    <style>
        html, body, .add-member-container {
            background: #1b201c;
        }

        .member-form input:-webkit-autofill,
        .member-form input:-webkit-autofill:hover,
        .member-form input:-webkit-autofill:focus,
        .member-form input:-webkit-autofill:active {
            -webkit-text-fill-color: #fff;
            caret-color: #fff;
            -webkit-box-shadow: 0 0 0 1000px #1b201c inset;
            box-shadow: 0 0 0 1000px #1b201c inset;
        }

        .form-section {
            background: transparent;
            border: 1px solid #3c443d;
            border-radius: 0;
        }

        .form-control, .form-select {
            background: transparent;
            border-color: #c5cbc6;
            border-radius: 0;
            min-height: 42px;
        }

        .form-control:focus, .form-select:focus {
            border-color: #b7ff1b;
            outline: 2px solid #35552c;
            outline-offset: 2px;
        }

        input[type="date"] {
            color-scheme: dark;
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: none;
        }

        .btn-cancel, .btn-register, .day-button {
            border: 1px solid #b7ff1b;
            border-radius: 0;
            background: transparent;
            color: #b7ff1b;
            cursor: pointer;
            transition: background-color .15s ease, color .15s ease, border-color .15s ease;
        }

        .btn-cancel, .btn-register {
            min-height: 42px;
            justify-content: center;
        }

        .btn-register, .day-button.selected {
            background: #b7ff1b;
            color: #000;
        }

        .btn-register:hover {
            background: #171a18;
            border-color: #b7ff1b;
            color: #b7ff1b;
        }

        .btn-cancel {
            background: #292d2a;
            border-color: #586058;
            color: #fff;
        }

        .btn-cancel:hover, .btn-cancel:focus-visible {
            background: #292d2a;
            border-color: #b7ff1b;
            color: #b7ff1b;
        }

        .day-button:not(:disabled):hover {
            background: #b7ff1b;
            color: #000;
        }

        .btn-cancel:focus-visible, .btn-register:focus-visible, .day-button:focus-visible {
            outline: 2px solid #b7ff1b;
            outline-offset: 3px;
        }

        .day-button:disabled {
            border-color: #59635c;
            color: #9ba49d;
            cursor: not-allowed;
        }

        @@media (max-width: 700px) {
            .form-actions {
                flex-wrap: wrap;
            }

            .btn-cancel, .btn-register {
                min-width: 0;
                flex: 1 1 auto;
            }
        }
    </style>
}

<div class="add-member-container ">

    <!-- HEADER -->
    <div class="add-member-header">
        <h1>Register member</h1>
        <div class="add-member-subtitle">
            Register a new member and assign their trainer and schedule
        </div>
    </div>

    <form asp-action="AddMember"
          asp-controller="FrontDesk"
          method="post"
          class="member-form">

        @Html.AntiForgeryToken()
        @if (ViewBag.ReturnToAdmin == true)
        {
            <input type="hidden" name="returnToAdmin" value="true" />
        }

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>

        <!-- ==========================================
             PERSONAL DETAILS
        =========================================== -->
        <div class="form-section">
            <div class="section-title">
                Personal details
            </div>

            <div class="form-row">
                <!-- FULL NAME -->
                <div class="form-group">
                    <label asp-for="AddMemberViewModel.FullName" class="form-label">
                        Full name <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="AddMemberViewModel.FullName"
                           class="form-control"
                           placeholder="Juan Dela Cruz" />
                    <span asp-validation-for="AddMemberViewModel.FullName" class="validation-message"></span>
                </div>

                <!-- DATE OF BIRTH -->
                <div class="form-group">
                    <label asp-for="AddMemberViewModel.DateOfBirth" class="form-label">
                        Date of birth <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="AddMemberViewModel.DateOfBirth"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="AddMemberViewModel.DateOfBirth" class="validation-message"></span>
                </div>
            </div>

            <div class="form-row">
                <!-- CONTACT -->
                <div class="form-group">
                    <label asp-for="AddMemberViewModel.ContactNumber" class="form-label">
                        Contact number <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="AddMemberViewModel.ContactNumber"
                           class="form-control"
                           placeholder="09XX XXX XXXX" />
                    <span asp-validation-for="AddMemberViewModel.ContactNumber" class="validation-message"></span>
                </div>

                <!-- EMAIL -->
                <div class="form-group">
                    <label asp-for="AddMemberViewModel.Email" class="form-label">
                        Email <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="AddMemberViewModel.Email"
                           type="email"
                           class="form-control"
                           placeholder="juan@email.com" />
                    <span asp-validation-for="AddMemberViewModel.Email" class="validation-message"></span>
                </div>
            </div>

            <div class="form-row">
                <!-- EMERGENCY CONTACT -->
                <div class="form-group full">
                    <label asp-for="AddMemberViewModel.EmergencyContact" class="form-label">
                        Emergency contact
                    </label>
                    <input asp-for="AddMemberViewModel.EmergencyContact"
                           class="form-control"
                           placeholder="Contact number" />
                </div>
            </div>
        </div>

        <!-- ==========================================
             MEMBERSHIP PLAN
        =========================================== -->
        <div class="form-section">
            <div class="section-title">
                Membership plan
            </div>

            <div class="form-row">
                <!-- PLAN -->
                <div class="form-group">
                    <label asp-for="AddMemberViewModel.SelectedPlanId" class="form-label">
                        Plan type <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <select asp-for="AddMemberViewModel.SelectedPlanId"
                            asp-items="addMember.PlanOptions"
                            class="form-select">
                        <option value="">Select plan</option>
                    </select>
                    <span asp-validation-for="AddMemberViewModel.SelectedPlanId" class="validation-message"></span>
                </div>

                <!-- START DATE -->
                <div class="form-group">
                    <label asp-for="AddMemberViewModel.StartDate" class="form-label">
                        Start date <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="AddMemberViewModel.StartDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="AddMemberViewModel.StartDate" class="validation-message"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group full">
                    <label asp-for="AddMemberViewModel.PaymentAmount" class="form-label">Amount paid <span class="required-mark" aria-hidden="true">*</span></label>
                    <input asp-for="AddMemberViewModel.PaymentAmount" type="number" min="0.01" step="0.01"
                           class="form-control" placeholder="Select a membership plan first" disabled />
                    <span asp-validation-for="AddMemberViewModel.PaymentAmount" class="validation-message"></span>
                    <div id="planPaymentSummary" style="margin-top:7px;color:#fff;">
                        Select a membership plan to see its price.
                    </div>
                </div>
            </div>
        </div>

        <!-- ==========================================
             TRAINER ASSIGNMENT
        =========================================== -->
        <div class="form-section">
            <div class="section-title">
                Trainer assignment
            </div>

            <!-- TRAINER AND GYM GOAL -->
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="AddMemberViewModel.SelectedTrainerId" class="form-label">
                        Assign trainer
                    </label>
                    <select asp-for="AddMemberViewModel.SelectedTrainerId"
                            asp-items="addMember.TrainerOptions"
                            class="form-select">
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="AddMemberViewModel.SelectedGymGoal" class="form-label">
                        Gym goal <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <select asp-for="AddMemberViewModel.SelectedGymGoal"
                            asp-items="addMember.GymGoalOptions"
                            class="form-select">
                        <option value="">Select gym goal</option>
                    </select>
                    <span asp-validation-for="AddMemberViewModel.SelectedGymGoal" class="validation-message"></span>
                </div>
            </div>

            <!-- TRAINING DAYS -->
            <div class="form-row">
                <div class="form-group full">
                    <label class="form-label">Training days</label>
                    <div class="training-days">
                        <button type="button" class="day-button" data-day="Monday">Mon</button>
                        <button type="button" class="day-button" data-day="Tuesday">Tue</button>
                        <button type="button" class="day-button" data-day="Wednesday">Wed</button>
                        <button type="button" class="day-button" data-day="Thursday">Thu</button>
                        <button type="button" class="day-button" data-day="Friday">Fri</button>
                        <button type="button" class="day-button" data-day="Saturday">Sat</button>
                        <button type="button" class="day-button" data-day="Sunday">Sun</button>
                    </div>
                    <div id="selectedDaysContainer"></div>
                </div>
            </div>

            <!-- TIME SLOT -->
            <div class="form-row">
                <div class="form-group full">
                    <label asp-for="AddMemberViewModel.SelectedTimeSlot" class="form-label">
                        Preferred time slot <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <select asp-for="AddMemberViewModel.SelectedTimeSlot"
                            asp-items="addMember.TimeSlotOptions"
                            class="form-select" required>
                        <option value="">Select time slot</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- ==========================================
             BUTTONS
        =========================================== -->
        <div class="form-actions">
            <button type="button" class="btn-cancel" onclick="cancelRegistration()">
                Cancel
            </button>

            <!--
                FIXED: removed asp-action="Member" / asp-controller="FrontDesk"
                from this button. Those attributes generate a `formaction`
                that overrides the <form>'s own action="AddMember", so the
                POST was being sent to Member (a [HttpGet]-only action) and
                getting rejected with 405 — the form never actually saved.
                Now it just submits normally to AddMember (POST), which on
                success calls RedirectToAction(nameof(Member)), landing you
                back on the list with the new member in the table.
            -->
            @if (!hasMembershipPlans)
            {
                <p role="alert">Member registration is unavailable. An administrator must add a membership plan first.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/Payments?managePlans=true" target="_top" class="btn-cancel">Add membership plan</a>
                }
            }
            <button type="submit" class="btn-register" disabled="@(!hasMembershipPlans)">
                <span>✓</span>
                Register member
            </button>
        </div>

    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dayButtons = document.querySelectorAll(".day-button");
        const selectedDaysContainer = document.getElementById("selectedDaysContainer");
        const trainerSelect = document.getElementById("AddMemberViewModel_SelectedTrainerId");
        const planSelect = document.getElementById("AddMemberViewModel_SelectedPlanId");
        const paymentInput = document.getElementById("AddMemberViewModel_PaymentAmount");
        const paymentSummary = document.getElementById("planPaymentSummary");
        const planPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(planPrices));
        const trainerAvailableDays = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(addMember.TrainerAvailableDays)
        );

        const existingDays = @Html.Raw(
                                                                                                System.Text.Json.JsonSerializer.Serialize(addMember.SelectedDays)
                                                                );

        function updateSelectedDays() {
            selectedDaysContainer.innerHTML = "";
            dayButtons.forEach(function (button) {
                const day = button.dataset.day;
                if (button.classList.contains("selected")) {
                    const input = document.createElement("input");
                    input.type = "hidden";
                    input.name = "AddMemberViewModel.SelectedDays";
                    input.value = day;
                    selectedDaysContainer.appendChild(input);
                }
            });
        }

        dayButtons.forEach(function (button) {
            if (existingDays.includes(button.dataset.day)) {
                button.classList.add("selected");
            }
        });

        updateSelectedDays();

        dayButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                if (button.disabled) return;
                button.classList.toggle("selected");
                updateSelectedDays();
            });
        });

        function applyTrainerAvailability(clearWhenSelfGuided) {
            const trainerId = trainerSelect.value;
            const availableDays = trainerAvailableDays[trainerId];

            if (!trainerId || !availableDays) {
                dayButtons.forEach(function (button) {
                    button.disabled = false;
                    if (clearWhenSelfGuided) button.classList.remove("selected");
                });
                updateSelectedDays();
                return;
            }

            dayButtons.forEach(function (button) {
                button.classList.toggle("selected", availableDays.includes(button.dataset.day));
                button.disabled = !availableDays.includes(button.dataset.day);
            });
            updateSelectedDays();
        }

        trainerSelect.addEventListener("change", function () {
            applyTrainerAvailability(true);
            updateTrainerTimeSlots();
        });

        const timeSelect = document.getElementById('AddMemberViewModel_SelectedTimeSlot');
        const defaultTimeSlots = Array.from(timeSelect.options).filter(option => option.value)
            .map(option => ({ value: option.value, text: option.text }));
        const trainerTimeSlots = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(addMember.TrainerTimeSlots));
        function updateTrainerTimeSlots() {
            const previousValue = timeSelect.value;
            const slots = trainerSelect.value
                ? (trainerTimeSlots[trainerSelect.value] || []).map(value => ({ value, text: value.replace(' - ', ' – ') }))
                : defaultTimeSlots;
            timeSelect.replaceChildren(new Option(slots.length ? 'Select time slot' : 'No availability set for this trainer', ''));
            slots.forEach(slot => timeSelect.add(new Option(slot.text, slot.value)));
            timeSelect.value = slots.some(slot => slot.value === previousValue) ? previousValue : '';
        }
        updateTrainerTimeSlots();

        if (trainerSelect.value && (!existingDays || existingDays.length === 0)) {
            applyTrainerAvailability(false);
        } else if (trainerSelect.value) {
            const availableDays = trainerAvailableDays[trainerSelect.value] || [];
            dayButtons.forEach(function (button) {
                button.disabled = !availableDays.includes(button.dataset.day);
            });
        }

        function updatePlanPayment() {
            const price = planPrices[planSelect.value];
            if (price === undefined) {
                paymentSummary.textContent = "Select a membership plan to see its price.";
                paymentInput.placeholder = "Select a membership plan first";
                paymentInput.removeAttribute("min");
                paymentInput.removeAttribute("max");
                paymentInput.value = "";
                paymentInput.disabled = true;
                paymentInput.setCustomValidity("");
                return;
            }
            paymentInput.disabled = false;
            paymentInput.min = price;
            paymentInput.max = price;
            paymentInput.placeholder = `Required full payment: ₱${Number(price).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            paymentInput.value = Number(price).toFixed(2);
            paymentInput.setCustomValidity("");
            paymentSummary.textContent = `Required full payment: ₱${Number(price).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}.`;
        }

        function validatePlanPayment() {
            const price = Number(planPrices[planSelect.value]);
            const payment = Number(paymentInput.value);
            if (!Number.isFinite(price)) {
                paymentInput.setCustomValidity("Select a membership plan first.");
            } else if (!Number.isFinite(payment) || payment < price) {
                paymentInput.setCustomValidity(`Full payment of ₱${price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} is required.`);
            } else if (payment > price) {
                paymentInput.setCustomValidity(`Payment cannot exceed ₱${price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}.`);
            } else {
                paymentInput.setCustomValidity("");
            }
        }
        planSelect.addEventListener("change", updatePlanPayment);
        paymentInput.addEventListener("input", validatePlanPayment);
        updatePlanPayment();
    });

    function cancelRegistration() {
        if (window.parent !== window && typeof window.parent.closeAddMemberModal === "function") {
            window.parent.closeAddMemberModal();
            return;
        }
        window.location.href = '@Url.Action("Member", "FrontDesk")';
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
