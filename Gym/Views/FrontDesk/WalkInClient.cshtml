@model List<Gym.Models.WalkInClientListItem>

@{
    var isAdmin = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);
    var walkInController = isAdmin ? "Admin" : "FrontDesk";
    var currentPage = ViewBag.Page is int pageNumber ? pageNumber : 1;
    var totalPages = ViewBag.TotalPages is int pageCount ? pageCount : 1;
    var totalCount = ViewBag.TotalCount is int itemCount ? itemCount : Model.Count;
    Layout = isAdmin ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_FrontDeskLayout.cshtml";
    ViewData["Title"] = "Walk-in Clients";
    var registrationError = TempData["WalkInRegistrationError"] as string;
    var registrationSuccess = TempData["WalkInRegistrationSuccess"] as string;
    var receiptWarning = TempData["WalkInReceiptWarning"] as string;
    var paymentTypes = ViewBag.WalkInPaymentTypes as List<Gym.Models.WalkInPaymentType> ?? new();
}

<style>
    body > .container {
        max-width: none;
        margin: 0;
        padding: 0 28px;
    }

    .wi-page {
        width: min(1100px, calc(100vw - 360px));
        margin: 26px auto;
        font-family:Arial, sans-serif;
        color: #102630;
    }

    .wi-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
        margin-bottom: 18px;
    }

        .wi-head h2 {
            
            margin: 0 0 5px;
        }

        .wi-head p {
            margin: 0;
            color: #637069;
        }

    .wi-add {
        border: 0;
        background: rgb(8, 61, 2);
        color: #fff;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
    }

    .wi-card {
        overflow: hidden;
        border: 1px solid #d7e5e9;
        border-radius: 8px;
        background: #fff;
    }

    .wi-footer { display:flex; align-items:center; justify-content:space-between; min-height:80px; padding:14px 20px; background:#5E5D63; box-sizing:border-box; }
    .wi-footer > span { color:#aab3ac;  }
    .wi-pages { display:flex; gap:12px; }
    .wi-page-button { min-width:102px; height:50px; display:grid; place-items:center; padding:0 18px; border:1px solid #74777a; border-radius:5px; background:transparent; color:#fff; text-decoration:none;  font-weight:700; text-transform:uppercase; box-sizing:border-box; }
    .wi-page-button.disabled { opacity:.4; pointer-events:none; }

    .wi-table {
        width: 100%;
        border-collapse: collapse;
    }

        .wi-table th {
            padding: 14px 20px;
            background: #e5f4fb;
            text-align: left;
            
            letter-spacing: 0.5px;
        }

        .wi-table td {
            padding: 17px 20px;
            border-top: 1px solid #edf0ee;
        }

    .reason {
        display: inline-block;
        background: #e3f1f7;
        padding: 6px 8px;
        
    }
    .wi-card .wi-pay {
        padding: 6px 14px;
        line-height: 1.2;
        white-space: nowrap;
    }

        .wi-card .wi-pay:disabled {
            padding: 6px 14px;
            background: transparent;
            color: #9ba49d;
            cursor: not-allowed;
        }
    .wi-modal-backdrop { display:none; position:fixed; inset:0; z-index:1200; align-items:center; justify-content:center; padding:20px; background:rgba(7,25,15,.58); }
    .wi-modal-backdrop.show { display:flex; }
    .wi-modal { width:min(430px,100%); padding:24px; border:1px solid #737278; border-radius:10px; background:#5e5d63; color:#fff; box-shadow:0 18px 55px rgba(0,0,0,.25); }
    .wi-register-modal { width:min(720px,100%); max-height:calc(100vh - 40px); overflow-y:auto; }
    .wi-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:15px; }
    .wi-form-group { margin-bottom:15px; }
    .wi-form-group.full { grid-column:1 / -1; }
    .wi-form-group label { display:block; margin-bottom:6px;  font-weight:700; text-transform:uppercase; }
    .wi-form-group input, .wi-form-group select { width:100%; height:44px; padding:0 12px; border:1px solid #d7ddd9; border-radius:5px; background:transparent; color:#fff; box-sizing:border-box; }
    .wi-form-group select option { background:#5e5d63; color:#fff; }
    .wi-form-group select option:hover,
    .wi-form-group select option:checked { background:#5e5d63; color:#a8df32; }
    .wi-modal h2 { margin:0 0 7px;  }
    .wi-modal p { margin:0 0 20px; color:#fff; }
    .wi-modal label { display:block; margin-bottom:7px; font-weight:700; }
    .wi-modal input { width:100%; height:44px; padding:0 12px; border:1px solid #d7ddd9; border-radius:6px; background:transparent; color:#fff; box-sizing:border-box;  }
    .wi-modal-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:22px; }
    .wi-cancel { padding:10px 17px; border:1px solid #d7ddd9; border-radius:6px; background:transparent; color:#fff; cursor:pointer; }

    .wi-success {
        margin-bottom: 16px;
        padding: 12px 15px;
        border: 1px solid #9fd2a8;
        background: #edf9ef;
        color: #176729;
        border-radius: 7px;
    }

    .wi-error {
        margin-bottom: 16px;
        padding: 12px 15px;
        border: 1px solid #efb3b3;
        background: #fff0f0;
        color: #a51f1f;
        border-radius: 7px;
    }

    .wi-search {
        display: grid;
        grid-template-columns: minmax(280px, 650px) 86px;
        gap: 10px;
        width: min(100%, 746px);
        margin: 0 0 18px;
    }

        .wi-search input {
            width: 100%;
            min-width: 0;
            height: 43px;
            border: 1px solid #cad6d0;
            border-radius: 6px;
            padding: 0 14px;
            
            box-sizing: border-box;
        }

        .wi-search button {
            width: 86px;
            height: 43px;
            padding: 0;
            border: 0;
            border-radius: 6px;
            background: rgb(8, 61, 2);
            color: #fff;
            
            font-weight: 700;
            cursor: pointer;
        }

    @@media (max-width: 760px) {
        .wi-page {
            width: calc(100vw - 40px);
        }

        .wi-head {
            align-items: flex-start;
            gap: 15px;
        }

        .wi-card {
            overflow-x: auto;
        }

        .wi-table {
            min-width: 760px;
        }
    }

    @@media (max-width: 600px) {
        .wi-form-grid { grid-template-columns:1fr; }
        .wi-search {
            grid-template-columns: minmax(0, 1fr) 76px;
            width: 100%;
        }

            .wi-search button {
                width: 76px;
            }
    }

    /* Keep the walk-in page title/subtitle and search controls 5px apart.
       This page-local rule is intentionally final and high priority so shared
       dashboard header spacing cannot override it. */
    main.wi-page > header.wi-head {
        min-height: 0 !important;
        height: auto !important;
        margin: 0 0 5px !important;
        padding: 0 !important;
        border: 0 !important;
    }

    main.wi-page > header.wi-head h1,
    main.wi-page > header.wi-head h2 {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    main.wi-page > header.wi-head p {
        margin-bottom: 0 !important;
    }

    main.wi-page > form.wi-search {
        margin-top: 0 !important;
    }
</style>

<main class="wi-page">

    <header class="wi-head">
        <div>
            <h1 style="font-weight:700!important;color:#fff !important;margin-bottom: 0px !important;" class="form-dialog-title">Walk-in Client Registration</h1>

            <p class="dashboard-caption" style="color:#aeb7b0!important;line-height:1.4!important;">
                Quickly register a new visitor and grant temporary facility access.
            </p>
        </div>

        <div style="display:flex;align-items:center;justify-content:flex-end;gap:12px;flex-wrap:wrap">
            @if (isAdmin)
            {
                <a class="wi-add" asp-controller="Admin" asp-action="Payments" asp-route-manageWalkInTypes="true" style="display:inline-flex;text-decoration:none">＋ Add walk-in payment type</a>
            }
            <button type="button" class="wi-add" id="openWalkInRegistration" style="">
                ＋ Register Walk-in
            </button>
        </div>
    </header>
    @if (paymentTypes.Count == 0)
    {
        <p role="alert">Walk-in registration is unavailable. An administrator must add an active walk-in payment type first.</p>
    }

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="wi-success">
            @message
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="wi-error">
            @error
        </div>
    }

    <form class="wi-search" method="get" asp-action="WalkInClient">
        <input name="searchTerm"
               value="@ViewBag.SearchTerm"
               placeholder="Search by name, contact, email, or visit reason..." />

        <button type="submit" class="walkin-search-button">
            Search
        </button>
    </form>

    <section class="wi-card">

        <h2 class="table-title-bar" style=" margin: 0 0 14px;">
            Recent Walk-in Registrations
        </h2>
        <table class="wi-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact</th>
                    <th>Reason for Visit</th>
                    <th>Last Visit</th>
                    <th>Date Registered</th>
                    <th>Payment</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="walkin-empty-message" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;text-align: center;">
                            No walk-in registrations yet.
                        </td>
                    </tr>
                }

                @foreach (var item in Model)
                {
                    <tr>
                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            <div class="wi-member-name" style="">
                                <span class="wi-avatar" style="">@($"{item.FirstName?.FirstOrDefault()}{item.LastName?.FirstOrDefault()}".Trim().ToUpperInvariant())</span>
                                <span style="">@item.FirstName @item.LastName</span>
                            </div>
                        </td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            @item.ContactNumber
                        </td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            <span class="reason" style="">
                                @item.ReasonForVisit
                            </span>
                        </td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            @item.LastVisitAt.ToString("MMM d, yyyy · h:mm tt")
                        </td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            @item.FirstRegisteredAt.ToString("MMM d, yyyy")
                        </td>

                        <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                            <button type="button" class="wi-pay" style=""
                                    data-id="@item.WalkInClientId"
                                    data-name="@item.FirstName @item.LastName"
                                    disabled="@(item.LastVisitAt.Date == DateTime.Today)">
                                @(item.LastVisitAt.Date == DateTime.Today ? "Registered today" : "Payment")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <footer class="wi-footer">
            <span class="pagination-summary">Showing @Model.Count of @totalCount registrations</span>
            <nav class="wi-pages" aria-label="Walk-in registration pages">
                <a class="wi-page-button @(currentPage <= 1 ? "disabled" : "")"
                   asp-controller="@walkInController" asp-action="WalkInClient"
                   asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-page="@(currentPage - 1)">Previous</a>
                <a class="wi-page-button @(currentPage >= totalPages ? "disabled" : "")"
                   asp-controller="@walkInController" asp-action="WalkInClient"
                   asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-page="@(currentPage + 1)">Next</a>
            </nav>
        </footer>
    </section>

</main>

<style>
    #walkInSuccessDialog {
        position: fixed;
        inset: 0;
        margin: auto; /* restores the centering a global reset removed */
        padding: 0;
        border: 0;
        background: transparent;
        width: min(560px, calc(100vw - 32px));
        height: fit-content; /* needed so margin:auto centers vertically */
        max-height: 90vh;
        overflow: auto;
    }

        #walkInSuccessDialog::backdrop {
            background: rgba(0, 0, 0, .65);
        }
    html body #walkInRegistrationModal { background:rgba(0,0,0,.7); }
    html body #walkInRegistrationModal .wi-register-modal {
        background:#1b201c !important; color:#fff !important;
        border:1px solid #3c443d !important; border-radius:14px;
        padding:28px; box-shadow:0 18px 55px #0006;
    }
    html body #walkInRegistrationModal h2 { color:#fff !important;  }
    html body #walkInRegistrationModal p { color:#fff !important; margin-bottom:24px; }
    html body #walkInRegistrationModal .wi-form-grid { border:1px solid #3c443d; padding:16px; gap:20px 16px; }
    html body #walkInRegistrationModal label { color:#fff !important; text-transform:none !important; }
    html body #walkInRegistrationModal :is(input, select) {
        background:#1b201c !important; color:#fff !important;
        border:1px solid #bcc3bd !important; border-radius:0 !important;
        height:42px; padding:0 12px; box-shadow:none !important; color-scheme:dark;
    }
    html body #walkInRegistrationModal :is(input, select):hover { border-color:#b7ff1b !important; }
    html body #walkInRegistrationModal :is(input, select):focus {
        border-color:#b7ff1b !important; outline:2px solid #35552c !important; outline-offset:2px;
    }
    html body #walkInRegistrationModal input:-webkit-autofill {
        -webkit-text-fill-color:#fff !important;
        -webkit-box-shadow:0 0 0 1000px #1b201c inset !important;
        box-shadow:0 0 0 1000px #1b201c inset !important; caret-color:#fff;
    }
    html body #walkInRegistrationModal #walkInAmount { margin-top:4px; }
</style>
<div class="wi-modal-backdrop @(registrationError != null ? "show" : "")" id="walkInRegistrationModal" aria-hidden="@(registrationError == null ? "true" : "false")">
    <section class="wi-modal wi-register-modal" role="dialog" aria-modal="true" aria-labelledby="walkInRegistrationTitle">
        <h2 id="walkInRegistrationTitle" class="form-dialog-title">Register walk-in client</h2>
        <p>Each client can be registered only once per day. Receipts are emailed automatically.</p>
        <form asp-action="WalkInRegister" asp-controller="@walkInController" method="post" id="walkInRegistrationForm">
            @Html.AntiForgeryToken()
            @if (registrationError != null)
            {
                <div class="form-error-summary" role="alert" tabindex="-1">
                    <strong>Please correct the following before submitting:</strong>
                    <ul><li data-form-server-error>@registrationError</li></ul>
                </div>
            }
            <div class="wi-form-grid">
                <div class="wi-form-group">
                    <label for="walkInFirstName">First name *</label>
                    <input id="walkInFirstName" name="FirstName" required />
                </div>
                <div class="wi-form-group">
                    <label for="walkInLastName">Last name *</label>
                    <input id="walkInLastName" name="LastName" required />
                </div>
                <div class="wi-form-group">
                    <label for="walkInContact">Contact number *</label>
                    <input id="walkInContact" name="ContactNumber" required />
                </div>
                <div class="wi-form-group">
                    <label for="walkInEmail">Email *</label>
                    <input id="walkInEmail" name="Email" type="email" required />
                </div>
                <div class="wi-form-group">
                    <label for="walkInType">Payment type *</label>
                    <select id="walkInType" name="PaymentTypeId" required data-amount-target="walkInAmount">
                        <option value="">Select payment type</option>
                        @foreach (var rate in paymentTypes)
                        {
                            <option value="@rate.Id" data-amount="@rate.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@rate.Name — ₱@rate.Amount.ToString("N2")</option>
                        }
                    </select>
                    @if (paymentTypes.Count == 0) { <small>Ask an administrator to add a walk-in payment type in Payments.</small> }
                </div>
                <div class="wi-form-group">
                    <label for="walkInAmount">Amount paid (₱)</label>
                    <input id="walkInAmount" name="AmountPaid" type="number" min="0.01" step="0.01" readonly required />
                </div>
            </div>
            <div class="wi-modal-actions">
                <button type="button" class="wi-cancel" id="closeWalkInRegistration">Cancel</button>
                <button type="submit" class="wi-pay" disabled="@(paymentTypes.Count == 0)">Register client</button>
            </div>
        </form>
    </section>
</div>

<div class="wi-modal-backdrop" id="walkInPaymentModal" aria-hidden="true">
    <section class="wi-modal" role="dialog" aria-modal="true" aria-labelledby="walkInPaymentTitle">
        <h2 id="walkInPaymentTitle">Record walk-in payment</h2>
        <p id="walkInPaymentClient"></p>
        <form asp-action="RecordWalkInPayment" asp-controller="@walkInController" method="post" id="walkInPaymentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="walkInPaymentId" />
            <label for="walkInPaymentType">Payment type</label>
            <select id="walkInPaymentType" name="paymentTypeId" required data-amount-target="walkInPaymentAmount">
                <option value="">Select payment type</option>
                @foreach (var rate in paymentTypes)
                {
                    <option value="@rate.Id" data-amount="@rate.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@rate.Name — ₱@rate.Amount.ToString("N2")</option>
                }
            </select>
            <label for="walkInPaymentAmount">Cash amount (₱)</label>
            <input type="number" name="amount" id="walkInPaymentAmount" min="0.01" step="0.01" readonly required />
            <div class="wi-modal-actions">
                <button type="button" class="wi-cancel" id="closeWalkInPayment">Cancel</button>
                <button type="submit" class="wi-pay">Confirm payment</button>
            </div>
        </form>
    </section>
</div>

<script>
    (() => {
        const registrationModal = document.getElementById('walkInRegistrationModal');
        if (registrationModal.classList.contains('show')) {
            window.addEventListener('load', () => {
                const summary = registrationModal.querySelector('.form-error-summary');
                summary?.scrollIntoView({ block: 'nearest' });
                summary?.focus({ preventScroll: true });
            });
        }
        const closeRegistration = () => { registrationModal.classList.remove('show'); registrationModal.setAttribute('aria-hidden', 'true'); };
        document.getElementById('openWalkInRegistration').addEventListener('click', () => {
            registrationModal.classList.add('show');
            registrationModal.setAttribute('aria-hidden', 'false');
            document.getElementById('walkInFirstName').focus();
        });
        document.getElementById('closeWalkInRegistration').addEventListener('click', closeRegistration);
        registrationModal.addEventListener('click', event => { if (event.target === registrationModal) closeRegistration(); });
        document.getElementById('walkInRegistrationForm').addEventListener('submit', event => {
            const button = event.currentTarget.querySelector('button[type="submit"]');
            button.disabled = true;
            button.textContent = 'Registering...';
        });

        const modal = document.getElementById('walkInPaymentModal');
        const idInput = document.getElementById('walkInPaymentId');
        const amountInput = document.getElementById('walkInPaymentAmount');
        const clientText = document.getElementById('walkInPaymentClient');
        const close = () => { modal.classList.remove('show'); modal.setAttribute('aria-hidden', 'true'); };
        document.querySelectorAll('.wi-pay[data-id]').forEach(button => button.addEventListener('click', () => {
            idInput.value = button.dataset.id;
            clientText.textContent = button.dataset.name + ' · Cash only';
            amountInput.value = '';
            document.getElementById('walkInPaymentType').value = '';
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            amountInput.focus();
        }));
        document.getElementById('closeWalkInPayment').addEventListener('click', close);
        modal.addEventListener('click', event => { if (event.target === modal) close(); });
        document.getElementById('walkInPaymentForm').addEventListener('submit', event => {
            const button = event.currentTarget.querySelector('button[type="submit"]');
            button.disabled = true;
            button.textContent = 'Processing...';
        });
    })();
</script>
@if (registrationSuccess != null)
{
    var confirmationData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);
    confirmationData["Title"] = "Registration complete";
    confirmationData["Message"] = registrationSuccess;
    confirmationData["Warning"] = receiptWarning;
    confirmationData["ReturnUrl"] = Url.Action("WalkInClient", walkInController);
    confirmationData["ReturnLabel"] = "Done — return to list";
    <dialog id="walkInSuccessDialog" aria-labelledby="completion-title">
        @await Html.PartialAsync("_CompletionCard", null, confirmationData)
    </dialog>
    <script>
        (() => {
            const dialog = document.getElementById('walkInSuccessDialog');
            dialog.showModal();
            dialog.querySelector('.completion-return').addEventListener('click', event => {
                event.preventDefault();
                dialog.close();
            });
            dialog.addEventListener('close', () => document.getElementById('openWalkInRegistration').focus());
        })();
    </script>
}

<script>
    document.querySelectorAll('select[data-amount-target]').forEach(select => {
        select.addEventListener('change', () => {
            document.getElementById(select.dataset.amountTarget).value = select.selectedOptions[0]?.dataset.amount || '';
        });
    });
</script>
