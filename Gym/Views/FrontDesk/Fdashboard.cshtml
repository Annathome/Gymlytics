@model Gym.Models.FrontDeskDashboardViewModel

@{
    Layout = "~/Views/Shared/_FrontDeskLayout.cshtml";
    ViewData["Title"] = "Front Desk Dashboard";
}

<style>
    body > .container {
        max-width: none;
        margin: 0;
        padding-left: 24px;
        padding-right: 24px;
    }

    /* ========================================
       Dashboard shell
       ======================================== */
    .fd-dashboard {
        width: 100%;
        max-width: none;
        margin: 0;
        color: #c4ccc6;
        background: transparent;
        font-family:Arial, Helvetica, sans-serif;
    }

    .fd-dashboard > section + section {
        margin-top: 34px;
    }

    .role-dashboard-head {
        margin: 0 0 30px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .role-dashboard-head h1 {
        margin: 0 0 5px;
        color: #d7ddd8;
        
        font-weight: 700;
    }

    .role-dashboard-head p {
        margin: 0;
        color: #9ba49d;
        
    }

    .fd-notification-bell {
        position: relative;
        display: grid;
        place-items: center;
        width: 40px;
        height: 38px;
        color: #b9ff20;
        text-decoration: none;
        
    }

    .fd-notification-bell:hover,
    .fd-notification-bell:focus { color: #fff; }

    .fd-notification-bell i {  }

    .fd-notification-count {
        position: absolute;
        top: -6px;
        right: -5px;
        display: grid;
        place-items: center;
        min-width: 17px;
        height: 17px;
        padding: 0 4px;
        border-radius: 20px;
        background: #d92d20;
        color: #fff;
        
        font-weight: 700;
        line-height: 1;
    }

    .fd-panel,
    .fd-summary-card {
        background: #5E5D63;
        border: 1px solid #1f6b37;
        border-radius: 6px;
        box-shadow: none;
    }

    /* Weekly summary */
    .fd-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .fd-summary-card {
        min-height: 150px;
        padding: 22px;
        border-left-width: 1px;
        box-sizing: border-box;
    }

    .fd-summary-label {
        margin: 0 0 14px;
        color: #d7ddd8;
        
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .fd-summary-value {
        margin: 0;
        color: #b9ff20;
        
        font-weight: 700;
        line-height: 1;
    }

    .fd-summary-description {
        margin: 9px 0 0;
        color: #9ba49d;
        
    }

    /* ========================================
       Chart + trainer availability
       ======================================== */
    .fd-insights-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(360px, .85fr);
        gap: 22px;
        margin-top: 34px;
        align-items: stretch;
    }

    .fd-chart,
    .fd-availability {
        padding: 22px;
    }

    .fd-chart-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
    }

    .fd-chart-head h2,
    .fd-availability > h2,
    .fd-schedule-head h2 {
        margin: 0;
        color: #d7ddd8;
        
    }

    .fd-legend,
    .fd-trainer-days,
    .fd-not-set {
        color: #9ba49d;
    }

    .fd-legend {
        display: flex;
        gap: 24px;
    }

    .fd-key::before {
        content: "";
        display: inline-block;
        width: 18px;
        height: 3px;
        margin-right: 6px;
        vertical-align: middle;
        background: #b7ff1b;
    }

    .fd-key.walkins::before {
        height: 0;
        background: none;
        border-top: 3px solid #ff9d24;
    }

    .fd-chart-wrap {
        position: relative;
        width: 100%;
        height: 250px;
    }

    .fd-chart canvas {
        width: 100%;
        height: 100%;
    }

    .fd-availability {
        overflow: hidden;
    }

    .fd-availability > h2 {
        padding: 20px;
        border-bottom: 1px solid #dce5e1;
    }

    .fd-availability-wrap {
        max-height: 336px;
        overflow: auto;
    }

    .fd-table,
    .fd-availability-table {
        background: transparent;
        color: #9ba49d;
    
    }

    .fd-availability-table {
        width: 100%;
        border-collapse: collapse;
        
    }

    .fd-table th,
    .fd-availability-table th {
        padding: 11px 13px;
        color: #9ba49d;
        text-align: left;
        
        border:none;
    }

    .fd-availability-table td {
        padding: 13px;
        border-top: 1px solid #e7ede9;
        vertical-align: top;
    }

    .fd-trainer-name {
        display: block;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .fd-trainer-days {
        
        line-height: 1.35;
    }

    .fd-slot-count {
        display: inline-block;
        min-width: 27px;
        padding: 5px 8px;
        border-radius: 999px;
        background: #dcf5df;
        color: #08752a;
        text-align: center;
        font-weight: 800;
    }

    .fd-slot-count.full {
        background: #fde7df;
        color: #a93a20;
    }

    .fd-not-set {
        font-style: italic;
    }

    /* ========================================
       Today's schedule
       ======================================== */
    .fd-schedule {
        margin-top: 18px;
        padding: 0;
        overflow: hidden;
    }

    .fd-schedule-head {
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        background: #5E5D63;
        color: #fff;
        border-bottom: 1px solid #293029;
    }

    .fd-table-wrap {
        overflow-x: auto;
    }

    .fd-table {
        width: 100%;
        min-width: 780px;
        border-collapse: collapse;
    }

    .fd-table th {
        padding: 12px 18px;
        background: #5E5D63;
        color: #9ba49d;
        
        border-bottom: 1px solid #293029;
    }

    .fd-table td {
        height: auto;
        padding: 13px 18px;
        background: #5E5D63;
        color: #9ba49d;
        
        border-top: 0;
        border-bottom: 1px solid #293029;
    }

    .fd-table td[colspan] {
        padding: 20px 18px;
        text-align: center;
    }

    /* ========================================
       Status badges
       ======================================== */
    .fd-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 0;
        
        font-weight: 700;
    }

    .fd-badge.scheduled {
        color: #946700;
        background: #fff8e6;
        border: 1px solid #efd27a;
    }

    .fd-badge.confirmed {
        color: #176b2c;
        background: #e8f7e8;
        border: 1px solid #b8dab9;
    }

    .fd-badge.completed {
        color: #285d78;
        background: #eaf5fa;
        border: 1px solid #bdd9e7;
    }

    .fd-badge.cancelled {
        color: #9b2828;
        background: #faeaea;
        border: 1px solid #e7baba;
    }

    /* ========================================
       Table actions
       ======================================== */
    .fd-reminder-form {
        margin: 0;
    }

    .fd-action {
        padding: 7px 12px;
        border: 1px solid #cad8dd;
        border-radius: 6px;
        background: #fff;
        
        cursor: pointer;
    }

    .fd-action.remind {
        border-color: #08752a;
        background: #08752a;
        color: #fff;
        font-weight: 700;
    }

    .fd-action.remind:hover {
        background: #065f22;
    }

    .fd-action.reminded {
        border-color: #69786f;
        background: #dce6df;
        color: #355143;
        cursor: default;
    }

    .fd-notice {
        margin: 0 0 14px;
        padding: 11px 14px;
        border-radius: 7px;
    }

    .fd-notice.success {
        background: #e8f7e8;
        color: #176b2c;
    }

    .fd-notice.error {
        background: #faeaea;
        color: #9b2828;
    }

    .fd-toast {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9000;
        min-width: 260px;
        padding: 15px 18px;
        border-left: 5px solid #0ec52d;
        border-radius: 8px;
        background: #fff;
        color: #176b2c;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .2);
        animation: fdToastIn .25s ease-out;
    }

    @@keyframes fdToastIn {
        from { opacity: 0; transform: translateY(-12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ========================================
       Table footer / pagination
       ======================================== */
    .fd-table-foot {
        min-height: 62px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 18px;
        border-top: 0;
        background: #5E5D63;
        color: #9ba49d;
        
    }

    .fd-pager {
        margin-left: auto;
        display: flex;
        flex-direction: row;
        gap: 8px;
    }

    .fd-pager button {
        width: 42px;
        height: 34px;
        display: inline-block;
        padding: 0;
        border: 1px solid #415128;
        border-radius: 0;
        background: #283313;
        color: #a8df32;
        
        font-weight: 400;
        text-align: center;
        cursor: pointer;
    }

    .fd-pager button:disabled {
        opacity: .45;
        cursor: default;
    }

    /* ========================================
       Responsive
       ======================================== */
    @@media (max-width: 1100px) {
        .fd-insights-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 900px) {
        .fd-summary-grid,
        .fd-insights-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 760px) {
        .fd-summary-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .fd-chart-head {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .fd-legend {
            gap: 16px;
        }

        .fd-table-foot {
            min-width: 780px;
        }
    }
</style>

<main class="fd-dashboard">

    <header class="role-dashboard-head">
        <div>
            <h1 class="fd-title" style="font-weight:700!important;margin-bottom: 0px !important;">Front Desk Overview</h1>
            <p class="fd-subtitle" style="margin-top:0px !important;">Live facility operations and member service activity.</p>
        </div>
        <a class="fd-notification-bell" asp-controller="FrontDesk" asp-action="Notifications"
           title="Front desk notifications" aria-label="Front desk notifications">
            <i class="bi bi-bell-fill"></i>
            @if (Model.UnreadNotificationsCount > 0)
            {
                <span class="fd-notification-count">@Model.UnreadNotificationsCount</span>
            }
        </a>
    </header>

    <!-- Weekly Summary -->
    <section class="fd-summary-grid" aria-label="Weekly front desk summary">
        <article class="fd-summary-card">
            <p class="fd-summary-label">Expiring Soon</p>
            <p class="fd-summary-value summary-warning" style="">@Model.ExpiringSoonMemberships</p>
            <p class="fd-summary-description">Membership(s) expiring within 7 days</p>
        </article>
        <article class="fd-summary-card">
            <p class="fd-summary-label">Walk-ins</p>
            <p class="fd-summary-value" style="">@Model.WeeklyWalkIns</p>
            <p class="fd-summary-description">Visitor(s) registered in the last 7 days</p>
        </article>
        <article class="fd-summary-card">
            <p class="fd-summary-label">Equipment Maintenance</p>
            <p class="fd-summary-value summary-danger" style="">@Model.EquipmentNeedingMaintenance</p>
            <p class="fd-summary-description">Equipment item(s) needing maintenance</p>
        </article>
    </section>

    <section class="fd-insights-grid" aria-label="Weekly traffic and trainer availability">

        <!-- Weekly Traffic Chart -->
        <section class="fd-panel fd-chart">
            <div class="fd-chart-head">
                <h2>Weekly Gym Traffic</h2>
                <div class="fd-legend">
                    <span class="fd-key">Member check-ins</span>
                    <span class="fd-key walkins">Walk-ins</span>
                </div>
            </div>
            <div class="fd-chart-wrap">
                <canvas id="weeklyTrafficChart" aria-label="Weekly comparison of walk-ins and member check-ins"></canvas>
            </div>
        </section>

        <!-- Trainer Availability -->
        <section class="fd-panel fd-availability">
            <h2>Trainer Availability</h2>
            <div class="fd-availability-wrap">
                <table class="fd-availability-table">
                    <thead>
                        <tr>
                            <th>TRAINER / HOURS</th>
                            <th>ASSIGNED</th>
                            <th>REMAINING</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TrainerAvailability.Count == 0)
                        {
                            <tr><td colspan="3" class="fd-not-set" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">No active trainers found.</td></tr>
                        }
                        @foreach (var trainer in Model.TrainerAvailability)
                        {
                            <tr>
                                <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                                    <span class="fd-trainer-name" style="">@trainer.TrainerName</span>
                                    @if (trainer.StartTime.HasValue && trainer.EndTime.HasValue)
                                    {
                                        <span class="fd-trainer-days" style="">
                                            @string.Join(", ", trainer.AvailableDays.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(day => day.Length > 3 ? day[..3] : day))<br />
                                            @DateTime.Today.Add(trainer.StartTime.Value).ToString("h:mm tt")–@DateTime.Today.Add(trainer.EndTime.Value).ToString("h:mm tt")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fd-not-set" style="">Schedule not set</span>
                                    }
                                </td>
                                <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@trainer.AssignedMembers / @(trainer.WeeklyMemberLimit?.ToString() ?? "—")</td>
                                <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                                    @if (trainer.RemainingSlots.HasValue)
                                    {
                                        <span class="fd-slot-count @(trainer.RemainingSlots <= 5 ? "capacity-low" : trainer.RemainingSlots <= 10 ? "capacity-warning" : "capacity-ready")" style="background:transparent!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;">@trainer.RemainingSlots</span>
                                    }
                                    else
                                    {
                                        <span class="fd-not-set" style="">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </section>

    <!-- Today's Schedule -->
    @if (TempData["SuccessMessage"] is string reminderSuccess)
    {
        <div class="fd-toast" id="reminderToast"><strong>Reminded</strong><div>@reminderSuccess</div></div>
    }
    @if (TempData["ErrorMessage"] is string reminderError)
    {
        <div class="fd-notice error">@reminderError</div>
    }

    <section class="fd-panel fd-schedule" id="schedule">

        <div class="fd-schedule-head">
            <h2>Today's Schedule</h2>
        </div>

        <div class="fd-table-wrap">
            <table class="fd-table">
                <thead>
                    <tr>
                        <th>TRAINER</th>
                        <th>MEMBER</th>
                        <th>DATE</th>
                        <th>TIME</th>
                        <th>STATUS</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model.Schedule.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="fd-not-set" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">No upcoming sessions found.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Schedule)
                    {
                        var statusClass = item.DisplayStatus.ToLowerInvariant();


                        <tr>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.TrainerName</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.MemberName</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.Date.ToString("yyyy-MM-dd")</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.StartTime.ToString("h:mm tt") - @item.EndTime.ToString("h:mm tt")</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;"><span class="fd-badge @statusClass" style="background:transparent!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;">@item.DisplayStatus</span></td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="fd-table-foot">
            <span class="pagination-summary">Showing @Model.Schedule.Count of @Model.ScheduleTotalCount (page @Model.SchedulePage of @Model.ScheduleTotalPages)</span>
            <form class="fd-pager" method="get" asp-action="Fdashboard">
                <button type="submit" name="schedulePage" value="@(Model.SchedulePage - 1)" disabled="@(Model.SchedulePage <= 1)">Previous</button>
                <button type="submit" name="schedulePage" value="@(Model.SchedulePage + 1)" disabled="@(Model.SchedulePage >= Model.ScheduleTotalPages)">Next</button>
            </form>
        </div>

    </section>

</main>

<script>
    (() => {
        const points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyTraffic));
        const canvas = document.getElementById("weeklyTrafficChart");
        const ctx = canvas.getContext("2d");

        function draw() {
            const ratio = window.devicePixelRatio || 1;
            const width = canvas.clientWidth;
            const height = canvas.clientHeight;

            canvas.width = width * ratio;
            canvas.height = height * ratio;
            ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
            ctx.clearRect(0, 0, width, height);

            const pad = { l: 38, r: 18, t: 14, b: 30 };
            const chartWidth = width - pad.l - pad.r;
            const chartHeight = height - pad.t - pad.b;

            const highest = Math.max(0, ...points.map(p => Math.max(p.MemberAttendance, p.WalkIns)));
            const max = Math.max(10, Math.ceil(highest / 5) * 5);
            const tickCount = max / 5;

            ctx.font = "12px Arial";
            ctx.strokeStyle = "#293029";
            ctx.fillStyle = "#ffffff";
            ctx.lineWidth = 1;

            // Horizontal grid lines
            for (let i = 0; i <= tickCount; i++) {
                const y = pad.t + (chartHeight * i / tickCount);
                const value = max - (i * 5);

                ctx.beginPath();
                ctx.moveTo(pad.l, y);
                ctx.lineTo(width - pad.r, y);
                ctx.stroke();
                ctx.fillText(value, 8, y + 4);
            }

            const x = i => pad.l + (points.length === 1 ? chartWidth / 2 : chartWidth * i / (points.length - 1));
            const y = value => pad.t + chartHeight - (value / max) * chartHeight;

            // Day labels
            points.forEach((point, i) => {
                ctx.fillText(point.Day, x(i) - 10, height - 8);
            });

            function line(key, color, dashed, squareMarker) {
                ctx.save();
                ctx.strokeStyle = color;
                ctx.fillStyle = color;
                ctx.lineWidth = 3;
                ctx.setLineDash(dashed ? [8, 6] : []);

                ctx.beginPath();
                points.forEach((point, i) => {
                    const px = x(i);
                    const py = y(point[key]);
                    if (i) ctx.lineTo(px, py);
                    else ctx.moveTo(px, py);
                });
                ctx.stroke();
                ctx.setLineDash([]);

                ctx.font = "bold 11px Arial";
                ctx.textAlign = "center";
                points.forEach((point, i) => {
                    const px = x(i);
                    const py = y(point[key]);

                    ctx.beginPath();
                    if (squareMarker) ctx.rect(px - 4, py - 4, 8, 8);
                    else ctx.arc(px, py, 4.5, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillText(point[key], px, Math.max(11, py - 10));
                });
                ctx.restore();
            }

            line("MemberAttendance", "#b7ff1b", false, false);
            line("WalkIns", "#ff9d24", true, true);
        }

        draw();
        window.addEventListener("resize", draw);
    })();
</script>
<script>
    const reminderToast = document.getElementById('reminderToast');
    if (reminderToast) window.setTimeout(() => reminderToast.remove(), 3500);
</script>
