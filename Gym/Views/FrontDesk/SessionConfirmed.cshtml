@model Gym.Models.SessionReminderResponseViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head><link rel="stylesheet" href="~/css/system-typography.css" asp-append-version="true" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Session Confirmed - YOKOKS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:wght@400;700&display=swap" rel="stylesheet" />
    <style>
        *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#eef5f1;color:#183028;font-family:"Inria Serif",serif}.card{width:min(550px,100%);overflow:hidden;border-radius:12px;background:#fff;box-shadow:0 18px 45px rgba(16,55,31,.16)}.head{padding:25px 29px;background:#08752a;color:#fff}.head h1{margin:0;}.body{padding:29px}.icon{width:64px;height:64px;display:grid;place-items:center;margin-bottom:18px;border-radius:50%;background:#d8f5dd;color:#08752a;font-weight:700}.body p{line-height:1.55}.details{margin:22px 0;padding:16px;border-left:4px solid #0ec52d;background:#f4f8f5}.details div+div{margin-top:8px}.note{color:#64736a;}.close{width:100%;padding:12px;border:0;border-radius:7px;background:#083d02;color:#fff;font-family:"Inria Serif",serif;font-weight:700;cursor:pointer}
    </style>
</head>
<body>
    <main class="card">
        <header class="head"><h1 style="font-weight:700!important;">Session Confirmed</h1></header>
        <section class="body">
            <div class="icon">✓</div>
            <p>Thank you, <strong>@Model.MemberName</strong>.</p>
            <p>Your attendance is confirmed. Your trainer has been notified that you will attend this gym session.</p>
            <div class="details"><div><strong>Trainer:</strong> @Model.TrainerName</div><div><strong>Date:</strong> @Model.SessionDate.ToString("MMMM d, yyyy")</div></div>
            <p class="note">You may now close this page.</p>
            <button class="close" type="button" onclick="window.close()">Close</button>
        </section>
    </main>
</body>
</html>
