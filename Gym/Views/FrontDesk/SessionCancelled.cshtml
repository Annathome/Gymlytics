@model Gym.Models.SessionReminderResponseViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cannot Attend - YOKOKS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:wght@400;700&display=swap" rel="stylesheet" />
    <style>
        *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#fff2f0;color:#351713;font-family:"Inria Serif",serif}.card{width:min(550px,100%);overflow:hidden;border-radius:12px;background:#fff;box-shadow:0 18px 45px rgba(80,20,15,.16)}.head{padding:25px 29px;background:#b42318;color:#fff}.head h1{margin:0;font-size:29px}.body{padding:29px}.icon{width:64px;height:64px;display:grid;place-items:center;margin-bottom:18px;border-radius:50%;background:#fee4e2;color:#b42318;font-size:31px;font-weight:700}.body p{font-size:17px;line-height:1.55}.details{margin:22px 0;padding:16px;border-left:4px solid #d92d20;background:#fff6f5}.details div+div{margin-top:8px}.note{color:#78615e;font-size:14px!important}.close{width:100%;padding:12px;border:0;border-radius:7px;background:#7a271a;color:#fff;font:700 16px "Inria Serif",serif;cursor:pointer}
    </style>
</head>
<body>
    <main class="card">
        <header class="head"><h1>Unable to Attend</h1></header>
        <section class="body">
            <div class="icon">✕</div>
            <p>Thank you for responding, <strong>@Model.MemberName</strong>.</p>
            <p>Your session cancellation has been recorded. Your trainer has been notified that you cannot attend this gym session.</p>
            <div class="details"><div><strong>Trainer:</strong> @Model.TrainerName</div><div><strong>Date:</strong> @Model.SessionDate.ToString("MMMM d, yyyy")</div></div>
            <p class="note">Please contact the gym if you need to arrange another training time.</p>
            <button class="close" type="button" onclick="window.close()">Close</button>
        </section>
    </main>
</body>
</html>
