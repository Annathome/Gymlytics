<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gymlytics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Gymlytics.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/view-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            background: #0D0F0D;
        }

        body {
            display: flex;
            min-height: 100vh;
            margin-bottom: 0;
            background: #0D0F0D;
            overflow-x: hidden;
        }

        .nav-header {
            position: relative;
            top: 0;
            left: 0;
            z-index: 5000;
            width: 280px;
            min-height: 100vh;
            height:100%;
            background: #0A0C0A;
            border: 2px solid #225D31;
        }

        .container.g-3 {
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 20px;
        }

        .navbar-logo {
            width: 50px;
            height: 50px;
            border-radius: 50px;
            object-fit: cover;
            align-content: start;
            border: 2px solid rgb(14, 197, 45);
            padding: 0;
        }

        .admin-top {
            display: flex;
            flex-direction: row;
            position: relative;
            gap: 20px;
        }

        .navbar-brand {
            font-family: "Inria Serif",serif;
            color: white;
            font-size: 20px;
            margin-top: 10px;
        }

        .nav.container {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .navbar-nav {
            list-style: none;
            padding: 0;
            margin-top: 40px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .nav-link {
            font-family: "Inria Serif",serif;
            color: white !important;
            text-decoration: none;
            font-size: 12px;
        }

        .icon {
            color: white;
            font-size: 1rem;
        }

        .navbar-nav .nav-item {
            background: transparent;
            border: none;
            text-align: left;
            width: 100%;
            padding: 10px;
            text-decoration: none;
            border-radius: 6px;
        }

            .navbar-nav .nav-item:hover,
            .navbar-nav .nav-item.active {
                background: rgba(124,239,114,.16);
                box-shadow: inset 3px 0 0 rgb(124,239,114);
            }

        .admin-main {
            flex: 1;
            width: auto;
            min-width: 0;
            margin-left: 0;
            padding: 24px;
            background: #0D0F0D;
            
        }

        .admin-main > main {
            width: 100%;
            min-width: 0;
            margin: 0;
            padding-bottom: 0 !important;
        }

        .btn-admin {
            margin-top: auto;
            padding: 20px 0;
            text-decoration: none;
           
        }

            .btn-admin div {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .btn-admin button:hover {
                background-color: rgb(14, 197, 45);
            }

        .nav-admin {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgb(14, 197, 45);
            display: flex;
            align-items: center;
            justify-content: center;
            color: black;
            font-weight: bold;
        }

        .admin-link {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .btn-admin span {
            margin: 0;
            font-family: "Inria Serif",serif;
        }

        .admin-logout {
            display: none;
            position: absolute;
            bottom: 80px;
            left: 20px;
            width: 400px;
            max-width: calc(100vw - 40px);
            background-color: rgb(8, 61, 2);
            border-radius: 15px;
            flex-direction: column;
            padding: 25px;
            z-index: 6000;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

            .admin-logout.show {
                display: flex !important;
            }

        .email
        {
            display: flex;
            flex-direction: row;
            gap:20px;
        }

        .top-log {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .top {
            display: flex;
            flex-direction: row;
            gap: 15px;
            align-items: center;

        }

        .top-log label {
            color: rgb(211, 211, 211);
            font-family: "Inria Serif",serif;
            font-size: 16px;
        }

            .top-log label span {
                color: #ffffff;
                font-weight: bold;
            }

        .top .initials-circle {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgb(0, 163, 0);
            border-radius: 50%;
            color: #ffffff !important;
            font-size: 14px;
            line-height: 1.1;
            text-align: center;
            font-weight: bold;
            font-family: "Inria Serif",serif;
        }

        .top h3 {
            color: #ffffff !important;
            font-size: 22px;
            font-weight: bold;
            font-family: "Inria Serif",serif;
            margin: 0;
        }

        .verified-badge {
            background-color: #ffffff;
            color: #000000;
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            width: fit-content;
            font-family: sans-serif;
            margin-top: 5px;
        }

            .verified-badge i {
                color: #00a300;
                font-size: 14px;
            }

        .separator {
            border-top: 1px solid rgba(255,255,255,0.1);
            margin: 20px 0;
        }

        .admin-link-info
        {
            display:flex;
            flex-direction: column;
            gap:0;
            padding:0;
            color: white !important;
            color: #00a300;
        }

        .bottom-log a {
            text-decoration: none;
            color: rgb(157, 219, 157) !important;
            font-family: "Inria Serif",serif;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .bottom-log a:hover {
                color: #ffffff !important;
            }

        .btn-log {
            width: 100%;
            background-color: rgb(0, 210, 0);
            border-radius: 10px;
            padding: 12px;
            text-align: center;
            margin-top: 20px;
        }

            .btn-log:active {
                background-color: rgb(124,239,114);
                transform: scale(0.98);
            }

            .btn-log span {
                color: #ffffff !important;
                font-family: "Inria Serif",serif;
                font-size: 16px;
                font-weight: bold;
            }

        @@media (max-width: 900px) {
            .nav-header {
                width: 220px;
            }

            .admin-main {
                width: auto;
                margin-left: 0;
                padding: 16px;
            }

            .admin-logout {
                width: 340px;
            }
        }

    </style>
</head>

<body>
    @using System.Security.Claims
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var userName = User.Identity?.Name ?? "Administrator";
        var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Admin";
        var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "No email provided";
        var userContact = User.FindFirst(ClaimTypes.MobilePhone)?.Value ?? "No contact provided";
        var nameParts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = nameParts.Length >= 2
            ? $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpperInvariant()
            : userName[..Math.Min(2, userName.Length)].ToUpperInvariant();
    }
    <header class="nav-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm">
            <div class="container g-3">
                <section class="admin-top">
                    <img src="/images/Yokok.jpg" alt="Yokok Gym" class="navbar-logo " />
                    <h1 class="navbar-brand">YOKOKS</h1>
                </section>

                <div class="nav container ">
                    <ul class="navbar-nav flex-column">

                        <a class="nav-item @(currentAction == "ADashboard" ? "active" : "")" asp-controller="Admin" asp-action="ADashboard">
                            <i class="icon bi bi-columns-gap"></i>
                            <span class="nav-link">DASHBOARD</span>
                        </a>
                        <a class="nav-item @(currentAction == "Members" ? "active" : "")" asp-controller="Admin" asp-action="Members">
                            <i class="icon bi bi-people-fill"></i>
                            <span class="nav-link">MEMBER</span>
                        </a>
                        <a class="nav-item @(currentAction == "Attendance" ? "active" : "")" asp-controller="Admin" asp-action="Attendance">
                            <i class="icon bi bi-person-fill-check"></i>
                            <span class="nav-link">ATTENDANCE</span>
                        </a>
                        <a class="nav-item @(currentAction == "Equipment" ? "active" : "")" asp-controller="Admin" asp-action="Equipment">
                            <i class="icon bi bi-tools"></i>
                            <span class="nav-link">EQUIPMENT</span>
                        </a>
                        <a class="nav-item @(currentAction == "Trainers" ? "active" : "")" asp-controller="Admin" asp-action="Trainers">
                            <i class="icon bi bi-clipboard2-check"></i>
                            <span class="nav-link">TRAINER SCHEDULE</span>
                        </a>
                        <a class="nav-item @(currentAction == "Payments" ? "active" : "")" asp-controller="Admin" asp-action="Payments">
                            <i class="icon bi bi-cash-coin"></i>
                            <span class="nav-link">PAYMENT</span>
                        </a>
                        <a class="nav-item @(currentAction is "UserRoles" or "UserActivity" ? "active" : "")" asp-controller="Admin" asp-action="UserRoles">
                            <i class="icon bi bi-person-fill-gear"></i>
                            <span class="nav-link">USER ROLE</span>
                        </a>
                        <a class="nav-item @(currentAction == "UserAttendance" ? "active" : "")" asp-controller="Admin" asp-action="UserAttendance">
                            <i class="icon bi bi-calendar2-check-fill"></i>
                            <span class="nav-link">ATTENDANCE HISTORY</span>
                        </a>
                        <a class="nav-item" asp-controller="" asp-action="">
                            <i class="icon bi bi-person-walking"></i>
                            <span class="nav-link">WALK-INS</span>
                        </a>
                        <a class="nav-item" asp-controller="" asp-action="">
                            <i class="icon bi bi-bell-fill"></i>
                            <span class="nav-link">NOTIFICATIONS</span>
                        </a>


                    </ul>
                    <section class="btn-admin">
                        <div class="btn-admin-inner admin-Popup-btn">
                            <button type="button" class="nav-admin m-0" id="btn-view">
                                @initials
                            </button>
                            <div class="admin-link-info">
                                <span class="admin-link">@userName</span>
                                <span class="admin-role-subtitle">@userRole</span>
                            </div>
                        </div>
                    </section>
                </div>

                <section>
                    <div class="admin-logout" id="adminLogout">
                        <section class="top-log">
                            <div class="top">
                                <div class="initials-circle">@initials</div>
                                <h3>@userName</h3>
                            </div>
                            <div class="separator"></div>
                            <label>Full Name: <span>@userName</span></label>
                            <label>Contact: <span>@userContact</span></label>
                            <div class="email">
                                <label>Email: <span>@userEmail</span></label>
                                <div class="verified-badge">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Verified
                                </div>
                            </div>
                        </section>

                        <div class="separator"></div>

                        <section class="bottom-log">
                            <a class="change-pass" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key-fill"></i>
                                Change Password
                            </a>

                            <form method="post" asp-controller="Account" asp-action="Logout">
                                <button type="submit" class="btn-log"><span>LOGOUT</span></button>
                            </form>
                        </section>
                    </div>
                </section>

            </div>
        </nav>
    </header>
    <div class="admin-main">
        <main role="main" class="pb">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.querySelectorAll('.admin-Popup-btn');
            const Popup = document.getElementById('adminLogout');

            if (!Popup) return;

            btn.forEach(function (button) {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    Popup.classList.toggle('show');
                });
            });

            document.addEventListener('click', function (e) {
                if(!Popup.contains(e.target) && !e.target.closest('.admin-Popup-btn')) {

                    Popup.classList.remove('show');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
