@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gymlytics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role-dashboard-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Gymlytics.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/view-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            display: flex;
            min-height: 100vh;
            background-color: #37373A;
        }

        .nav-header {
            position: sticky;
            top: 0;
            z-index: 5000;
            width: 280px;
            min-height: 100vh;
            background: #2E2E2F;
            flex-shrink: 0;
        }

        .navbar {
            height: 100%;
            padding: 0;
        }

        .container.g-3 {
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 20px;
            position: relative;
        }

        .navbar-logo {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgb(14, 197, 45);
            padding: 0;
        }

        .admin-top {
            display: flex;
            flex-direction: row;
            position: relative;
            gap: 20px;
            align-items: center;
        }

        .navbar-brand {
            font-family: "Inria Serif", serif;
            color: white;
            font-size: 28px;
            margin: 0;
            text-decoration: none;
            font-weight: bold;
        }

        .nav.container {
            display: flex;
            flex-direction: column;
            flex: 1;
            padding: 0;
            margin-top: 20px;
        }

        .navbar-nav {
            list-style: none;
            padding: 0;
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .nav-item-btn {
            background: transparent;
            border: none;
            text-align: left;
            width: 100%;
            padding: 10px;
            display: flex;
            align-items: center;
            gap: 15px;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease-in-out;
        }

            .nav-item-btn:hover {
                border: 2px solid rgb(124, 239, 114);
            }

            .nav-item-btn.active {
                background-color: rgba(124, 239, 114, 0.2);
                border: 2px solid rgb(124, 239, 114);
            }

        .nav-link {
            font-family: "Inria Serif", serif;
            color: white !important;
            text-decoration: none;
            font-size: 16px;
            padding: 0;
            text-transform: uppercase;
        }

        .icon {
            color: white;
            font-size: 1.3rem;
        }

        .btn-admin {
            margin-top: auto;
            padding: 20px 0;
            text-decoration: none;
        }

        .btn-admin-inner {
            display: flex;
            align-items: center;
            gap: 15px;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: background-color 0.2s;
        }

            .btn-admin-inner:hover {
                background-color: rgba(14, 197, 45, 0.3);
            }

        .nav-admin {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgb(124, 239, 114);
            display: flex;
            align-items: center;
            justify-content: center;
            color: black;
            font-weight: bold;
            font-size: 18px;
            border: none;
        }

        .admin-link-info {
            display: flex;
            flex-direction: column;
        }

        .admin-link {
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-family: "Inria Serif", serif;
            font-size: 16px;
        }

        .admin-role-subtitle {
            color: white;
            font-family: "Inria Serif", serif;
            font-size: 14px;
        }

        hr {
            border: 2px solid rgb(0,0,0);
            margin-bottom: 15px;
            opacity: 1;
        }

        .admin-logout {
            display: none;
            position: absolute;
            bottom: 80px;
            left: 20px;
            width: 360px;
            background-color: #083013;
            border-radius: 15px;
            flex-direction: column;
            padding: 25px;
            z-index: 6000;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

            .admin-logout.show {
                display: flex !important;
            }

        .email {
            display: flex;
            flex-direction: row;
            gap: 15px;
            align-items: center;
        }

        .top-log {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .top {
            display: flex;
            flex-direction: row;
            gap: 15px;
            align-items: center;
        }

        .top-log label {
            color: rgb(211, 211, 211);
            font-family: "Inria Serif", serif;
            font-size: 16px;
        }

            .top-log label span {
                color: #ffffff;
                font-weight: bold;
            }

        .top .initials-circle {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgb(0, 163, 0);
            border-radius: 50%;
            color: #ffffff !important;
            font-size: 14px;
            line-height: 1.1;
            text-align: center;
            font-weight: bold;
            font-family: "Inria Serif", serif;
        }

        .top h3 {
            color: #ffffff !important;
            font-size: 22px;
            font-weight: bold;
            font-family: "Inria Serif", serif;
            margin: 0;
        }

        .verified-badge {
            background-color: #ffffff;
            color: #000000;
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            width: fit-content;
            font-family: sans-serif;
        }

            .verified-badge i {
                color: #00a300;
                font-size: 14px;
            }

        .separator {
            border-top: 1px solid rgba(255,255,255,0.2);
            margin: 15px 0;
        }

        .bottom-log a {
            text-decoration: none;
            color: rgb(157, 219, 157) !important;
            font-family: "Inria Serif", serif;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .bottom-log a:hover {
                color: #ffffff !important;
            }

        .btn-log {
            width: 100%;
            background-color: rgb(0, 210, 0);
            border-radius: 10px;
            padding: 12px;
            border: none;
            text-align: center;
            margin-top: 20px;
            cursor: pointer;
        }

            .btn-log:active {
                background-color: rgb(124, 239, 114);
                transform: scale(0.98);
            }

            .btn-log span {
                color: #ffffff !important;
                font-family: "Inria Serif", serif;
                font-size: 16px;
                font-weight: bold;
            }
    </style>
</head>

<body class="trainer-shell role-shell">
    @{
        var userName = User.Identity?.Name ?? "Trainer User";
        var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Trainer";
        var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "trainer@gymlytics.com";
        var userContact = User.FindFirst(ClaimTypes.MobilePhone)?.Value ?? "N/A";

        var nameParts = userName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[1][0]}".ToUpper()
        : (userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : "TR");

        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }

    <header class="nav-header">
        <nav class="navbar">
            <div class="container g-3">
                <section class="admin-top">
                    <img src="~/images/Yokok.jpg" alt="Yokok Gym" class="navbar-logo" />
                    <a class="navbar-brand" asp-controller="Trainer" asp-action="Schedule">YOKOKS</a>
                </section>

                <div class="nav container">
                    <ul class="navbar-nav">
                        <li>
                            <a class="nav-item-btn @(currentAction == "Schedule" ? "active" : "")" asp-controller="Trainer" asp-action="Schedule">
                                <i class="icon bi bi-calendar-event"></i>
                                <span class="nav-link">MY SCHEDULE</span>
                            </a>
                        </li>
                        <li>
                            <a class="nav-item-btn @(currentAction == "Members" ? "active" : "")" asp-controller="Trainer" asp-action="Members">
                                <i class="icon bi bi-people-fill"></i>
                                <span class="nav-link">MY MEMBERS</span>
                            </a>
                        </li>
                        <li>
                            <a class="nav-item-btn @(currentAction == "Availability" ? "active" : "")" asp-controller="Trainer" asp-action="Availability">
                                <i class="icon bi bi-clock-fill"></i>
                                <span class="nav-link">AVAILABILITY</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-item-btn @(currentAction == "Equipment" ? "active" : "")" asp-controller="Trainer" asp-action="Equipment">
                                <i class="icon bi bi-people-fill"></i>
                                <span class="nav-link">EQUIPMENT</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-item-btn @(currentAction == "Notifications" ? "active" : "")" asp-controller="Trainer" asp-action="Notifications">
                                <i class="icon bi bi-bell-fill"></i>
                                <span class="nav-link">NOTIFICATIONS</span>
                            </a>
                        </li>
                    </ul>

                    <section class="btn-admin">
                        <hr />
                        <div class="btn-admin-inner admin-Popup-btn">
                            <button type="button" class="nav-admin" id="btn-view">
                                @initials
                            </button>
                            <div class="admin-link-info">
                                <span class="admin-link">@userName</span>
                                <span class="admin-role-subtitle">@userRole</span>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- User Popover Profile Modal -->
                <div class="admin-logout" id="adminLogout">
                    <section class="top-log">
                        <div class="top">
                            <div class="initials-circle">@userRole</div>
                            <h3>@userName</h3>
                        </div>
                        <div class="separator"></div>
                        <label>Full Name: <span>@userName</span></label>
                        <label>Contact: <span>@userContact</span></label>
                        <div class="email">
                            <label>Email: <span>@userEmail</span></label>
                            <div class="verified-badge">
                                <i class="bi bi-check-circle-fill"></i>
                                Verified
                            </div>
                        </div>
                    </section>

                    <div class="separator"></div>

                    <section class="bottom-log">
                        <a class="change-pass" asp-controller="Account" asp-action="ChangePassword">
                            <i class="bi bi-key-fill"></i>
                            Change Credentials
                        </a>

                        <form method="post" asp-controller="Account" asp-action="Logout">
                            <button type="submit" class="btn-log"><span>LOGOUT</span></button>
                        </form>
                    </section>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.querySelectorAll('.admin-Popup-btn');
            const Popup = document.getElementById('adminLogout');

            btn.forEach(function (button) {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    Popup.classList.toggle('show');
                });
            });

            document.addEventListener('click', function (e) {
                if (!Popup.contains(e.target) && !e.target.closest('.admin-Popup-btn')) {
                    Popup.classList.remove('show');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
