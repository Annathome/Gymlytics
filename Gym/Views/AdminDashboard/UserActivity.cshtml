@model Gym.Models.PagedResult<Gym.Models.ActivityLogEntry>
@{
    ViewData["Title"] = "User Activity";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var user = ViewBag.User as Gym.Models.UserRoleViewModel;

    // Automatically retrieves the userId parameter directly from the current request URL
    var userId = Context.Request.Query["userId"].ToString();
}

<div class="container py-0 my-0" style="min-width: 50%;">
    <!-- Navigation Link -->
    <a asp-controller="AdminDashboard" asp-action="UserRole" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-2 mb-3 fw-bold">
        <i class="bi bi-arrow-left fs-5"></i>
        <span class="fs-6">Back to User roles</span>
    </a>

    <!-- Header Section -->
    <div class="mb-4">
        <h1 class="h4 fw-bold mb-1">@(user?.DisplayName ?? "User") Activity</h1>
        <p class="text-muted mb-0 fs-6">@(user?.Email)</p>
    </div>

    <!-- Activity Log Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
        @if (Model?.Items == null || !Model.Items.Any())
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-clock-history fs-2 d-block mb-2 text-secondary opacity-50"></i>
                <p class="mb-0 small">No login activity recorded yet.</p>
            </div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var entry in Model.Items)
                {
                    var isLogin = entry.ActionType == "Login";
                    <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3 border-light">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @(isLogin ? "bi-box-arrow-in-right text-success" : "bi-box-arrow-right text-muted")"></i>
                            <span class="fw-semibold @(isLogin ? "text-success" : "text-muted")">
                                @(isLogin ? "Logged in" : "Logged out")
                            </span>
                        </div>
                        <span class="text-muted small">
                            @entry.OccurredAt.ToString("MMM d, yyyy · h:mm tt")
                        </span>
                    </li>
                }
            </ul>
        }
    </div>

    <!-- Pagination -->
    @if (Model?.Items != null && Model.Items.Any())
    {
        <div class="d-flex justify-content-between align-items-center text-muted small mt-3">
            <span>Page @Model.Page of @Model.TotalPages &middot; @Model.TotalCount records</span>
            <div class="d-flex gap-2">
                <a asp-controller="AdminDashboard"
                   asp-action="UserActivity"
                   asp-route-userId="@userId"
                   asp-route-page="@(Model.Page - 1)"
                   class="btn btn-outline-secondary btn-sm rounded-3 @(Model.HasPrevious ? "" : "disabled")">
                    Previous
                </a>
                <a asp-controller="AdminDashboard"
                   asp-action="UserActivity"
                   asp-route-userId="@userId"
                   asp-route-page="@(Model.Page + 1)"
                   class="btn btn-outline-secondary btn-sm rounded-3 @(Model.HasNext ? "" : "disabled")">
                    Next
                </a>
            </div>
        </div>
    }
</div>