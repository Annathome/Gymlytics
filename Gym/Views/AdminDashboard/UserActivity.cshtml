@model Gym.Models.PagedResult<Gym.Models.ActivityLogEntry>
@{
    ViewData["Title"] = "User Activity";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var user = ViewBag.User as Gym.Models.UserRoleViewModel;
    // Retrieves the "id" route/query parameter for building pagination links
    var userId = Context.Request.Query["id"].ToString();
}
<style>
    .user-activity-card,
    .user-activity-card .list-group,
    .user-activity-card .list-group-item,
    .user-activity-card .card-body {
        background: #5E5D63 !important;
    }

    .user-activity-card .list-group-item {
        border-color: #293029 !important;
    }

    .user-activity-card .text-muted {
        color: #9ba49d !important;
    }
</style>
<style>
    body.admin-shell .user-activity-page { width:100%; max-width:none; padding:0 0 32px; }
    body.admin-shell .user-activity-page .activity-back { color:#b7ff1b !important; margin-bottom:24px !important; gap:10px !important; }
    body.admin-shell .user-activity-page .activity-back:hover { color:#fff !important; }
    body.admin-shell .user-activity-page .activity-heading { margin-bottom:28px !important; padding-left:18px; border-left:4px solid #b7ff1b; }
    body.admin-shell .user-activity-page .activity-heading h1 { color:#fff !important;  margin:0 0 8px !important; }
    body.admin-shell .user-activity-page .activity-heading p { color:#d0d4d1 !important; }
    body.admin-shell .user-activity-page .user-activity-card { border:1px solid #68686d !important; border-radius:14px !important; box-shadow:0 12px 28px #0003 !important; }
    body.admin-shell .user-activity-page .activity-card-heading { display:flex; align-items:center; gap:12px; padding:20px 24px; background:#303430; color:#fff; }
    body.admin-shell .user-activity-page .activity-card-heading i { color:#b7ff1b; }
    body.admin-shell .user-activity-page .activity-card-heading h2 { margin:0;  color:#fff !important; }
    body.admin-shell .user-activity-page .activity-row { padding:16px 24px !important; gap:16px; border-color:#727177 !important; }
    body.admin-shell .user-activity-page .activity-event { gap:14px !important; color:#fff; }
    body.admin-shell .user-activity-page .activity-icon { display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:50%; background:#42464a; color:#e0e4e1; }
    body.admin-shell .user-activity-page .activity-login .activity-icon { background:#b7ff1b18; color:#b7ff1b; }
    body.admin-shell .user-activity-page .activity-label { color:#fff !important;  }
    body.admin-shell .user-activity-page .activity-time { color:#e0e2e1 !important;  white-space:nowrap; }
    body.admin-shell .user-activity-page .activity-pagination { padding:18px 24px; border-radius:12px; gap:16px; flex-wrap:wrap; color:#e0e2e1 !important; }
    body.admin-shell .user-activity-page .activity-pagination .btn { border:1px solid #b7ff1b !important; color:#b7ff1b !important; background:transparent !important; }
    body.admin-shell .user-activity-page .activity-pagination .btn:hover { background:#b7ff1b !important; color:#1b201c !important; }
    body.admin-shell .user-activity-page .activity-pagination .disabled { opacity:.4; border-color:#979b97 !important; color:#c4c8c4 !important; }
    @@media (max-width:600px) {
        body.admin-shell .user-activity-page .activity-row { align-items:flex-start !important; flex-direction:column; gap:8px; padding:16px !important; }
        body.admin-shell .user-activity-page .activity-time { margin-left:50px; }
    }
</style>
<div class="container py-0 my-0 user-activity-page">
    <!-- Navigation Link -->
    <a asp-controller="Admin" asp-action="UserRoles" class="activity-back text-decoration-none d-inline-flex align-items-center gap-2 mb-3 fw-bold">
        <i class="bi bi-arrow-left fs-5"></i>
        <span class="fs-6">Back to User roles</span>
    </a>
    <!-- Header Section -->
    <div class="activity-heading mb-4">
        <h1 class="h4 fw-bold mb-1" style="font-weight:700!important;margin-bottom: 0px !important;">@(user?.DisplayName ?? "User") Activity</h1>
        <p class="text-muted mb-0 fs-6">@(user?.Email)</p>
    </div>
    <!-- Activity Log Card -->
    <div class="card user-activity-card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
        <header class="activity-card-heading"><i class="bi bi-clock-history" aria-hidden="true"></i><h2>Account activity</h2></header>
        @if (Model?.Items == null || !Model.Items.Any())
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-clock-history fs-2 d-block mb-2 text-secondary opacity-50"></i>
                <p class="mb-0 small">No login activity recorded yet.</p>
            </div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var entry in Model.Items)
                {
                    var isLogin = entry.ActionType == "Login";
                    <li class="activity-row @(isLogin ? "activity-login" : "activity-logout") list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <div class="activity-event d-flex align-items-center">
                            <i class="activity-icon bi @(isLogin ? "bi-box-arrow-in-right" : "bi-box-arrow-right")" aria-hidden="true"></i>
                            <span class="activity-label fw-semibold">
                                @(isLogin ? "Logged in" : "Logged out")
                            </span>
                        </div>
                        <span class="activity-time">
                            @entry.OccurredAt.ToString("MMM d, yyyy · h:mm tt")
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
    <!-- Pagination -->
    @if (Model?.Items != null && Model.Items.Any())
    {
        <div class="activity-pagination d-flex justify-content-between align-items-center text-muted small mt-3">
            <span class="pagination-summary">Page @Model.Page of @Model.TotalPages &middot; @Model.TotalCount records</span>
            <div class="activity-pagination-buttons d-flex gap-2">
                <a asp-controller="Admin"
                   asp-action="UserActivity"
                   asp-route-id="@userId"
                   asp-route-page="@(Model.Page - 1)"
                   class="btn btn-outline-secondary btn-sm rounded-3 @(Model.HasPrevious ? "" : "disabled")">
                    Previous
                </a>
                <a asp-controller="Admin"
                   asp-action="UserActivity"
                   asp-route-id="@userId"
                   asp-route-page="@(Model.Page + 1)"
                   class="btn btn-outline-secondary btn-sm rounded-3 @(Model.HasNext ? "" : "disabled")">
                    Next
                </a>
            </div>
        </div>
    }
</div>
