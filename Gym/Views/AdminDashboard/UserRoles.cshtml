@model Gym.Models.PagedResult<Gym.Models.UserRoleViewModel>
@{
    ViewData["Title"] = "User Role";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    * {
        box-sizing: border-box;
    }

    .page-wrap {
        font-family: 'Inter', sans-serif;
        margin: 0;
        max-width: none;
        width: 100%;
        color: #9ba49d;
        font-size: 12px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .page-header h1 {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 4px 0;
        color: #ffffff;
    }

    .page-header p {
        color: #aeb7b0;
        margin: 0;
        font-size: 12px;
    }

    .btn-invite {
        background: #b7ff1b;
        border: 1px solid #b7ff1b;
        border-radius: 8px;
        padding: 10px 18px;
        font-weight: 600;
        font-size: 12px;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        text-decoration: none;
        transition: background 0.15s ease;
        cursor: pointer;
    }

    .btn-invite:hover {
        background: #a3e617;
        color: #1a1a1a;
    }

    .registry-overlay {
        position: fixed;
        inset: 0;
        z-index: 7000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(0, 0, 0, .72);
    }

    .registry-overlay.open { display: flex; }

    .registry-dialog {
        position: relative;
        width: min(680px, 96vw);
        height: min(560px, 92vh);
        overflow: hidden;
        border: 0;
        border-radius: 12px;
        background: #171b18;
        box-shadow: 0 24px 70px rgba(0, 0, 0, .35);
    }

    .registry-frame {
        width: 100%;
        height: 100%;
        border: 0;
        background: #171b18;
    }

    .card {
        background: #272b28;
        border: 1px solid #343b37;
        border-radius: 14px;
        overflow: visible;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    .card-table th {
        background: #272b28;
        color: #8f9b92;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        padding: 16px 16px;
        border-bottom: 1px solid #343b37;
        text-align: left;
    }

    .card-table td {
        padding: 16px 16px;
        text-align: left;
        border-bottom: 1px solid #343b37;
        font-size: 12px;
        color: #d1d5db;
        vertical-align: middle;
    }

    .card-table tbody tr:last-child td {
        border-bottom: none;
    }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #1e3a2f;
        color: #b7ff1b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .user-name-text span {
        color: #ffffff !important;
        font-size: 12px !important;
        font-weight: 500;
        text-decoration: none !important;
    }

    .badge-role, .badge-status {
        font-size: 12px;
        font-weight: 600;
        padding: 0;
    }

    .badge-role { color: #b7ff1b; }
    .badge-status.badge-active { color: #b7ff1b; }
    .badge-status.badge-pending { color: #f5a623; }
    .badge-status.badge-suspended { color: #ff6268; }

    .access-text, .last-login {
        color: #9ba49d;
        font-size: 12px;
    }

    .actions-cell {
        position: relative;
        text-align: right;
        width: 50px;
        white-space: nowrap;
    }

    .menu-dots-btn {
        background: none;
        border: none;
        color: #9ca3af;
        font-size: 16px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
    }

    /* Fixed action menu styling to prevent horizontal stretching / incorrect layout */
    .action-menu {
        display: none !important;
        position: absolute;
        right: 0;
        top: 100%;
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        width: 180px;
        min-width: 180px;
        z-index: 99999;
        padding: 6px 0;
        text-align: left;
        flex-direction: column;
    }

    .action-menu.open {
        display: flex !important;
    }

    .action-menu-item {
        display: block;
        width: 100%;
        padding: 8px 16px;
        text-align: left;
        background: transparent;
        border: none;
        color: #e5e7eb;
        text-decoration: none;
        font-size: 12px;
        cursor: pointer;
        white-space: nowrap;
    }

    .action-menu-item:hover {
        background: #374151;
        color: #ffffff;
    }

    .action-menu-item.danger {
        color: #f87171;
    }

    .action-menu-item.danger:hover {
        background: #7f1d1d;
        color: #fca5a5;
    }

    .pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        font-size: 12px;
        color: #8f9b92;
        border-top: 1px solid #343b37;
    }

    .pager .btn-invite {
        background: transparent;
        border: 1px solid #48544d;
        color: #8f9b92;
        padding: 6px 14px;
        font-size: 12px;
        border-radius: 6px;
    }

    .pager .btn-invite:hover:not(.pager-disabled) {
        border-color: #b7ff1b;
        color: #b7ff1b;
        background: transparent;
    }

    .pager-disabled {
        pointer-events: none;
        opacity: 0.4;
    }

    .footer-note {
        margin-top: 24px;
        font-size: 12px;
        color: #8f9b92;
    }

    .footer-note strong {
        display: block;
        color: #ffffff;
        font-size: 12px;
        margin-bottom: 6px;
    }

    .footer-note-items {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
    }

    .floating-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        font-size: 12px;
    }

    .floating-card {
        width: min(550px,calc(100vw - 32px));
        background: #1b201c;
        color: #fff;
        border: 1px solid #3b443d;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,.4);
    }

    .floating-card h3 {
        margin: 0 0 8px;
        font-size: 14px;
        font-weight: 700;
        color: #b7ff1b;
    }

    .floating-card p {
        color: #9ba49d;
        margin: 0 0 20px;
        font-size: 12px;
    }

    .floating-warning {
        color: #f59e0b;
        background: #382c1b;
        border: 1px solid #5a4520;
        border-radius: 8px;
        padding: 10px 12px;
        margin-bottom: 20px;
        font-size: 12px;
    }

    .floating-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 22px;
    }

    .floating-cancel, .floating-confirm {
        min-height: 53px;
        border-radius: 0;
        padding: 0 20px;
        font-size: 14px;
        font-weight: 500;
        text-transform: uppercase;
        cursor: pointer;
    }

    .floating-cancel {
        background: #292d2a;
        border: 1px solid #59615b;
        color: #fff;
    }

    .floating-confirm {
        background: #b7ff1b;
        border: 1px solid #b7ff1b;
        color: #1a1a1a;
    }

    .floating-confirm.confirm-danger {
        background: #f12b2f;
        border-color: #f12b2f;
        color: #171717;
    }

    .floating-confirm.confirm-warning {
        background: #f5a623;
        border-color: #f5a623;
        color: #171717;
    }
</style>

<section class="page-wrap">
    <div class="page-header">
        <div>
            <h1>User roles</h1>
            <p>Login authentication and access control</p>
        </div>
        <div>
            <button type="button" class="btn-invite" onclick="openStaffRegistry()">
                + INVITE STAFF
            </button>
        </div>
    </div>

    <div class="card">
        <table class="card-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Access</th>
                    <th>Today's attendance</th>
                    <th>Last login</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>
                }
                else
                {
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <span class="avatar">@user.Initials</span>
                                    <span class="user-name-text">
                                        <span>@user.DisplayName</span>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span class="badge-role @user.RoleBadgeClass">@user.RoleLabel</span>
                            </td>
                            <td>
                                <span class="badge-status @user.StatusBadgeClass">@user.Status</span>
                            </td>
                            <td class="access-text">@user.Access</td>
                            <td class="last-login">@user.TodayAttendanceDisplay</td>
                            <td class="last-login">@user.LastLoginDisplay</td>
                            <td class="actions-cell">
                                <button type="button" class="menu-dots-btn" onclick="toggleMenu('@user.Id')">&#8942;</button>
                                <div class="action-menu" id="menu-@user.Id">
                                    @if (user.Status != "Pending")
                                    {
                                        <a class="action-menu-item" asp-controller="Admin" asp-action="UserActivity" asp-route-id="@user.Id">
                                            View activity
                                        </a>
                                    }

                                    @if (user.Status == "Pending")
                                    {
                                        <button type="button" class="action-menu-item danger"
                                                data-name="@user.DisplayName"
                                                data-username="@user.Username"
                                                data-action-name="Delete pending account"
                                                data-confirm-level="danger"
                                                data-question="Permanently delete the pending account for"
                                                data-message="This permanently removes the unconfirmed account and its staff logs from the database. This cannot be undone. Confirmed or registered accounts are not eligible for permanent deletion."
                                                data-url="@Url.Action("DeletePendingUser", "Admin", new { id = user.Id, page = Model.Page })"
                                                onclick="openUserActionModal(this)">Delete pending account</button>
                                    }
                                    else if (!user.IsMainAdmin && user.Status != "Deleted")
                                    {
                                        <button type="button" class="action-menu-item danger"
                                                data-name="@user.DisplayName"
                                                data-username="@user.Username"
                                                data-action-name="Delete account"
                                                data-confirm-level="danger"
                                                data-question="Soft delete the registered account for"
                                                data-message="This account will be removed from the system and cannot sign in. Its data will remain stored in the database."
                                                data-url="@Url.Action("DeleteUser", "Admin", new { id = user.Id })"
                                                onclick="openUserActionModal(this)">Delete account</button>
                                    }

                                    @if (user.TracksStaffAttendance && user.Status == "Active" && user.TodayAttendanceStatus != "Absent")
                                    {
                                        <button type="button" class="action-menu-item danger"
                                                data-name="@user.DisplayName"
                                                data-username="@user.Username"
                                                data-action-name="Mark absent"
                                                data-confirm-level="warning"
                                                data-question="Do you want to mark this user absent"
                                                data-message="Mark this staff member absent for today. Any later login using this account will not change the absent status."
                                                data-url="@Url.Action("MarkStaffAbsent", "Admin", new { id = user.Id, page = Model.Page })"
                                                onclick="openUserActionModal(this)">Mark absent</button>
                                    }

                                    @if (user.Status == "Active")
                                    {
                                        <button type="button" class="action-menu-item"
                                                data-name="@user.DisplayName"
                                                data-username="@user.Username"
                                                data-action-name="Suspend account"
                                                data-confirm-level="warning"
                                                data-question="Do you want to suspend the account for"
                                                data-message="This user will no longer be able to log in until reactivated."
                                                data-url="@Url.Action("SuspendUser", "Admin", new { id = user.Id, page = Model.Page })"
                                                onclick="openUserActionModal(this)">Suspend account</button>
                                    }
                                    @if (user.Status == "Suspended")
                                    {
                                        <button type="button" class="action-menu-item"
                                            data-name="@user.DisplayName"
                                            data-username="@user.Username"
                                            data-action-name="Reactivate account"
                                            data-question="Do you want to restore access for"
                                            data-message="This account will be able to sign in again."
                                            data-url="@Url.Action("ReactivateUser", "Admin", new { id = user.Id, page = Model.Page })"
                                            onclick="openUserActionModal(this)">Reactivate account</button>
                                     }

                                    
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (Model != null && Model.Items.Count > 0)
        {
            <div class="pager">
                <span>Page @Model.Page of @Model.TotalPages &middot; @Model.TotalCount users</span>
                <div style="display:flex;gap:8px;">
                    <a asp-action="UserRoles" asp-route-page="@(Model.Page - 1)"
                       class="btn-invite @(Model.HasPrevious ? "" : "pager-disabled")">
                        Previous
                    </a>
                    <a asp-action="UserRoles" asp-route-page="@(Model.Page + 1)"
                       class="btn-invite @(Model.HasNext ? "" : "pager-disabled")">
                        Next
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="footer-note">
        <div>
            <strong>Login security</strong>
            <div class="footer-note-items">
                <div>Password + email verification</div>
                <div>Session auto-expires after 30 min idle</div>
            </div>
        </div>
    </div>
</section>

<div id="userActionModal" class="floating-overlay" style="display:none;">
    <div class="floating-card" role="dialog" aria-modal="true">
        <h3 id="userActionTitle">Confirm action</h3>
        <p id="userActionUser"></p>
        <div class="floating-warning" id="userActionMessage"></div>
        <div class="floating-actions">
            <button type="button" class="floating-cancel" onclick="closeUserActionModal()">Cancel</button>
            <form id="userActionForm" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="floating-confirm" id="userActionConfirm">OK</button>
            </form>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="userResultModal" class="floating-overlay">
        <div class="floating-card" role="alertdialog" aria-modal="true">
            <h3 style="color:#b7ff1b;">Process successful</h3>
            <p>@successMessage</p>
            <div class="floating-actions"><button type="button" class="floating-confirm" onclick="closeUserResultModal()">OK</button></div>
        </div>
    </div>
}
else if (TempData["ErrorMessage"] is string errorMessage)
{
    <div id="userResultModal" class="floating-overlay">
        <div class="floating-card" role="alertdialog" aria-modal="true">
            <h3 style="color:#f87171;">Action unsuccessful</h3>
            <p>@errorMessage</p>
            <div class="floating-actions"><button type="button" class="floating-cancel" onclick="closeUserResultModal()">Close</button></div>
        </div>
    </div>
}

<div class="registry-overlay" id="staffRegistrationSuccess" role="alertdialog" aria-modal="true" aria-labelledby="staffSuccessTitle">
    <div style="width:min(520px,90vw);padding:32px;background:#272b28;color:white;border:1px solid #343b37;border-radius:14px;text-align:center;font-size:12px;">
        <h2 id="staffSuccessTitle" style="color:#b7ff1b;font-size:14px;">Account created</h2>
        <p>The account is pending email verification. A confirmation link was sent to <strong id="staffSuccessEmail"></strong>.</p>
        <p>The recipient must verify their email to complete registration.</p>
        <button type="button" class="floating-confirm" style="margin-top:12px;" onclick="finishStaffRegistration()">Back to User Role Dashboard</button>
    </div>
</div>
<div class="registry-overlay" id="staffRegistryModal" role="dialog" aria-modal="true" aria-label="Register new user">
    <div class="registry-dialog">
        <iframe class="registry-frame" id="staffRegistryFrame" title="Staff registration form" data-src="@Url.Action("RegisterStaff", "Account")"></iframe>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function openStaffRegistry() {
        const modal = document.getElementById('staffRegistryModal');
        const frame = document.getElementById('staffRegistryFrame');
        if (!frame.getAttribute('src')) frame.src = frame.dataset.src;
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeStaffRegistry() {
        document.getElementById('staffRegistryModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    function finishStaffRegistration() {
        closeStaffRegistry();
        window.location.assign('@Url.Action("UserRoles", "Admin")');
    }

    function showStaffRegistrationSuccess(email) {
        closeStaffRegistry();
        document.getElementById('staffSuccessEmail').textContent = email;
        document.getElementById('staffRegistrationSuccess').classList.add('open');
        document.body.style.overflow = 'hidden';
        document.querySelector('#staffRegistrationSuccess button').focus();
    }

    document.getElementById('staffRegistryFrame').addEventListener('load', function () {
        try {
            const confirmation = this.contentDocument.querySelector('[data-staff-confirmation-email]');
            if (confirmation) {
                showStaffRegistrationSuccess(confirmation.dataset.staffConfirmationEmail);
                return;
            }
            const dashboardPath = new URL('@Url.Action("UserRoles", "Admin")', window.location.origin).pathname;
            if (this.contentWindow.location.pathname.toLowerCase() === dashboardPath.toLowerCase()) {
                finishStaffRegistration();
            }
        } catch (_) {}
    });

    function openUserActionModal(button) {
        document.getElementById('userActionTitle').textContent = button.dataset.actionName + '?';
        const username = button.dataset.username || button.dataset.name;
        const question = button.dataset.question || ('Do you want to continue with');
        document.getElementById('userActionUser').textContent = question + ' "' + username + '"?';
        document.getElementById('userActionMessage').textContent = button.dataset.message;
        document.getElementById('userActionForm').action = button.dataset.url;
        const confirmButton = document.getElementById('userActionConfirm');
        confirmButton.textContent = button.dataset.actionName;
        confirmButton.classList.remove('confirm-danger', 'confirm-warning');
        if (button.dataset.confirmLevel === 'danger') confirmButton.classList.add('confirm-danger');
        else if (button.dataset.confirmLevel === 'warning') confirmButton.classList.add('confirm-warning');
        document.getElementById('userActionModal').style.display = 'flex';
    }

    function closeUserActionModal() {
        document.getElementById('userActionModal').style.display = 'none';
    }

    function closeUserResultModal() {
        const modal = document.getElementById('userResultModal');
        if (modal) modal.style.display = 'none';
    }

    function toggleMenu(id) {
        var menu = document.getElementById('menu-' + id);
        var wasOpen = menu.classList.contains('open');

        document.querySelectorAll('.action-menu.open').forEach(function (m) { 
            m.classList.remove('open'); 
        });

        if (!wasOpen) {
            menu.classList.add('open');
        }
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.actions-cell') && !e.target.closest('.action-menu')) {
            document.querySelectorAll('.action-menu.open').forEach(function (m) { 
                m.classList.remove('open'); 
            });
        }
    });

    const staffRegistryModal = document.getElementById('staffRegistryModal');
    if (staffRegistryModal) {
        staffRegistryModal.addEventListener('click', function (e) {
            if (e.target === this) closeStaffRegistry();
        });
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeStaffRegistry();
    });
</script>
