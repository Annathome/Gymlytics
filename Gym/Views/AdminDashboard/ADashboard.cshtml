@model Gym.Models.DashboardStatistics
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var trainers = Model?.Trainers ?? new List<Gym.Models.AdminTrainerListItem>();
    const int trainerPageSize = 3;
    var trainerPages = Math.Max(1, (int)Math.Ceiling(trainers.Count / (double)trainerPageSize));
    var trainerPage = Math.Clamp(int.TryParse(Context.Request.Query["trainerPage"], out var requestedTrainerPage) ? requestedTrainerPage : 1, 1, trainerPages);
    string TrainerPageUrl(int page)
    {
        var query = Context.Request.Query.ToDictionary(item => item.Key, item => item.Value.ToString());
        query["trainerPage"] = page.ToString();
        return Context.Request.PathBase + Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(query).ToString() + "#trainer-list";
    }
    var memberRevenue = Model?.TodayMemberRevenue ?? 0m;
    var walkInRevenue = Model?.TodayWalkInRevenue ?? 0m;
    var totalRevenue = memberRevenue + walkInRevenue;
    var memberRevenuePercent = totalRevenue > 0 ? (int)Math.Round(memberRevenue / totalRevenue * 100) : 0;
    var walkInRevenuePercent = totalRevenue > 0 ? 100 - memberRevenuePercent : 0;
    var todayMembers = Model?.TodayMemberAttendance ?? 0;
    var todayWalkIns = Model?.TodayWalkIns ?? 0;
    var attendanceMax = Math.Max(1, Math.Max(todayMembers, todayWalkIns));
    var memberAttendancePercent = todayMembers * 100 / attendanceMax;
    var walkInAttendancePercent = todayWalkIns * 100 / attendanceMax;
    var equipmentItems = (Model?.EquipmentStatus ?? new List<Gym.Models.AdminEquipmentStatusItem>())
        .Where(item => item.Category != "Inventory" &&
            item.Status is "Needs Maintenance" or "Out of Order" or "Fair")
        .ToList();
}
