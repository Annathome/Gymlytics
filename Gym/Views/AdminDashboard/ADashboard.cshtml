<body>
    <div class="ad-wrap">
        <div class="ad-head">
            <div>
                <h1 style="font-weight:700!important; font-size: 12px !important; margin-bottom: 0px !important;">Admin Overview</h1>
                <p class="dashboard-caption" style="color:#aeb7b0!important;line-height:1.4!important;">Live facility status and performance metrics.</p>
            </div>
            <div class="ad-head-tools">
                <div class="ad-head-bell">
                    <a class="ad-bell" asp-controller="Admin" asp-action="Notifications" title="Admin notifications" aria-label="Admin notifications">
                        <i class="bi bi-bell-fill"></i>
                        @if ((Model?.UnreadNotificationsCount ?? 0) > 0)
                        {
                            <span class="ad-bell-count">@Model!.UnreadNotificationsCount</span>
                        }
                    </a>
                </div>
            </div>

        </div>

        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="ad-notice">@success</div>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="ad-notice error">@error</div>
        }

        <section class="ad-stats">
            <div class="ad-stat">
                <div class="ad-label">Active members</div>
                <div class="ad-value" style="">@(Model?.ActiveMembers ?? 0)</div>
                <div class="ad-desc">Currently active memberships</div>
            </div>
            <div class="ad-stat">
                <div class="ad-label">Expiring soon</div>
                <div class="ad-value summary-warning" style="">@(Model?.ExpiringMembershipsCount ?? 0)</div>
                <div class="ad-desc">Memberships within 7 days</div>
            </div>
            <div class="ad-stat">
                <div class="ad-label">Maintenance</div>
                <div class="ad-value summary-danger" style="">@(Model?.EquipmentIssues ?? 0)</div>
                <div class="ad-desc">Equipment requiring attention</div>
            </div>
            <div class="ad-stat">
                <div class="ad-label">Available trainers</div>
                <div class="ad-value" style="">@trainers.Count</div>
                <div class="ad-desc">Active registered trainers</div>
            </div>
        </section>

        <section class="ad-performance">
            <div class="ad-panel">
                <div class="ad-perf-head">
                    <div>
                        <h2 class="dashboard-panel-title">REVENUE TODAY</h2>
                        <small>Members vs walk-ins</small>
                    </div>
                    <strong style="color:#b9ff20">₱@totalRevenue.ToString("N2")</strong>
                </div>
                <div class="ad-revenue-body">
                    <div class="ad-donut" style="--member:@(memberRevenuePercent)%">
                        <div class="ad-donut-value">₱@totalRevenue.ToString("N0")<small>TOTAL</small></div>
                    </div>
                    <div class="ad-breakdown">
                        <div class="ad-break-row">
                            <span><span class="ad-dot">●</span> MEMBERS</span>
                            <strong>₱@memberRevenue.ToString("N2") (@memberRevenuePercent%)</strong>
                        </div>
                        <div class="ad-break-row">
                            <span><span class="ad-dot walk">●</span> WALK-INS</span>
                            <strong>₱@walkInRevenue.ToString("N2") (@walkInRevenuePercent%)</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ad-panel">
                <div class="ad-perf-head">
                    <div>
                        <h2 class="dashboard-panel-title">ATTENDANCE TODAY</h2>
                        <small>Current volume</small>
                    </div>
                    <strong style="color:#b9ff20">@(todayMembers + todayWalkIns) visits</strong>
                </div>
                <div class="ad-bar-row">
                    <div class="ad-bar-label">
                        <span>MEMBERS</span>
                        <strong>@todayMembers</strong>
                    </div>
                    <div class="ad-bar-track">
                        <div class="ad-bar" style="width:@memberAttendancePercent%"></div>
                    </div>
                </div>
                <div class="ad-bar-row">
                    <div class="ad-bar-label">
                        <span>WALK-INS</span>
                        <strong>@todayWalkIns</strong>
                    </div>
                    <div class="ad-bar-track">
                        <div class="ad-bar walk" style="width:@walkInAttendancePercent%"></div>
                    </div>
                </div>
                <div class="ad-desc" style="margin-top:25px">Live check-in totals for @DateTime.Today.ToString("MMMM d, yyyy")</div>
            </div>
        </section>

        <section class="ad-operations">
            <div class="ad-panel ad-action-card">
                <h2 class="dashboard-panel-title"><span style="color:#b9ff20">⚑</span> ACTION REQUIRED</h2>
                <p>Weekly member attendance reminders are pending. You have <strong style="color:#fff">@(Model?.PendingWeeklyAttendanceReminders ?? 0) active member(s)</strong> to verify or follow up with.</p>
                <a class="ad-process" asp-controller="Admin" asp-action="Notifications">PROCESS REMINDERS</a>
            </div>
            <div class="ad-panel">
                <div class="ad-panel-title">
                    <span class="dashboard-panel-title">EQUIPMENT STATUS</span>
                    <a asp-controller="Admin" asp-action="Equipment" asp-route-tab="reports" style="color:#b7ff1b;text-decoration:none">View all</a>
                </div>
                <div class="ad-equipment-list">
                    @if (equipmentItems.Count > 0)
                    {
                        foreach (var equipment in equipmentItems)
                        {
                            var isIssue = !equipment.Status.Equals("Available", StringComparison.OrdinalIgnoreCase) && !equipment.Status.Equals("Good", StringComparison.OrdinalIgnoreCase);
                            var conditionClass = equipment.Status.ToLowerInvariant().Replace(' ', '-');
                            <div class="ad-equipment-row condition-@conditionClass @(isIssue ? "issue" : "")" data-dashboard-search="@equipment.Name @equipment.Category @equipment.Status">
                                <div class="ad-equipment-main">
                                    <div>
                                        <span class="ad-equipment-name">@equipment.Name</span>
                                    </div>
                                </div>
                                <span class="ad-condition @conditionClass" style="background:transparent!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;">@equipment.Status.ToUpperInvariant()</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="ad-empty">No equipment issues reported.</div>
                    }
                </div>
            </div>
        </section>

        <section class="ad-grid ad-grid--five-rows">
            <div class="ad-panel">
                <div class="ad-panel-title">
                    <span class="dashboard-panel-title">EXPIRING MEMBERSHIPS</span>
                    <a asp-controller="Admin" asp-action="Members" style="color:#b9ff20;text-decoration:none">View all</a>
                </div>
                <table class="ad-table">
                    <thead>
                        <tr>
                            <th>MEMBER</th>
                            <th>EXPIRATION</th>
                            <th>DAYS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.ExpiringMemberships?.Any() == true)
                        {
                            foreach (var item in Model.ExpiringMemberships.Take(5))
                            {
                                <tr data-dashboard-search="@item.ClientName @item.ExpirationDate.ToString("MMM d, yyyy")">
                                    <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.ClientName</td>
                                    <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.ExpirationDate.ToString("MMM d, yyyy")</td>
                                    <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@item.DaysRemaining</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="ad-empty" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">No memberships expiring soon.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ad-panel">
                <div class="ad-panel-title">
                    <span id="trainer-list" class="dashboard-panel-title">TRAINER LIST</span>
                    <span>@trainers.Count active</span>
                </div>
                <table class="ad-table">
                    <thead>
                        <tr>
                            <th>TRAINER NAME</th>
                            <th>STATUS</th>
                            <th aria-label="Actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (trainers.Count > 0)
                        {
                            foreach (var trainer in trainers.Skip((trainerPage - 1) * trainerPageSize).Take(trainerPageSize))
                            {
                                <tr data-dashboard-search="@trainer.FullName @trainer.Email active trainer">
                                    <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                                        <strong style="">@trainer.FullName</strong>
                                    </td>
                                    <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;"><span class="ad-active" style="background:transparent!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;">● Active</span></td>
                                    <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;"><button type="button" class="ad-message" data-id="@trainer.Id" data-name="@trainer.FullName" onclick="openTrainerMessage(this)" style="">MESSAGE</button></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="ad-empty" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">No active trainers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="ad-trainer-pagination">
                    <span class="pagination-summary">Page @trainerPage of @trainerPages · @trainers.Count trainers</span>
                    <nav aria-label="Trainer list pages">
                        @if (trainerPage > 1)
                        {
                            <a class="ad-trainer-page" href="@TrainerPageUrl(trainerPage - 1)">Previous</a>
                        }
                        else { <span class="ad-trainer-page" aria-disabled="true">Previous</span> }
                        @if (trainerPage < trainerPages)
                        {
                            <a class="ad-trainer-page" href="@TrainerPageUrl(trainerPage + 1)">Next</a>
                        }
                        else { <span class="ad-trainer-page" aria-disabled="true">Next</span> }
                    </nav>
                </div>
            </div>
        </section>
    </div>

    <style>
        .ad-trainer-pagination { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:16px; flex-wrap:wrap; }
        .ad-trainer-pagination nav { display:flex; gap:10px; }
        .ad-trainer-page { padding:10px 14px; border:1px solid #b7ff1b; color:#b7ff1b; text-decoration:none; }
        .ad-trainer-page:hover { color:#b7ff1b; background:transparent; }
        .ad-trainer-page[aria-disabled="true"] { opacity:.4; }
    </style>
    <div id="trainerMessageModal" class="ad-overlay" style="display:none">
        <div class="ad-modal">
            <h3>Message trainer</h3>
            <p id="trainerMessageName"></p>
            <form asp-controller="Admin" asp-action="SendTrainerMessage" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="trainerMessageId" name="id" />
                <label class="ad-field">
                    Subject
                    <input name="subject" maxlength="150" required />
                </label>
                <label class="ad-field">
                    Email message
                    <textarea name="message" rows="6" maxlength="2000" required></textarea>
                </label>
                <div class="ad-actions">
                    <button type="button" class="ad-cancel" onclick="closeTrainerMessage()">Cancel</button>
                    <button type="submit" class="ad-send">Send email</button>
                </div>
            </form>
        </div>
    </div>
    <script>
            function openTrainerMessage(b) {
                document.getElementById('trainerMessageId').value = b.dataset.id;
                document.getElementById('trainerMessageName').textContent = b.dataset.name;
                document.getElementById('trainerMessageModal').style.display = 'flex'
            }

            function closeTrainerMessage() {
                document.getElementById('trainerMessageModal').style.display = 'none'
            }

            function dashboardReportData() {
                return {
                    generatedAt: new Date().toISOString(),
                    activeMembers: @(Model?.ActiveMembers ?? 0),
                    expiringSoon: @(Model?.ExpiringMembershipsCount ?? 0),
                    equipmentIssues: @(Model?.EquipmentIssues ?? 0),
                    activeTrainers: @trainers.Count,
                    today: {
                        memberRevenue: @memberRevenue.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        walkInRevenue: @walkInRevenue.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        memberAttendance: @todayMembers,
                        walkIns: @todayWalkIns
                                        },
                    equipment: Array.from(document.querySelectorAll('.ad-equipment-row')).map(function(row) {
                        return row.innerText.trim().replace(/\s+/g, ' ')
                    }),
                    expiringMemberships: Array.from(document.querySelectorAll(
                        '.ad-grid .ad-panel:first-child tbody tr[data-dashboard-search]')).map(function(row) {
                            return row.innerText.trim().replace(/\s+/g, ' ')
                        }),
                    trainers: Array.from(document.querySelectorAll('.ad-grid .ad-panel:last-child tbody tr[data-dashboard-search]'))
                        .map(function(row) {
                            return row.innerText.trim().replace(/\s+/g, ' ')
                        })
                };
            }
            async function saveReportBlob(blob, extension, description) {
                var filename = 'YOKOKS-Admin-Report-' + new Date().toISOString().slice(0, 10) + '.' + extension;
                if (window.showSaveFilePicker) {
                    try {
                        var handle = await window.showSaveFilePicker({
                            suggestedName: filename,
                            types: [{
                                description: description,
                                accept: {
                                    [blob.type || 'application/octet-stream']: ['.' + extension]
                                }
                            }]
                        });
                        var writable = await handle.createWritable();
                        await writable.write(blob);
                        await writable.close();
                        return;
                    } catch (error) {
                        if (error && error.name === 'AbortError') return;
                    }
                }
                var url = URL.createObjectURL(blob);
                var link = document.createElement('a');
                link.href = url;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                link.remove();
                setTimeout(function() {
                    URL.revokeObjectURL(url)
                }, 1000);
            }

            function downloadReport(content, type, extension, description) {
                return saveReportBlob(new Blob([content], {
                    type: type
                }), extension, description || 'YOKOKS report');
            }

            function reportText(data) {
                return 'YOKOKS ADMIN REPORT\nGenerated: ' + data.generatedAt + '\n\nActive members: ' + data.activeMembers +
                    '\nExpiring soon: ' + data.expiringSoon + '\nEquipment issues: ' + data.equipmentIssues +
                    '\nActive trainers: ' + data.activeTrainers + '\nMember revenue today: PHP ' + data.today.memberRevenue +
                    '\nWalk-in revenue today: PHP ' + data.today.walkInRevenue + '\nMember attendance today: ' + data.today
                        .memberAttendance + '\nWalk-ins today: ' + data.today.walkIns + '\n\nEQUIPMENT\n' + data.equipment.join('\n') +
                    '\n\nEXPIRING MEMBERSHIPS\n' + data.expiringMemberships.join('\n') + '\n\nTRAINERS\n' + data.trainers.join(
                        '\n');
            }

            function exportDashboardImage(format) {
                var source = document.querySelector('.ad-wrap');
                var clone = source.cloneNode(true);
                clone.querySelectorAll('.ad-topbar,.ad-export,.ad-message,.ad-overlay').forEach(function(el) {
                    el.remove()
                });
                var styles = Array.from(document.querySelectorAll('style')).map(function(style) {
                    return style.textContent
                }).join('\n');
                var width = source.scrollWidth,
                    height = source.scrollHeight;
                var open = '\x3C',
                    close = '\x3E';
                var html = open + 'svg xmlns="http://www.w3.org/2000/svg" width="' + width + '" height="' + height + '"' + close +
                    open + 'foreignObject width="100%" height="100%"' + close + open + 'div xmlns="http://www.w3.org/1999/xhtml"' +
                    close + open + 'style' + close + styles + open + '/style' + close + clone.outerHTML + open + '/div' + close +
                    open + '/foreignObject' + close + open + '/svg' + close;
                var image = new Image();
                var url = URL.createObjectURL(new Blob([html], {
                    type: 'image/svg+xml;charset=utf-8'
                }));
                image.onload = function() {
                    var canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    var context = canvas.getContext('2d');
                    context.fillStyle = '#0d110e';
                    context.fillRect(0, 0, width, height);
                    context.drawImage(image, 0, 0);
                    URL.revokeObjectURL(url);
                    var mime = format === 'png' ? 'image/png' : 'image/jpeg';
                    canvas.toBlob(function(blob) {
                        if (blob) saveReportBlob(blob, format, format.toUpperCase() + ' image')
                    }, mime, format === 'jpeg' ? 0.92 : 1)
                };
                image.onerror = function() {
                    URL.revokeObjectURL(url);
                    alert('The image report could not be generated. Please choose PDF instead.')
                };
                image.src = url;
            }

            function toggleExportMenu(event) {
                event.stopPropagation();
                document.getElementById('exportMenu').classList.toggle('open')
            }
            document.addEventListener('click', function(event) {
                var menu = document.getElementById('exportMenu');
                if (menu && !event.target.closest('.ad-export')) menu.classList.remove('open')
            });

            function exportDashboardReport(format) {
                document.getElementById('exportMenu').classList.remove('open');
                if (format === 'pdf') {
                    window.print();
                    return;
                }
                if (format === 'png' || format === 'jpeg') {
                    exportDashboardImage(format);
                    return;
                }
                var data = dashboardReportData();
                if (format === 'json') {
                    downloadReport(JSON.stringify(data, null, 2), 'application/json', 'json', 'JSON report');
                    return;
                }
                if (format === 'doc') {
                    var lt = '\x3C',
                        gt = '\x3E';
                    var escaped = reportText(data).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                    var body = lt + 'html' + gt + lt + 'head' + gt + lt + 'meta charset="utf-8"' + gt + lt + 'title' + gt +
                        'YOKOKS Admin Report' + lt + '/title' + gt + lt + '/head' + gt + lt + 'body' + gt + lt +
                        'pre style="white-space:pre-wrap"' + gt + escaped + lt + '/pre' + gt + lt + '/body' + gt +
                        lt + '/html' + gt;
                    downloadReport(body, 'application/msword', 'doc', 'Word report');
                    return;
                }
                if (format === 'csv') {
                    var rows = [
                        ['Metric', 'Value'],
                        ['Generated', data.generatedAt],
                        ['Active members', data.activeMembers],
                        ['Expiring soon', data.expiringSoon],
                        ['Equipment issues', data.equipmentIssues],
                        ['Active trainers', data.activeTrainers],
                        ['Member revenue today', data.today.memberRevenue],
                        ['Walk-in revenue today', data.today.walkInRevenue],
                        ['Member attendance today', data.today.memberAttendance],
                        ['Walk-ins today', data.today.walkIns],
                        [],
                        ['Equipment'], ...data.equipment.map(function(x) {
                            return [x]
                        }), [],
                        ['Expiring memberships'], ...data.expiringMemberships.map(function(x) {
                            return [x]
                        }), [],
                        ['Trainers'], ...data.trainers.map(function(x) {
                            return [x]
                        })
                    ];
                    var csv = rows.map(function(row) {
                        return row.map(function(value) {
                            return '"' + String(value ?? '').replace(/"/g, '""') + '"'
                        }).join(',')
                    }).join('\r\n');
                    downloadReport(csv, 'text/csv;charset=utf-8', 'csv', 'CSV report');
                    return;
                }
                downloadReport(reportText(data), 'text/plain;charset=utf-8', 'txt', 'Text report');
            }
    </script>

</div>

</body>
