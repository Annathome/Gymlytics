@model Gym.Models.AdminEquipmentViewModel

@{
    ViewData["Title"] = "Admin Equipment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body > .container {
        max-width: none !important;
        width: 100% !important;
        padding: 0 !important;
    }

    .ae {
        min-height: 100vh;
        padding: 25px 32px;
        background: transparent;
        color: #f4f6f4;
        font-family: Arial, sans-serif;
    }

    .ae-toolbar {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-bottom: 18px;
        border-bottom: 1px solid #303430;
    }

    .ae-search {
        display: flex;
        gap: 10px;
        flex: 1;
        max-width: 900px;
    }

        .ae-search input {
            flex: 1;
            height: 45px;
            padding: 0 15px;
            background: #1b1e1c;
            border: 1px solid #8d958f;
            color: #fff;
            outline: 0;
        }

        .ae-search button {
            width: 92px;
            height: 45px;
            border: 0;
            background: #b7ff1b;
            color: #101510;
            font-size: 10px;
            font-weight: 800;
        }

    .ae-export {
        position: relative;
        margin-left: auto;
    }

        .ae-export summary {
            list-style: none;
            cursor: pointer;
            border: 1px solid #7fae1b;
            color: #b7ff1b !important;
            padding: 12px 16px;
            font-size: 10px;
            font-weight: 800;
        }

            .ae-export summary::-webkit-details-marker {
                display: none;
            }

    .ae-export-menu {
        position: absolute;
        right: 0;
        top: 45px;
        z-index: 100;
        width: 160px;
        padding: 5px;
        background: #171b18;
        border: 1px solid #3c433d;
    }

        .ae-export-menu a,
        .ae-export-menu button {
            display: block;
            width: 100%;
            padding: 9px 10px;
            border: 0;
            background: transparent;
            color: #dce3dd;
            text-align: left;
            text-decoration: none;
            font: 11px Arial;
        }

    .ae-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        margin: 22px 0;
    }

        .ae-heading h1 {
            margin: 0 0 5px;
            font-size: 25px;
        }

        .ae-heading p {
            margin: 0;
            color: #b7ff1b;
            font-size: 10px;
        }

    .ae-add {
        height: 40px;
        padding: 0 17px;
        border: 0;
        background: #b7ff1b;
        color: #101510;
        font-size: 10px;
        font-weight: 800;
    }

    .equipbtn
    {
        display:flex;
        flex-direction: row;
        gap: 20px;
    }

    .ae-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 50px;
    }

    .ae-stat {
        padding: 17px;
        background: #1d201e;
        border: 1px solid #343a35;
        border-radius: 4px;
    }

    .ae-label {
        color: #aeb6b0;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ae-value {
        margin-top: 10px;
        font-size: 27px;
        font-weight: 800;
    }

        .ae-value.available {
            color: #b7ff1b;
        }

        .ae-value.maintenance {
            color: #ffbd2e;
        }

        .ae-value.out {
            color: #ff9999;
        }

    .ae-card {
        border: 0;
        border-radius: 8px;
        background: #5E5D63;
        overflow: visible;
        box-shadow: 0 8px 20px rgba(0, 0, 0, .42);
    }

    .ae-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
    }

    .ae-table thead th:first-child {
        border-radius: 8px 0 0 0;
    }

    .ae-table thead th:last-child {
        border-radius: 0 8px 0 0;
    }

        .ae-table th,
        .ae-table td {
            padding: 14px 13px;
            text-align: left;
            border-bottom: 1px solid #313632;
            overflow-wrap: anywhere;
        }

        .ae-table th {
            background: #343735;
            color: #cbd1cc;
            font-size: 9px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .ae-table td {
            font-size: 12px;
        }

    .ae-item {
        font-weight: 700;
    }

    .ae-status {
        display: inline-block;
        padding: 4px 8px;
        background: #293226;
        color: #b7ff1b;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

        .ae-status.needs-maintenance {
            background: #44351e;
            color: #ffbd2e;
        }

        .ae-status.out-of-order {
            background: #432525;
            color: #ff9999;
        }

    .ae-actions {
        position: relative;
        display: inline-block;
    }

        .ae-actions summary {
            list-style: none;
            cursor: pointer;
        }

            .ae-actions summary::-webkit-details-marker {
                display: none;
            }

    .ae-menu {
        position: absolute;
        right: 0;
        top: 24px;
        z-index: 50;
        width: 160px;
        padding: 5px;
        background: #202421;
        border: 1px solid #414841;
    }

        .ae-menu button {
            display: block;
            width: 100%;
            padding: 8px;
            border: 0;
            background: transparent;
            color: #eee;
            text-align: left;
            font-size: 10px;
        }

            .ae-menu button:hover {
                background: #303630;
                color: #b7ff1b;
            }

    .ae-empty {
        text-align: center !important;
        color: #929b94;
        padding: 35px !important;
    }

    .ae-pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 80px;
        padding: 14px 20px;
        border-radius: 0 0 8px 8px;
        background: #5E5D63;
        box-sizing: border-box;
    }

    .ae-info {
        font-size: 15px;
        color: #aab3ac;
    }

    .ae-pages {
        display: flex;
        gap: 12px;
    }

    .ae-page {
        display: grid;
        place-items: center;
        min-width: 102px;
        height: 50px;
        padding: 0 18px;
        border: 1px solid #74777a;
        border-radius: 5px;
        background: transparent;
        color: #fff;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        box-sizing: border-box;
    }

        .ae-page.disabled {
            opacity: 0.35;
            pointer-events: none;
        }

    .ae-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 0, 0, 0.75);
    }

        .ae-modal.open {
            display: flex;
        }

    .ae-dialog {
        width: min(620px, 96vw);
        background: #202421;
        border: 1px solid #414841;
    }

        .ae-dialog h2 {
            margin: 0;
            padding: 17px 21px;
            background: #174d20;
            font-size: 19px;
        }

    .ae-form {
        padding: 22px;
    }

    .ae-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .ae-form label {
        display: block;
        margin-bottom: 6px;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .ae-form input,
    .ae-form select {
        width: 100%;
        height: 42px;
        padding: 0 11px;
        background: #171a18;
        border: 1px solid #505750;
        color: #fff;
    }

    .ae-conditions {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin-top: 15px;
    }

    .ae-condition input {
        position: absolute;
        opacity: 0;
    }

    .ae-condition span {
        display: grid;
        place-items: center;
        min-height: 65px;
        padding: 7px;
        border: 1px solid #505750;
        font-size: 10px;
        text-align: center;
    }

    .ae-condition input:checked + span {
        border-color: #b7ff1b;
        background: #263222;
        color: #b7ff1b;
    }

    .ae-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        margin-top: 20px;
    }

        .ae-modal-actions button {
            height: 38px;
            padding: 0 16px;
            border: 1px solid #555d56;
            background: #292e2a;
            color: #fff;
        }

            .ae-modal-actions button[type=submit] {
                border: 0;
                background: #b7ff1b;
                color: #101510;
                font-weight: 800;
            }

    @@media (max-width: 800px) {
        .ae {
            padding: 18px;
        }

        .ae-stats {
            grid-template-columns: 1fr 1fr;
        }

        .ae-table th,
        .ae-table td {
            padding: 8px 5px;
            font-size: 9px;
        }

        .ae-grid,
        .ae-conditions {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media print {
        @@page {
            size: landscape;
            margin: 12mm;
        }

        .nav-header,
        .admin-logout,
        .ae-toolbar,
        .ae-add,
        .ae-stats,
        .ae-pager,
        .ae-table th:last-child,
        .ae-table td:last-child {
            display: none !important;
        }

        body > .container,
        body > .container main {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .ae {
            min-height: 0;
            padding: 0;
            background: #fff !important;
            color: #111 !important;
        }

        .ae-card,
        .ae-table {
            background: #fff !important;
            color: #111 !important;
        }

            .ae-table th {
                background: #eee !important;
                color: #111 !important;
            }
    }

    /* Compact-size overrides (applied after the base rules above, on purpose) */
    .ae-toolbar {
        padding-bottom: 12px;
    }

    .ae-search {
        width: 100%;
        max-width: none;
    }

        .ae-search input {
            height: 56px;
            font-size: 15px;
        }

        .ae-search button {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            width: 120px !important;
            min-width: 120px !important;
            height: 56px !important;
            min-height: 56px !important;
            padding: 0 18px !important;
            border-radius: 0 !important;
            font-size: 15px !important;
        }

    .ae-export summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 82px;
        height: 34px;
        padding: 0;
        border-color: #343a35;
        background: #181b19;
        color: #fff;
        font-size: 9px;
    }

    .ae-export-menu {
        top: 38px;
    }

    .ae-heading {
        margin: 18px 0;
    }

        .ae-heading h1 {
            font-size: 24px;
        }

    .ae-add {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 108px !important;
        min-width: 108px !important;
        height: 34px !important;
        padding: 0 !important;
        border-radius: 0 !important;
        font-size: 9px !important;
    }

    .ae-stat {
        min-height: 82px;
        padding: 14px;
    }

    .ae-value {
        font-size: 24px;
    }

    .ae-table th,
    .ae-table td {
        padding: 12px 11px;
    }

    .ae-actions summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 24px;
        border: 0;
        color: #c8cec9;
        font-weight: 800;
    }

    .ae-modal-actions button {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: auto !important;
        min-width: 84px !important;
        border-radius: 0 !important;
    }

    #equipmentModal .ae-dialog,
    #equipmentModal .ae-form,
    #equipmentNameModal .ae-dialog,
    #equipmentNameModal .ae-form {
        background-color: #5E5D63 !important;
    }

    #equipmentModal .ae-dialog {
        border: 0 !important;
    }

    #equipmentModal .ae-dialog > h2,
    #equipmentNameModal .ae-dialog > h2 {
        background: #5E5D63 !important;
        color: #fff !important;
    }

    #equipmentModal .ae-form label,
    #equipmentModal .ae-form small,
    #equipmentNameModal .ae-form label,
    #equipmentNameModal .ae-form small {
        color: #fff !important;
    }

    #equipmentModal .ae-form input,
    #equipmentModal .ae-form select,
    #equipmentNameModal .ae-form input,
    #equipmentNameModal .ae-form select {
        background: transparent !important;
        color: #fff !important;
    }

    #equipmentModal .ae-form input::placeholder,
    #equipmentNameModal .ae-form input::placeholder {
        color: #fff !important;
        opacity: .72;
    }

    .ae-modal .ae-modal-actions button:first-child:hover,
    .ae-modal .ae-modal-actions button:first-child:focus-visible {
        color: #a8df32 !important;
    }

    #equipmentNameModal input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(1);
        opacity: 1;
        cursor: pointer;
    }

    #equipmentModal .ae-form select option {
        background: #171b18;
        color: #fff;
    }

    #equipmentModal .ae-form select {
        background-color: transparent !important;
        color: #fff !important;
        color-scheme: dark;
    }

    #equipmentModal .ae-form select option:hover,
    #equipmentModal .ae-form select option:checked,
    #equipmentModal .ae-condition:hover span {
        color: #a8df32 !important;
    }

    #equipmentStatusDecision .equipment-decision-dialog,
    #equipmentStatusDecision .equipment-decision-body {
        background: #5E5D63 !important;
    }

    .equipment-decision-dialog {
        width: min(480px, 94vw) !important;
    }

    .equipment-decision-body {
        padding: 24px;
    }

    .equipment-decision-body p {
        margin: 0 0 12px;
        color: #ffffff;
        font-size: 15px;
        line-height: 1.5;
    }

    .equipment-decision-body .equipment-decision-note {
        color: #9ba49d;
    }

    #equipmentStatusDecisionConfirm {
        border-color: #a7e62b !important;
        background: #a7e62b !important;
        color: #101510 !important;
        font-weight: 800 !important;
    }
</style>

<section class="ae">

    <div class="ae-heading">
        <div>
            <h1>Equipment</h1>
            <p>@Model.TotalAssets total items · @(Model.Maintenance + Model.OutOfService) need attention</p>
        </div>
        <div class="equipbtn">
            <button class="ae-add" type="button" onclick="openEquipmentNameModal()">＋ Add equipment name</button>
            <button class="ae-add" type="button" onclick="openEquipmentModal()">＋ Report equipment issue</button>

            <details class="ae-export">
                <summary>↧ EXPORT</summary>
                <div class="ae-export-menu">
                    <button type="button" onclick="printEquipment()">PDF / Print</button>
                    <a asp-action="ExportEquipment" asp-route-format="doc" asp-route-searchTerm="@Model.SearchTerm">Word document</a>
                    <a asp-action="ExportEquipment" asp-route-format="csv" asp-route-searchTerm="@Model.SearchTerm">CSV / Excel</a>
                    <a asp-action="ExportEquipment" asp-route-format="txt" asp-route-searchTerm="@Model.SearchTerm">Text file</a>
                </div>
            </details>
        </div>
    </div>

    <div class="ae-stats">
        <div class="ae-stat">
            <div class="ae-label">Available</div>
            <div class="ae-value available">@Model.Available</div>
        </div>
        <div class="ae-stat">
            <div class="ae-label">In use</div>
            <div class="ae-value">@Model.InUse</div>
        </div>
        <div class="ae-stat">
            <div class="ae-label">Maintenance</div>
            <div class="ae-value maintenance">@Model.Maintenance</div>
        </div>
        <div class="ae-stat">
            <div class="ae-label">Out of service</div>
            <div class="ae-value out">@Model.OutOfService</div>
        </div>
    </div>

    <div class="ae-toolbar">
        <form class="ae-search" method="get" asp-controller="Admin" asp-action="Equipment">
            <input name="searchTerm" value="@Model.SearchTerm" placeholder="Search equipment, category, or status..." />
            <button type="submit" class="equipment-search-button">SEARCH</button>
        </form>

    </div>

    <div class="ae-card">
        <table class="ae-table">

            <thead>
                <tr>
                    <th>Item</th>
                    <th>Quantity</th>
                    <th>Brought in</th>
                    <th>Evidence</th>
                    <th>Last serviced</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td class="ae-empty" colspan="7">No equipment records found.</td>
                    </tr>
                }

                @foreach (var item in Model.Items)
                {
                    var statusClass = item.Status.ToLowerInvariant().Replace(' ', '-');

                    <tr>
                        <td class="ae-item">@item.EquipmentName</td>

                        <td>@item.AvailableQuantity / @item.Quantity available</td>

                        <td>@(item.GymArrivalDate?.ToString("MMM d, yyyy") ?? "—")</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.EvidencePhotoPath))
                            {
                                <a class="ae-photo" href="@item.EvidencePhotoPath" target="_blank" rel="noopener">View photo</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td>@(item.LastMaintenanceDate?.ToString("MMM d, yyyy") ?? "—")</td>

                        <td>
                            <span class="ae-status @statusClass">@item.Status</span>
                        </td>

                        <td>
                            <details class="ae-actions">
                                <summary aria-label="Equipment actions" title="Equipment actions">⋮</summary>
                                <div class="ae-menu">
                                    @foreach (var status in new[] { "Good", "Needs Maintenance", "Out of Order" })
                                    {
                                        <form class="equipment-status-form" asp-controller="Admin" asp-action="UpdateEquipmentStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="equipmentId" value="@item.EquipmentId" />
                                            <input type="hidden" name="status" value="@status" />
                                            <button type="button"
                                                    data-equipment-name="@item.EquipmentName"
                                                    data-status="@status"
                                                    onclick="openEquipmentStatusDecision(this)">Mark @status</button>
                                        </form>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <div class="ae-pager">
            <span class="ae-info">Showing @Model.Items.Count of @Model.TotalCount equipment records</span>
            <div class="ae-pages">
                <a class="ae-page @(Model.Page <= 1 ? "disabled" : "")"
                   asp-action="Equipment"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page - 1)">
                    Previous
                </a>
                <a class="ae-page @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                   asp-action="Equipment"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page + 1)">
                    Next
                </a>
            </div>
        </div>
    </div>

</section>

<div id="equipmentModal" class="ae-modal">
    <div class="ae-dialog">
        <h2>Report Equipment Issue</h2>
        <form class="ae-form" asp-controller="Admin" asp-action="AddEquipment" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="ae-grid">
                <div>
                    <label>Equipment name</label>
                    <select name="EquipmentName" required>
                        <option value="">Select equipment...</option>
                        @foreach (var option in Model.EquipmentNames)
                        {
                            <option value="@option.Name">@option.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Quantity affected</label>
                    <input name="Quantity" type="number" min="1" value="1" required />
                </div>
            </div>

            <label style="margin-top:16px">Current condition</label>
            <div class="ae-conditions">
                @foreach (var condition in new[] { "Good", "Needs Maintenance", "Out of Order" })
                {
                    <label class="ae-condition">
                        <input type="radio" name="Condition" value="@condition" checked="@(condition == "Good")" />
                        <span>@condition</span>
                    </label>
                }
            </div>

            <div style="margin-top:16px">
                <label>Evidence photo <span>(required for equipment issues)</span></label>
                <input id="adminEvidencePhoto" name="EvidencePhoto" type="file" accept="image/jpeg,image/png,image/webp" />
                <small>JPG, PNG, or WebP; maximum 5 MB.</small>
            </div>

            <div class="ae-modal-actions">
                <button type="button" onclick="closeEquipmentModal()">Cancel</button>
                <button type="submit" @(Model.EquipmentNames.Count == 0 ? "disabled" : null)>Submit Report</button>
            </div>
        </form>
    </div>
</div>

<div id="equipmentNameModal" class="ae-modal">
    <div class="ae-dialog">
        <h2>Add Equipment Name</h2>
        <form class="ae-form" asp-controller="Admin" asp-action="AddEquipmentName" method="post">
            @Html.AntiForgeryToken()

            <div>
                <label>Equipment name</label>
                <input name="Name" required maxlength="100" placeholder="e.g. Treadmill" />
            </div>

            <div style="margin-top:16px">
                <label>Date brought in</label>
                <input name="GymArrivalDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="ae-modal-actions">
                <button type="button" onclick="closeEquipmentNameModal()">Cancel</button>
                <button type="submit">Add to dropdown</button>
            </div>
        </form>
    </div>
</div>

<div id="equipmentStatusDecision" class="ae-modal" role="dialog" aria-modal="true" aria-labelledby="equipmentStatusDecisionTitle">
    <div class="ae-dialog equipment-decision-dialog">
        <h2 id="equipmentStatusDecisionTitle">Confirm equipment status</h2>
        <div class="equipment-decision-body">
            <p id="equipmentStatusDecisionText"></p>
            <p class="equipment-decision-note">Front Desk and Trainer accounts will be notified after this change.</p>
            <div class="ae-modal-actions">
                <button type="button" onclick="closeEquipmentStatusDecision()">Cancel</button>
                <button type="button" id="equipmentStatusDecisionConfirm">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    let pendingEquipmentStatusForm = null;

    function openEquipmentModal() {
        document.getElementById('equipmentModal').classList.add('open');
    }

    function closeEquipmentModal() {
        document.getElementById('equipmentModal').classList.remove('open');
    }

    function openEquipmentNameModal() {
        document.getElementById('equipmentNameModal').classList.add('open');
    }

    function closeEquipmentNameModal() {
        document.getElementById('equipmentNameModal').classList.remove('open');
    }

    function openEquipmentStatusDecision(button) {
        pendingEquipmentStatusForm = button.closest('form');
        const equipmentName = button.dataset.equipmentName;
        const status = button.dataset.status;
        document.getElementById('equipmentStatusDecisionText').textContent =
            'Do you want to mark "' + equipmentName + '" as "' + status + '"?';
        document.getElementById('equipmentStatusDecisionConfirm').textContent = 'Mark ' + status;
        document.getElementById('equipmentStatusDecision').classList.add('open');
    }

    function closeEquipmentStatusDecision() {
        document.getElementById('equipmentStatusDecision').classList.remove('open');
        pendingEquipmentStatusForm = null;
    }

    document.getElementById('equipmentStatusDecisionConfirm').addEventListener('click', function () {
        if (!pendingEquipmentStatusForm) return;
        const form = pendingEquipmentStatusForm;
        pendingEquipmentStatusForm = null;
        form.submit();
    });

    document.getElementById('equipmentStatusDecision').addEventListener('click', function (event) {
        if (event.target === this) closeEquipmentStatusDecision();
    });

    function updateAdminEvidenceRequirement() {
        const condition = document.querySelector('#equipmentModal input[name="Condition"]:checked')?.value;
        document.getElementById('adminEvidencePhoto').required = condition !== "Good";
    }

    document.querySelectorAll('#equipmentModal input[name="Condition"]').forEach(input =>
        input.addEventListener('change', updateAdminEvidenceRequirement)
    );
    updateAdminEvidenceRequirement();

    function printEquipment() {
        const menu = document.querySelector('.ae-export');
        if (menu) menu.open = false;
        window.print();
    }
</script>
