            justify-content: center;
            border: 1px solid #7fae1b;
            background: transparent;
            color: #b7ff1b;
            padding: 15px 20px;
            font-weight: 800;
            text-align: center;
        }

            .am-export summary::-webkit-details-marker {
                display: none;
            }

            .am-export[open] summary,
            .am-export summary:hover {
                background: #242b25;
            }

    .am-export-menu {
        position: absolute;
        right: 0;
        top: 43px;
        width: 165px;
        padding: 5px;
        background: #171b18;
        border: 1px solid #3c433d;
