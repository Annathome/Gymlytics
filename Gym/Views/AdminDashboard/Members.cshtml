    }

        .am-export-menu a,
        .am-export-menu button {
            display: block;
            width: 100% !important;
            padding: 9px 10px !important;
            border: 0 !important;
            background: transparent !important;
            color: #dce3dd !important;
            text-align: left;
            font-family: Arial;
            text-decoration: none;
        }

            .am-export-menu a:hover,
            .am-export-menu button:hover {
