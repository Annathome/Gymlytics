            #cancelMemberDialog .floating-cancel:hover,
            #renewalNotice .floating-cancel:hover,
            .admin-member-dialog .admin-modal-actions button:hover {
                border-color: #b7ff1b;
                color: #b7ff1b;
            }

            .am-dialog-confirm,
            #cancelMemberDialog .floating-confirm,
            .admin-member-dialog .admin-modal-actions button[type=submit] {
                background: #b7ff1b !important;
                border-color: #b7ff1b !important;
                color: #101510 !important;
                font-weight: 800;
