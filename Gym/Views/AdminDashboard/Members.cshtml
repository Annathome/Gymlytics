@model List<Gym.Models.Client>
@using Gym.Models
@{
    ViewData["Title"] = "Members";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var trainers = ViewBag.TrainerNames as Dictionary<int, string> ?? new();
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var selectedStatus = ViewBag.Status as MemberStatus?;
    var selectedPlan = ViewBag.Plan as MembershipPlanType?;
    var selectedYear = ViewBag.Year as int?;
    var availableYears = ViewBag.Years as List<int> ?? new();
    var dailyReminderMemberIds = ViewBag.DailyReminderMemberIds as HashSet<int> ?? new();

    var resultSuccess = TempData["SuccessMessage"] as string;
    var resultWarning = TempData["WarningMessage"] as string;
    var resultError = TempData["ErrorMessage"] as string;
}

<style>
    body {
        background: #0D0F0D;
        padding: 0 !important;
    }

    .container {
        margin-top: 0;
        color: #f4f6f4;
        font-family: Arial, sans-serif;
        background: transparent;
    }

    .am-toolbar {
        margin-bottom: 20px;
        display: flex;
        position: relative;
        gap: 10px;
        align-items: center;
        border-bottom: 1px solid #303430;
        justify-content: space-between;
    }

        .am-toolbar h1 {
            font-weight: 600;
        }

    .mtop-tool {
        flex-direction: row;
        gap: 20px;
        display: flex;
    }

    .am-search {
        display: flex;
        flex: 1;
        gap: 10px;
        max-width: 804px;
    }

        .am-search input {
            flex: 1;
            height: 45px;
            background: #1b1e1c;
            border: 1px solid #8d958f;
            color: #fff;
            padding: 0 15px;
            outline: none !important;
            box-shadow: none !important;
        }

            .am-search input:focus,
            .am-search input:focus-visible {
                outline: none !important;
                box-shadow: none !important;
                border-color: #8d958f !important;
            }

        .am-search button {
            width: 92px;
            height: 45px;
            background: #b7ff1b;
            color: #101510;
            border: 0;
            padding: 0 18px;
            font-weight: 800;
        }

    .am-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 42px;
        background: #b7ff1b;
        color: #101510;
        border: 0;
        padding: 0 18px;
        font-weight: 800;
        text-decoration: none;
        box-sizing: border-box;
        width: auto;
        cursor: pointer;
    }

    .admin-registration-modal {
        position: fixed;
        inset: 0;
        z-index: 7000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 32px;
        background: rgba(0,0,0,.76);
