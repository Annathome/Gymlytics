<section class="container">
    <div class="am-top">
        <div class="am-toolbar">
            <div>
                <h1 style="font-weight:700!important;margin-bottom: 0px !important;">Members</h1>
                <p class="dashboard-caption" style="color:#aeb7b0!important;line-height:1.4!important;">@ViewBag.ActiveCount ACTIVE · @ViewBag.ExpiringCount EXPIRING MEMBERSHIP</p>
            </div>
            <div class="mtop-tool">
                <a class="am-add" asp-action="Payments" asp-route-managePlans="true" style="text-decoration:none">＋ Add membership plan</a>
                <button class="am-add" type="button" onclick="openAdminAddMemberModal()">＋ Register member</button>
                <details class="am-export">
                    <summary>↧ EXPORT</summary>
                    <div class="am-export-menu" id="memberExportMenu">
                        <button type="button" onclick="exportMemberReport('pdf')">PDF / Print</button>
                        <a asp-action="ExportMembers" asp-route-format="doc" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@selectedStatus" asp-route-plan="@selectedPlan" asp-route-year="@selectedYear">Word document</a>
                        <a asp-action="ExportMembers" asp-route-format="csv" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@selectedStatus" asp-route-plan="@selectedPlan" asp-route-year="@selectedYear">CSV / Excel</a>
                        <a asp-action="ExportMembers" asp-route-format="txt" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@selectedStatus" asp-route-plan="@selectedPlan" asp-route-year="@selectedYear">Text file</a>
                    </div>
                </details>
            </div>
        </div>

        <div class="am-head">
            <form class="am-search" method="get" asp-action="Members">
                <input type="hidden" name="status" value="@selectedStatus" />
                <input type="hidden" name="plan" value="@selectedPlan" />
                <input type="hidden" name="year" value="@selectedYear" />
                <input name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search members, IDs, or emails..." />
                <button type="submit" style="height:56px !important; box-sizing:border-box !important; ">SEARCH</button>
            </form>
            <form class="am-filters" method="get" asp-action="Members">
                <input type="hidden" name="searchTerm" value="@ViewBag.SearchTerm" />
                <select name="year" aria-label="Joined year" onchange="this.form.submit()">
                    <option value="">All years</option>
                    @foreach (var year in availableYears)
                    {
                        <option value="@year" selected="@(selectedYear == year)">@year</option>
                    }
                </select>
                <select name="status" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    @foreach (var item in Enum.GetValues<MemberStatus>())
                    {
                        <option value="@item" selected="@(selectedStatus == item)">@item</option>
                    }
                </select>
                <select name="plan" onchange="this.form.submit()">
                    <option value="">All Plans</option>
                    @foreach (var item in MembershipPlanPricing.GetActivePlans())
                    {
                        <option value="@((int)item.Plan)" selected="@(selectedPlan == item.Plan)">@item.Name</option>
                    }
                </select>
            </form>
        </div>

        <section class="am-card am-table-wrap">
            <table class="am-table">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Plan</th>
                        <th>Trainer</th>
                        <th>Schedule</th>
                        <th>Joined</th>
                        <th>Expires</th>
                        <th>Status</th>
                        <th aria-label="Actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="am-empty" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">No members found.</td>
                        </tr>
                    }
                    @foreach (var member in Model)
                    {
                        var fullName = $"{member.FirstName} {member.LastName}";
                        var initials = $"{member.FirstName.FirstOrDefault()}{member.LastName.FirstOrDefault()}";
                        var trainer = member.AssignedTrainerId.HasValue && trainers.TryGetValue(member.AssignedTrainerId.Value, out var trainerName) ? trainerName : "—";
                        var days = string.Join(", ", (member.PreferredDays ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(day => day.Length > 3 ? day[..3] : day));
                        var schedule = string.IsNullOrWhiteSpace(days) ? "—" : $"{days} · {member.PreferredTimeSlot ?? "Time not set"}";
                        var badgeClass = member.Status is MemberStatus.Expired or MemberStatus.Terminated ? "expired" : member.Status is MemberStatus.Inactive or MemberStatus.Canceled ? "inactive" : "";
                        var planPrice = MembershipPlanPricing.GetPrice(member.MembershipPlan);
                        var paidAmount = member.Status == MemberStatus.Canceled ? 0m : planPrice;
                        var cancellationEnd = member.MembershipEndDate ?? member.MembershipStartDate.AddMonths(MembershipPlanPricing.GetDurationMonths(member.MembershipPlan));
                        var cancellationDays = Math.Max(1, (cancellationEnd.Date - member.MembershipStartDate.Date).Days);
                        var cancellationUsed = Math.Clamp((DateTime.Today - member.MembershipStartDate.Date).Days, 0, cancellationDays);
                        var cancellationDeduction = decimal.Round(planPrice / cancellationDays * cancellationUsed, 2);
                        var cancellationRefund = Math.Max(0m, paidAmount - cancellationDeduction);
                        <tr>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                                <div class="am-member">
                                    <span class="am-avatar">@initials</span>
                                    <div>
                                        <div class="am-name">@fullName</div>
                                    </div>
                                </div>
                            </td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@MembershipPlanPricing.GetName(member.MembershipPlan)</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@trainer</td>
                            <td class="am-schedule" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@schedule</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@member.MembershipStartDate.ToString("MMM dd, yyyy")</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">@(member.MembershipEndDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;"><span class="am-badge @badgeClass" style="background:transparent!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;">@member.Status</span></td>
                            <td class="am-action" style="height:48px!important;padding:6px 13px!important;vertical-align:middle!important;box-sizing:border-box!important;">
                                <details class="am-actions">
                                    <summary aria-label="Member actions" title="Member actions">⋮</summary>
                                    <div class="am-actions-menu">
                                        <button class="am-menu-button" type="button"
                                                data-can-renew="@(MembershipRenewalRules.CanRenew(member.Status, member.MembershipEndDate, DateTime.Today) ? "true" : "false")"
                                                data-renewal-opens="@(member.MembershipEndDate?.AddDays(-7).ToString("MMM d, yyyy"))"
                                                data-terminated="@(member.Status == MemberStatus.Terminated ? "true" : "false")"
                                                title="Renewal opens 7 days before expiry; cancelled memberships can restart."
                                                data-client-id="@member.UserId"
                                                data-member-name="@fullName"
                                                data-plan-name="@MembershipPlanPricing.GetName(member.MembershipPlan)"
                                                data-plan-price="@planPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-expired-date="@(member.MembershipEndDate?.ToString("MMM d, yyyy") ?? "No end date")"
                                                onclick="openAdminRenewal(this)">
                                            Renew membership
                                        </button>

                                        <form asp-controller="Admin" asp-action="CancelMember" method="post" data-member-name="@fullName"
                                              data-email="@member.Email" data-price="₱@planPrice.ToString("N2")" data-paid="₱@paidAmount.ToString("N2")"
                                              data-days="@cancellationDays" data-used="@cancellationUsed" data-deduction="₱@cancellationDeduction.ToString("N2")"
                                              data-refund="₱@cancellationRefund.ToString("N2")" onsubmit="return showCancellationMessage(this);">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@member.UserId" />
                                            <button class="am-menu-button" type="submit">Cancel membership</button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="TerminateMember" method="post"
                                              data-confirm-title="Terminate membership?"
                                              data-confirm-message="This will terminate @fullName's membership. Terminated memberships cannot be renewed."
                                              data-confirm-button="Terminate"
                                              data-confirm-danger="true"
                                              onsubmit="return askConfirm(this)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@member.UserId" />
                                            <button class="am-menu-button" type="submit">Terminate</button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="MarkMemberInactive" method="post"
                                              data-confirm-title="Mark member inactive?"
                                              data-confirm-message="@fullName will be marked as inactive."
                                              data-confirm-button="Mark inactive"
                                              onsubmit="return askConfirm(this)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@member.UserId" />
                                            <button class="am-menu-button" type="submit">Mark inactive</button>
                                        </form>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="am-pager">
                <span class="pagination-summary am-page-info">Showing @Model.Count of @ViewBag.TotalCount members</span>
                <div class="am-page-actions">
                    <a class="am-page @(currentPage <= 1 ? "disabled" : "")" asp-action="Members" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@selectedStatus" asp-route-plan="@selectedPlan" asp-route-year="@selectedYear" asp-route-page="@(currentPage - 1)">Previous</a>
                    <a class="am-page @(currentPage >= totalPages ? "disabled" : "")" asp-action="Members" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@selectedStatus" asp-route-plan="@selectedPlan" asp-route-year="@selectedYear" asp-route-page="@(currentPage + 1)">Next</a>
                </div>
            </div>
        </section>
    </div>
</section>

<div id="adminPaymentModal" class="admin-member-modal">
    <div class="admin-member-dialog">
        <h3>Record member payment</h3>
        <p id="adminPaymentMember"></p>
        <p>Cash only · Remaining balance: <strong id="adminPaymentBalance"></strong></p>
        <form asp-controller="Admin" asp-action="RecordMemberPayment" method="post">
            @Html.AntiForgeryToken()
            <input id="adminPaymentId" type="hidden" name="id" />
            <label for="adminPaymentAmount">Amount (₱)</label>
            <input id="adminPaymentAmount" name="amount" type="number" min="0.01" step="0.01" required />
            <div class="admin-modal-actions">
                <button type="button" onclick="closeAdminPayment()">Cancel</button>
                <button type="submit">Record payment</button>
            </div>
        </form>
    </div>
</div>

<div id="adminAddMemberModal" class="admin-registration-modal" role="dialog" aria-modal="true" aria-label="Register member">
    <div class="admin-registration-shell">
        <iframe id="adminAddMemberFrame" class="admin-registration-frame" title="Member registration form"></iframe>
    </div>
</div>

<div id="adminRenewalModal" class="admin-member-modal">
    <div class="admin-member-dialog" role="dialog" aria-modal="true" aria-labelledby="adminRenewalTitle">
        <h3 id="adminRenewalTitle">Renew membership payment</h3>
        <p>Confirm the full cash renewal payment. A digital receipt will be sent to the member after renewal.</p>
        <div class="admin-renewal-grid">
            <div><small>Member</small><strong id="adminRenewalMember"></strong></div>
            <div><small>Plan</small><strong id="adminRenewalPlan"></strong></div>
            <div><small>Current plan ends</small><strong id="adminRenewalExpiry"></strong></div>
            <div><small>Payment required</small><strong id="adminRenewalPrice"></strong></div>
        </div>
        <form asp-controller="Admin" asp-action="RenewMember" method="post" onsubmit="return lockAdminRenewal(this)">
            @Html.AntiForgeryToken()
            <input id="adminRenewalId" type="hidden" name="id" />
            <input id="adminRenewalAmount" type="hidden" name="amount" />
            <div class="admin-modal-actions">
                <button type="button" onclick="closeAdminRenewal()">Cancel</button>
                <button type="submit">Pay and renew</button>
            </div>
        </form>
    </div>
</div>

@* Generic confirmation (Terminate / Mark inactive). Rendered once, outside the table. *@
<dialog id="confirmActionDialog" class="am-dialog" aria-labelledby="confirmActionTitle">
    <h2 id="confirmActionTitle"></h2>
    <p id="confirmActionMessage"></p>
    <div class="am-dialog-actions">
        <button type="button" class="am-dialog-cancel" onclick="closeConfirmAction()">Cancel</button>
        <button type="button" class="am-dialog-confirm" id="confirmActionButton" onclick="runConfirmAction()">Confirm</button>
    </div>
</dialog>

<dialog id="renewalNotice" aria-labelledby="renewalNoticeTitle" style="position:fixed;inset:0;margin:auto;width:min(460px,90vw);padding:28px;background:#1b201c;color:white;border:1px solid #3c443d;border-radius:12px;">
    <h2 id="renewalNoticeTitle">Membership renewal</h2>
    <p id="renewalNoticeText" style="margin:16px 0;line-height:1.6;"></p>
    <p id="renewalNoticeDate" style="color:#b7ff1b;line-height:1.6;"></p>
    <div style="display:flex;justify-content:flex-end;margin-top:24px;">
        <button type="button" class="floating-cancel" onclick="document.getElementById('renewalNotice').close()">Close</button>
    </div>
</dialog>

<dialog id="cancelMemberDialog" aria-labelledby="cancelMemberTitle" style="width:min(480px,90vw);padding:28px;background:#1b201c;color:white;border:1px solid #3c443d;border-radius:12px;">
    <h2 id="cancelMemberTitle">Review cancellation receipt</h2>
    <p id="cancelMemberMessage"></p>
    <section style="border:1px solid #3c443d;margin:18px 0;">
        <h3 style="margin:0;padding:16px;background:#b7ff1b;color:#182000">Membership cancellation</h3>
        <div style="padding:18px;line-height:1.7">
            <p>Send to: <strong id="receiptEmail"></strong></p>
            <div>Plan price: <span id="receiptPrice"></span></div>
            <div>Plan duration: <span id="receiptDays"></span> days</div>
            <div>Payment received: <span id="receiptPaid"></span></div>
            <div>Days used: <span id="receiptUsed"></span></div>
            <div>Deduction: <span id="receiptDeduction"></span></div>
            <p id="receiptCalculation" style="color:#b7ff1b;"></p>
        </div>
    </section>
    <p>Days used are counted from the day after the membership starts, whether the member attends or not. The refund is the amount paid minus the cost of elapsed membership days.</p>
    <p>The refund breakdown will be emailed to the member. Management must process the refund separately.</p>
    <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px">
        <button type="button" class="floating-cancel" onclick="document.getElementById('cancelMemberDialog').close()">Go back</button>
        <button type="button" class="floating-confirm" id="confirmMemberCancellation" onclick="confirmCancellation()">Confirm and email receipt</button>
    </div>
</dialog>

@if (resultSuccess != null || resultWarning != null || resultError != null)
{
    var kind = resultSuccess != null ? "success" : resultWarning != null ? "warning" : "error";
    var title = kind == "success" ? "Success" : kind == "warning" ? "Completed with a note" : "Something went wrong";
    var icon = kind == "success" ? "✓" : kind == "warning" ? "!" : "✕";
    <dialog id="resultDialog" class="am-dialog am-result @kind" aria-labelledby="resultTitle">
        <div class="am-result-icon" aria-hidden="true">@icon</div>
        <h2 id="resultTitle">@title</h2>
        <p>@(resultSuccess ?? resultWarning ?? resultError)</p>
        <div class="am-dialog-actions" style="justify-content:center">
            <button type="button" class="am-dialog-confirm" onclick="document.getElementById('resultDialog').close()">OK</button>
        </div>
    </dialog>
    <script>
        (() => {
            const dialog = document.getElementById('resultDialog');
            dialog.showModal();
            dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
        })();
    </script>
}

<script>
    if (window.self !== window.top) {
        window.top.location.href = window.location.href;
    }

    function openAdminAddMemberModal() {
        const modal = document.getElementById('adminAddMemberModal');
        const frame = document.getElementById('adminAddMemberFrame');
        if (!frame.src) frame.src = '@Url.Action("AddMember", "FrontDesk", new { returnToAdmin = true })';
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeAddMemberModal() {
        document.getElementById('adminAddMemberModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    let pendingCancellationForm = null;
    function showCancellationMessage(form) {
        pendingCancellationForm = form;
        document.querySelectorAll('.am-actions[open]').forEach(m => m.open = false);
        document.getElementById('cancelMemberMessage').textContent = 'Cancel the membership of ' + form.dataset.memberName + '?';
        for (const field of ['Email', 'Price', 'Days', 'Paid', 'Used', 'Deduction']) {
            document.getElementById('receipt' + field).textContent = form.dataset[field.toLowerCase()];
        }
        document.getElementById('receiptCalculation').textContent = 'Estimated refund: ' + form.dataset.refund;
        document.getElementById('cancelMemberDialog').showModal();
        return false;
    }

    function confirmCancellation() {
        if (!pendingCancellationForm) return;
        document.getElementById('confirmMemberCancellation').disabled = true;
        HTMLFormElement.prototype.submit.call(pendingCancellationForm);
        pendingCancellationForm = null;
    }

    function exportMemberReport(format) {
        const details = document.querySelector('.am-export');
        if (details) details.open = false;
        if (format === 'pdf') window.print();
    }

    function openAdminPayment(id, name, balance) {
        const modal = document.getElementById('adminPaymentModal');
        document.getElementById('adminPaymentId').value = id;
        document.getElementById('adminPaymentMember').textContent = name;
        document.getElementById('adminPaymentBalance').textContent = '₱' + Number(balance).toLocaleString('en-PH', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
        const amount = document.getElementById('adminPaymentAmount');
        amount.value = '';
        amount.max = balance;
        modal.classList.add('open');
        amount.focus();
    }

    function closeAdminPayment() {
        document.getElementById('adminPaymentModal').classList.remove('open');
    }

    function formatRenewalPeso(value) {
        return '₱' + Number(value).toLocaleString('en-PH', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function openAdminRenewal(button) {
        document.querySelectorAll('.am-actions[open]').forEach(function(menu) { menu.open = false; });
        if (button.dataset.canRenew !== 'true') {
            document.getElementById('renewalNoticeText').textContent = button.dataset.terminated === 'true'
                ? 'Terminated memberships cannot be renewed.'
                : 'Active memberships can only be renewed during the last 7 days before their end date.';
            document.getElementById('renewalNoticeDate').textContent = button.dataset.terminated !== 'true' && button.dataset.renewalOpens
                ? `${button.dataset.memberName}'s membership ends on ${button.dataset.expiredDate}. Renewal opens on ${button.dataset.renewalOpens}.`
                : '';
            document.getElementById('renewalNotice').showModal();
            return;
        }
        document.getElementById('adminRenewalId').value = button.dataset.clientId;
        document.getElementById('adminRenewalAmount').value = button.dataset.planPrice;
        document.getElementById('adminRenewalMember').textContent = button.dataset.memberName;
        document.getElementById('adminRenewalPlan').textContent = button.dataset.planName;
        document.getElementById('adminRenewalExpiry').textContent = button.dataset.expiredDate;
        document.getElementById('adminRenewalPrice').textContent = formatRenewalPeso(button.dataset.planPrice);
        document.getElementById('adminRenewalModal').classList.add('open');
    }

    function closeAdminRenewal() {
        document.getElementById('adminRenewalModal').classList.remove('open');
    }

    function lockAdminRenewal(form) {
        const submit = form.querySelector('button[type="submit"]');
        submit.disabled = true;
        submit.textContent = 'Processing...';
        return true;
    }

    let pendingConfirmForm = null;

    function askConfirm(form) {
        pendingConfirmForm = form;
        document.querySelectorAll('.am-actions[open]').forEach(m => m.open = false);
        document.getElementById('confirmActionTitle').textContent = form.dataset.confirmTitle || 'Are you sure?';
        document.getElementById('confirmActionMessage').textContent = form.dataset.confirmMessage || '';
        const button = document.getElementById('confirmActionButton');
        button.textContent = form.dataset.confirmButton || 'Confirm';
        button.disabled = false;
        button.classList.toggle('danger', form.dataset.confirmDanger === 'true');
        document.getElementById('confirmActionDialog').showModal();
        return false;
    }

    function closeConfirmAction() {
        document.getElementById('confirmActionDialog').close();
        pendingConfirmForm = null;
    }

    function runConfirmAction() {
        if (!pendingConfirmForm) return;
        document.getElementById('confirmActionButton').disabled = true;
        HTMLFormElement.prototype.submit.call(pendingConfirmForm); // bypasses onsubmit
        pendingConfirmForm = null;
    }

    // Clicking the dark backdrop closes these dialogs.
    ['confirmActionDialog', 'cancelMemberDialog', 'renewalNotice'].forEach(id => {
        const dialog = document.getElementById(id);
        dialog?.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
    });
</script>
