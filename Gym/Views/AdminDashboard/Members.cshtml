                    cursor: not-allowed;
                }

    /* ---------- Result dialog ---------- */
    .am-result {
        text-align: center;
    }

        .am-result h2 {
            color: #fff;
        }

    .am-result-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 16px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 30px;
