                color: #b7ff1b !important;
            }

    .am-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        margin: 0 0 30px;
        position: relative;
        top: 0;
    }

        .am-head h1 {
            margin: 0 0 5px;
            font-weight: 600;
        }

        .am-head p {
            margin: 0;
            color: #adb5af;
        }

    .am-filters {
        display: flex;
        gap: 10px;
    }

        .am-filters select {
            background: #171a18;
            color: #aab3ac;
            border: 1px solid #59635c;
