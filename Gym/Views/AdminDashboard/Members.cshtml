                #cancelMemberDialog .floating-confirm:hover,
                .admin-member-dialog .admin-modal-actions button[type=submit]:hover {
                    background: #1b201c !important;
                    color: #b7ff1b !important;
                }

                .am-dialog-confirm.danger {
                    background: #ef2b2b !important;
                    border-color: #ef2b2b !important;
                    color: #000 !important;
                }

                    .am-dialog-confirm.danger:hover {
                        background: #1b201c !important;
                        color: #ff8e8e !important;
