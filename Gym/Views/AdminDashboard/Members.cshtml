        }

    .am-dialog h2 {
        margin: 0 0 12px;
        color: #b7ff1b;
    }

    .am-dialog p {
        margin: 0;
        line-height: 1.6;
        color: #d0d5d1;
    }

    .am-dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

