        }

    .admin-registration-shell {
        position: relative;
        width: min(920px,92vw);
        height: min(760px,86vh);
        overflow: hidden;
        border: 1px solid #000;
        border-radius: 14px;
        background: #242824;
        box-shadow: 0 28px 80px rgba(0,0,0,.65);
    }

    .admin-registration-frame {
        width: 100%;
        height: 100%;
