@{
    ViewData["Title"] = "MainHomepage";
    Layout = "~/Views/Shared/_MainHomepageLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HOMEPAGE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">

    <style>
        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            width: 100%;
            background: rgba(217, 217, 217);
            overflow-x: hidden;
        }

        .hero-section {
            font-family: "Inria Serif", serif;
            position: relative;
            height: 100%;
            width: 100%;
            top: 0;
            padding: 0;
        }

        /* UNTOUCHED ORIGINAL HERO IMAGES */
        .yokok {
            display: flex;
            border-radius: 50% 0px 0px 50%;
            height: 100%;
            width: 80%;
            background-size: auto;
            background: cover;
            margin-top: calc(94% - 100%);
            margin-left: calc(100% - 45%);
            border: 5px solid rgb(14,197,45);
            filter: blur(3px) contrast(80%);
        }

        .f-man {
            margin-top: calc(48% - 100%);
            margin-left: 33%;
            height: 65%;
            width: 75%;
            filter: blur(7px) brightness(80%);
        }

        .man {
            height: 63%;
            width: 70%;
            margin-top: calc(45% - 100%);
            margin-left: 37%;
            position: relative;
        }

        /* REDUCED LEFT PADDING ON TEXT HERO */
        .text-hero {
            max-width: 60vw;
            position: relative;
            z-index: 10;
            padding-left: 3%; /* Reduced left padding to bring text closer to the edge */
            padding-top: 0;
            padding-right: 0;
        }

            .text-hero h1 {
                font-family: "Inria Serif", serif;
                margin-top: calc(12% - 100%);
                font-size: clamp(2rem, 4.5vw, 4.5rem);
                line-height: 1.1;
                margin-bottom: 8px;
            }

            .text-hero h3 {
                font-size: clamp(0.9rem, 1.3vw, 1.25rem);
                line-height: 1.35;
                max-width: 100%;
                padding: 0;
                margin: 0;
            }

        #btn-hero {
            margin-left: 3%; /* Matched left offset with text-hero */
            margin-top: 10px;
            display: flex;
            gap: 12px;
            position: relative;
            z-index: 10;
        }

        .btn-services, .btn-conus {
            font-size: clamp(14px, 1.1vw, 18px);
            padding: 8px 18px;
            border: 2px solid rgb(14, 197, 45);
            border-radius: 20px;
            font-weight: 100;
            font-family: "Inria Serif", serif;
            background: rgb(255,255,255);
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-services:hover,
            .btn-conus:hover {
                background: rgba(14, 197, 45, 0.2);
            }

        /* INCREASED MARGIN-TOP TO LOWER STAT CARDS */
        .stat {
            margin-top: 320px; /* Lowered cards to clear the dumbbell/man image */
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 30px;
            position: relative;
            width: 100%;
            padding: 20px;
            box-sizing: border-box;
            background: rgba(255,255,255,0.3);
            box-shadow: 0px 5px 5px 5px rgba(255,255,255,0.5);
        }

        .new-mem, .trans, .sales {
            box-sizing: border-box;
            width: 50%;
            padding: 50px 20px;
            background: rgb(255,255,255);
            text-align: center;
        }

        /* FULL-WIDTH BLACK BACKGROUND & SERVICES */
        .service {
            position: relative;
            background-color: #000;
            width: 100vw;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
            padding: 20px 3% 50px 3%;
            color: #fff;
            font-family: "Inria Serif", serif;
        }

            .service h2 {
                text-align: center;
                font-size: 2.5rem;
                margin-top: 5px;
                margin-bottom: 25px;
                letter-spacing: 1px;
            }

        .services-container {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            width: 100%;
            max-width: 1350px;
            margin: 0 auto;
        }

        .service-card {
            flex: 1;
            min-width: 280px;
            border: 3px solid rgb(14, 197, 45);
            padding: 12px 10px;
            border-radius: 12px;
            background: #111;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .service-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 8px 20px rgba(14, 197, 45, 0.3);
            }

            .service-card img {
                width: 100%;
                height: 380px;
                object-fit: cover;
                object-position: top center;
                border-radius: 8px;
                margin-bottom: 15px;
            }

            .service-card h1 {
                font-size: 1.5rem;
                font-weight: 700;
                margin-bottom: 12px;
                border-bottom: 2px solid rgb(14, 197, 45);
                padding-bottom: 6px;
            }

            .service-card p {
                font-size: 0.92rem;
                line-height: 1.4;
                color: #ddd;
                margin-bottom: 6px;
                padding: 0 5px;
            }

        .price {
            padding: 50px 5%;
            text-align: center;
        }

            .price h1 {
                font-size: 2.5rem;
            }
    </style>
</head>
<body>
    <section class="hero-section" id="hero">
        <div>
            <img src="~/images/gym.jpg" alt="yokokgym" class="yokok" />
            <img src="~/images/yummyable.png" alt="gymman" class="f-man" />
            <img src="~/images/yummyable.png" alt="gymman" class="man" />

            <div class="text-hero">
                <h1>SCULPT YOUR <br /> DREAM BODY</h1>
                <h3 class="text-sup">
                    Real strength starts here. Expert coaches.<br /> Modern equipment.
                    A community that pushes you further. <br />Your dream body isn't a dream —
                    it's a plan.
                </h3>
            </div>

            <div id="btn-hero">
                <button type="submit" class="btn-services">GYM SERVICES</button>
                <button type="submit" class="btn-conus">CONTACT US</button>
            </div>
        </div>
    </section>

    <section class="stat">
        <div class="new-mem">
            <p>TOTAL NEW MEMBER</p>
        </div>

        <div class="trans">
            <p>Total Transaction</p>
        </div>
        <div class="sales">
            <p>Sales</p>
        </div>
    </section>

    <section class="service">
        <h2>OUR SERVICES</h2>

        <div class="services-container">
            <div class="service-card">
                <img src="~/images/weightloss.jpg" alt="weightloss" />
                <h1>WEIGHT LOSS</h1>
                <p>150 minutes of moderate-intensity cardio per week</p>
                <p>Strength training sessions 2-3 times a week.</p>
            </div>

            <div class="service-card">
                <img src="~/images/musclegain.jpg" alt="musclegain" />
                <h1>MUSCLE GAIN</h1>
                <p>5–10 minutes of warm-up</p>
                <p>35–45 minutes of strength training</p>
                <p>5–10 minutes of cool-down and static stretching</p>
            </div>

            <div class="service-card">
                <img src="~/images/endurance.jpg" alt="endurance" />
                <h1>ENDURANCE</h1>
                <p>60–90 minutes for stamina and endurance</p>
                <p>30–60 minutes of moderate cardio sessions</p>
                <p>10–20 minutes for high-intensity interval training (HIIT)</p>
            </div>
        </div>
    </section>

    <section class="price">
        <h1>PRICE RATES</h1>
        <div></div>
    </section>
</body>
</html>