@{
    ViewData["Title"] = "MainHomepage";
    Layout = "~/Views/Shared/_MainHomepageLayout.cshtml";
}

<style>
    /*    GLOBAL */
    html {
        scroll-behavior: smooth;
    }

    html,
    body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        background: #f4f4f4;
        font-family: "Inria Serif", serif;
    }

    * {
        box-sizing: border-box;
    }

    main {
        width: 100%;
        margin: 0;
        padding: 0;
    }

    /*     HERO SECTION */
    .hero {
        position: relative;
        width: 100%;
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        overflow: hidden;
        background: linear-gradient( 120deg, #eeeeee 0%, #d7d7d7 35%, #8a8a8a 70%, #111111 100% );
    }

    .hero-content {
        position: relative;
        width: 52%;
        max-width: 850px;
        padding-left: 7%;
        padding-right: 30px;
        z-index: 10;
    }

        .hero-content h1 {
            margin: 0 0 30px 0;
            font-family: "Inria Serif", serif;
            font-size: clamp( 48px, 7vw, 100px );
            line-height: 0.98;
            font-weight: 700;
            color: #202020;
            text-shadow: 2px 2px 5px rgba(255,255,255,0.3);
        }

        .hero-content p {
            width: 100%;
            max-width: 650px;
            margin: 0;
            font-family: "Inria Serif", serif;
            font-size: clamp( 16px, 1.6vw, 26px );
            line-height: 1.55;
            color: #414141;
        }

    /*  HERO BUTTONS */
    .hero-buttons {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-top: 40px;
        flex-wrap: wrap;
    }

    .btn-green,
    .btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 170px;
        padding: 15px 28px;
        border-radius: 18px;
        font-family: "Inria Serif", serif;
        font-size: clamp(16px, 1.4vw, 20px);
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    }

    .btn-green {
        color: #ffffff;
        background: #15c748;
        border: 2px solid #15c748;
    }

        .btn-green:hover {
            color: #ffffff;
            background: #0fa83a;
            border-color: #0fa83a;
            transform: translateY(-3px);
        }

    .btn-outline {
        color: #202020;
        background: rgba(255,255,255,0.85);
        border: 2px solid #15c748;
    }

        .btn-outline:hover {
            color: #ffffff;
            background: #15c748;
            transform: translateY(-3px);
        }

    /*  HERO IMAGES */
    .hero-image {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 58%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
    }

    /* Background circle */

    .circle {
        position: absolute;
        right: -180px;
        top: 50%;
        transform: translateY(-50%);
        width: min(900px, 70vw);
        height: min(900px, 70vw);
        border-radius: 50%;
        overflow: hidden;
        border: 6px solid #15c748;
        box-shadow: 0 0 40px rgba(0,0,0,0.3);
        z-index: 1;
    }

        .circle img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            filter: brightness(0.7) contrast(0.95);
        }

    /* Bodybuilder */

    .bodybuilder {
        position: absolute;
        right: 30px;
        bottom: 0;
        height: 92%;
        width: auto;
        max-width: 75%;
        object-fit: contain;
        object-position: bottom center;
        z-index: 5;
        filter: drop-shadow( 0 15px 20px rgba(0,0,0,0.35) );
    }

    /* STATISTICS */
    .stats {
        width: 100%;
        padding: 60px 7%;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 25px;
        background: #111111;
    }

    .stat-card {
        min-width: 0;
        padding: 35px 25px;
        text-align: center;
        background: #1d1d1d;
        border: 2px solid transparent;
        border-radius: 18px;
        transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }

        .stat-card:hover {
            border-color: #15c748;
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.3);
        }

        .stat-card h2 {
            margin: 0 0 10px 0;
            color: #15c748;
            font-size: clamp( 36px, 4vw, 48px );
            font-weight: 700;
        }

        .stat-card p {
            margin: 0;
            color: #ffffff;
            font-size: clamp( 14px, 1.3vw, 17px );
            letter-spacing: 1px;
        }


    /* SERVICES */
    .services {
        width: 100%;
        padding: 100px 7%;
        background: #f7f7f7;
    }

    .services-title {
        width: 100%;
        max-width: 800px;
        margin: 0 auto 60px;
        text-align: center;
    }

        .services-title h2 {
            margin: 0;
            color: #222222;
            font-size: clamp( 40px, 5vw, 65px );
            font-weight: 700;
        }

        .services-title p {
            margin-top: 20px;
            color: #666666;
            font-size: clamp( 16px, 1.5vw, 18px );
            line-height: 1.6;
        }


    /*  SERVICE GRID */
    .service-grid {
        width: 100%;
        max-width: 1300px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 30px;
    }

    .service-card {
        position: relative;
        min-width: 0;
        overflow: hidden;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .service-card img {
            display: block;
            width: 100%;
            height: 330px;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .service-card:hover img {
            transform: scale(1.05);
        }

    .service-content {
        padding: 30px;
    }

        .service-content h3 {
            margin: 0 0 15px;
            color: #15c748;
            font-size: clamp( 25px, 2.5vw, 30px );
        }

        .service-content p {
            margin: 0;
            color: #555555;
            font-size: clamp( 15px, 1.4vw, 17px );
            line-height: 1.7;
        }

    .learn-btn {
        display: inline-block;
        margin-top: 25px;
        padding: 12px 25px;
        color: #ffffff;
        background: #15c748;
        border-radius: 10px;
        text-decoration: none;
        transition: background 0.3s ease, transform 0.3s ease;
    }

        .learn-btn:hover {
            color: #ffffff;
            background: #0da739;
            transform: translateY(-2px);
        }

    /* PRICING  */
    .pricing {
        width: 100%;
        padding: 100px 7%;
        background: #111111;
    }

    .pricing-title {
        margin-bottom: 60px;
        text-align: center;
    }

        .pricing-title h2 {
            margin: 0;
            color: #ffffff;
            font-size: clamp( 40px, 5vw, 65px );
            font-weight: 700;
        }

        .pricing-title p {
            margin-top: 15px;
            color: #bbbbbb;
            font-size: clamp( 16px, 1.5vw, 18px );
        }

    /* PRICE GRID */
    .price-grid {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 30px;
        align-items: stretch;
    }

    .price-card {
        min-width: 0;
        padding: 40px 30px;
        text-align: center;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        transition: transform 0.3s ease;
    }

        .price-card:hover {
            transform: translateY(-10px);
        }

        .price-card.featured {
            border: 4px solid #15c748;
            transform: scale(1.03);
        }

            .price-card.featured:hover {
                transform: scale(1.03) translateY(-10px);
            }

        .price-card h3 {
            margin: 0 0 15px;
            color: #222222;
            font-size: clamp( 25px, 2.5vw, 30px );
        }

    .price {
        margin-bottom: 20px;
        color: #15c748;
        font-size: clamp( 40px, 5vw, 55px );
        font-weight: 700;
    }

        .price span {
            color: #666666;
            font-size: 16px;
            font-weight: 400;
        }

    .price-card ul {
        padding: 0;
        margin: 25px 0;
        list-style: none;
    }

        .price-card ul li {
            padding: 9px 0;
            color: #555555;
            font-size: 16px;
            border-bottom: 1px solid #eeeeee;
        }

            .price-card ul li:last-child {
                border-bottom: none;
            }

    /* /*   TRAINERS */
    .trainers {
        width: 100%;
        padding: 100px 7%;
        background: #f5f5f5;
    }

    .trainer-title {
        margin-bottom: 60px;
        text-align: center;
    }

        .trainer-title h2 {
            margin: 0;
            color: #222222;
            font-size: clamp( 40px, 5vw, 65px );
            font-weight: 700;
        }

    .trainer-grid {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px;
    }

    .trainer-card {
        min-width: 0;
        overflow: hidden;
        text-align: center;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: transform 0.3s ease;
    }

        .trainer-card:hover {
            transform: translateY(-8px);
        }

        .trainer-card img {
            display: block;
            width: 100%;
            height: 350px;
            object-fit: cover;
        }

        .trainer-card h3 {
            margin: 25px 0 8px;
            color: #222222;
            font-size: clamp( 22px, 2vw, 26px );
        }

        .trainer-card p {
            margin: 0 0 25px;
            color: #15c748;
            font-size: 17px;
        }

    /*   CONTACT */
    .contact {
        width: 100%;
        padding: 100px 7%;
        text-align: center;
        background: linear-gradient( 135deg, #222222, #050505 );
    }

        .contact h2 {
            margin: 0;
            color: #ffffff;
            font-size: clamp( 40px, 5vw, 65px );
            font-weight: 700;
        }

        .contact p {
            width: 100%;
            max-width: 700px;
            margin: 25px auto;
            color: #dddddd;
            font-size: clamp( 16px, 1.6vw, 20px );
            line-height: 1.7;
        }

    .contact-btn {
        display: inline-block;
        margin-top: 20px;
        padding: 16px 40px;
        color: #ffffff;
        background: #15c748;
        border-radius: 12px;
        text-decoration: none;
        font-size: 18px;
        transition: background 0.3s ease, transform 0.3s ease;
    }

        .contact-btn:hover {
            color: #ffffff;
            background: #0da739;
            transform: translateY(-3px);
        }



    @@media (max-width: 1200px) {

        .hero-content {
            width: 55%;
        }

            .hero-content h1 {
                font-size: clamp( 55px, 6vw, 75px );
            }

            .hero-content p {
                font-size: 20px;
            }

        .circle {
            width: 700px;
            height: 700px;
            right: -220px;
        }

        .bodybuilder {
            height: 82%;
            right: 0;
        }

        .stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


   
    @@media (max-width: 992px) {

        .hero {
            min-height: auto;
            flex-direction: column;
            justify-content: center;
            padding-top: 30px;
        }

        .hero-content {
            width: 100%;
            max-width: 900px;
            padding: 70px 30px 30px;
            text-align: center;
        }

            .hero-content h1 {
                font-size: clamp( 50px, 8vw, 70px );
            }

            .hero-content p {
                margin-left: auto;
                margin-right: auto;
                max-width: 700px;
            }

        .hero-buttons {
            justify-content: center;
        }

        .hero-image {
            position: relative;
            width: 100%;
            height: 600px;
            right: auto;
            bottom: auto;
        }

        .circle {
            width: 550px;
            height: 550px;
            left: 50%;
            right: auto;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        .bodybuilder {
            left: 50%;
            right: auto;
            transform: translateX(-50%);
            height: 570px;
            max-width: 80%;
        }

        .service-grid,
        .price-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .trainer-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 768px) {

        .hero-content {
            padding-left: 25px;
            padding-right: 25px;
        }

            .hero-content h1 {
                font-size: 52px;
                line-height: 1.05;
            }

            .hero-content p {
                font-size: 17px;
                line-height: 1.6;
            }

        .hero-image {
            height: 500px;
        }

        .circle {
            width: 430px;
            height: 430px;
        }

        .bodybuilder {
            height: 480px;
        }

        .stats {
            padding: 40px 20px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .services,
        .pricing,
        .trainers,
        .contact {
            padding: 75px 25px;
        }

        .service-grid,
        .price-grid,
        .trainer-grid {
            grid-template-columns: 1fr;
        }

        .price-card.featured {
            transform: none;
        }

            .price-card.featured:hover {
                transform: translateY(-10px);
            }

        .service-card img {
            height: 300px;
        }
    }

    /*  RESPONSIVE */

    @@media (max-width: 576px) {

        .hero {
            padding-top: 20px;
        }

        .hero-content {
            padding: 40px 20px 20px;
        }

            .hero-content h1 {
                font-size: 42px;
                line-height: 1.05;
            }

            .hero-content p {
                font-size: 16px;
                line-height: 1.6;
            }

        .hero-buttons {
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        .btn-green,
        .btn-outline {
            width: 100%;
            max-width: 280px;
        }

        .hero-image {
            height: 430px;
        }

        .circle {
            width: 350px;
            height: 350px;
        }

        .bodybuilder {
            height: 410px;
            max-width: 90%;
        }

        .stats {
            padding: 35px 15px;
            grid-template-columns: 1fr;
        }

        .stat-card {
            width: 100%;
        }

        .services,
        .pricing,
        .trainers,
        .contact {
            padding: 60px 20px;
        }

        .services-title {
            margin-bottom: 40px;
        }

        .service-card img {
            height: 280px;
        }

        .service-content {
            padding: 25px;
        }

        .price-card {
            padding: 35px 20px;
        }

        .trainer-card img {
            height: 300px;
        }

        .contact p {
            font-size: 16px;
        }
    }

    /*  EXTRA SMALL DEVICES*/

    @@media (max-width: 400px) {

        .hero-content h1 {
            font-size: 36px;
        }

        .hero-image {
            height: 380px;
        }

        .circle {
            width: 300px;
            height: 300px;
        }

        .bodybuilder {
            height: 360px;
        }

        .services,
        .pricing,
        .trainers,
        .contact {
            padding-left: 15px;
            padding-right: 15px;
        }
    }
</style>

<!-- HERO SECTION -->

<section class="hero" id="home">

