@{
    ViewData["Title"] = "MainHomepage";
    Layout = "~/Views/Shared/_MainHomepageLayout.cshtml";
}

<style>
    /*    GLOBAL */
    html {
        scroll-behavior: smooth;
    }

    html,
    body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: clip;
        background: #f4f4f4;
        font-family: "Inria Serif", serif;
    }

    * {
        box-sizing: border-box;
    }

    main {
        width: 100%;
        margin: 0;
        padding: 0;
    }

    /*     HERO SECTION */
    .hero {
        position: relative;
        width: 100%;
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        overflow: hidden;
        background: linear-gradient( 120deg, #eeeeee 0%, #d7d7d7 35%, #8a8a8a 70%, #111111 100% );
    }

    .hero-content {
        position: relative;
        width: 52%;
        max-width: 850px;
        padding-left: 7%;
        padding-right: 30px;
        z-index: 10;
    }

        .hero-content h1 {
            margin: 0 0 30px 0;
            font-family: "Inria Serif", serif;
            
            line-height: 0.98;
            font-weight: 700;
            color: #202020;
            text-shadow: 2px 2px 5px rgba(255,255,255,0.3);
        }

        .hero-content p {
            width: 100%;
            max-width: 650px;
            margin: 0;
            font-family: "Inria Serif", serif;
            
            line-height: 1.55;
            color: #414141;
        }

    /*  HERO BUTTONS */
    .hero-buttons {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-top: 40px;
        flex-wrap: wrap;
    }

    .btn-green,
    .btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 170px;
        padding: 15px 28px;
        border-radius: 18px;
        font-family: "Inria Serif", serif;
        
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    }

    .btn-green {
        color: #000000;
        background: #b7ff1b;
        border: 2px solid #b7ff1b;
    }

        .btn-green:hover,
        .btn-green:focus-visible {
            color: #b7ff1b;
            background: transparent;
            border-color: #b7ff1b;
            transform: translateY(-3px);
        }

    .btn-outline {
        color: #b7ff1b;
        background: transparent;
        border: 2px solid #b7ff1b;
    }

        .btn-outline:hover,
        .btn-outline:focus-visible {
            color: #000000;
            background: #b7ff1b;
            transform: translateY(-3px);
        }

    /*  HERO IMAGES */
    .hero-image {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 58%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
    }

    /* Background circle */

    .circle {
        position: absolute;
        right: -180px;
        top: 50%;
        transform: translateY(-50%);
        width: min(900px, 70vw);
        height: min(900px, 70vw);
        border-radius: 50%;
        overflow: hidden;
        border: 6px solid #b7ff1b;
        box-shadow: 0 0 40px rgba(0,0,0,0.3);
        z-index: 1;
    }

        .circle img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            filter: brightness(0.7) contrast(0.95);
        }

    /* Bodybuilder */

    .bodybuilder {
        position: absolute;
        right: 30px;
        bottom: 0;
        height: 92%;
        width: auto;
        max-width: 75%;
        object-fit: contain;
        object-position: bottom center;
        z-index: 5;
        filter: drop-shadow( 0 15px 20px rgba(0,0,0,0.35) );
    }

    /* STATISTICS */
    .stats {
        width: 100%;
        padding: 60px 7%;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 25px;
        background: #111111;
    }

    .stat-card {
        min-width: 0;
        padding: 35px 25px;
        text-align: center;
        background: #1d1d1d;
        border: 2px solid transparent;
        border-radius: 18px;
        transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }


        .stat-card h2 {
            margin: 0 0 10px 0;
            color: #15c748;
            font-size:30px !important;
            font-weight: 700;
        }

        .stat-card p {
            margin: 0;
            color: #ffffff;
            font-size: 30px !important;
            letter-spacing: 1px;
        }


    /* SERVICES */
    .services {
        width: 100%;
        padding: 100px 7%;
        background: #f7f7f7;
    }

    .services-title {
        width: 100%;
        max-width: 800px;
        margin: 0 auto 60px;
        text-align: center;
    }

        .services-title h2 {
            margin: 0;
            color: #222222;
            
            font-weight: 700;
        }

        .services-title p {
            margin-top: 20px;
            color: #666666;
            
            line-height: 1.6;
        }


    /*  SERVICE GRID */
    .service-grid {
        width: 100%;
        max-width: 1300px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 30px;
    }

    .service-card {
        position: relative;
        min-width: 0;
        overflow: hidden;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .service-card img {
            display: block;
            width: 100%;
            height: 330px;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .service-card:hover img {
            transform: scale(1.05);
        }

    .service-content {
        padding: 30px;
    }

        .service-content h3 {
            margin: 0 0 15px;
            color: #15c748;
            
        }

        .service-content p {
            margin: 0;
            color: #555555;
            
            line-height: 1.7;
        }

    /* PRICING  */
    .pricing {
        width: 100%;
        padding: 100px 7%;
        background: #111111;
    }

    .pricing-title {
        margin-bottom: 60px;
        text-align: center;
    }

        .pricing-title h2 {
            margin: 0;
            color: #ffffff;
            
            font-weight: 700;
        }

        .pricing-title p {
            margin-top: 15px;
            color: #bbbbbb;
            
        }

    /* PRICE GRID */
    .price-grid {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 30px;
        align-items: stretch;
    }

    .price-card {
        min-width: 0;
        padding: 40px 30px;
        text-align: center;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        transition: transform 0.3s ease;
    }

        .price-card:hover {
            transform: translateY(-10px);
        }

        .price-card.featured {
            border: 4px solid #15c748;
            transform: scale(1.03);
        }

            .price-card.featured:hover {
                transform: scale(1.03) translateY(-10px);
            }

        .price-card h3 {
            margin: 0 0 15px;
            color: #222222;
            
        }

    .price {
        margin-bottom: 20px;
        color: #15c748;
        
        font-weight: 700;
    }

        .price span {
            color: #666666;
            
            font-weight: 400;
        }

    .price-card ul {
        padding: 0;
        margin: 25px 0;
        list-style: none;
    }

        .price-card ul li {
            padding: 9px 0;
            color: #555555;
            
            border-bottom: 1px solid #eeeeee;
        }

            .price-card ul li:last-child {
                border-bottom: none;
            }

    /* /*   TRAINERS */
    .trainers {
        width: 100%;
        padding: 100px 7%;
        background: #f5f5f5;
    }

    .trainer-title {
        margin-bottom: 60px;
        text-align: center;
    }

        .trainer-title h2 {
            margin: 0;
            color: #222222;
            
            font-weight: 700;
        }

    .trainer-grid {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px;
    }

    .trainer-card {
        min-width: 0;
        overflow: hidden;
        text-align: center;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: transform 0.3s ease;
    }

        .trainer-card:hover {
            transform: translateY(-8px);
        }

        .trainer-card img {
            display: block;
            width: 100%;
            height: 350px;
            object-fit: cover;
        }

        .trainer-card h3 {
            margin: 25px 0 8px;
            color: #222222;
            
        }

        .trainer-card p {
            margin: 0 0 25px;
            color: #15c748;
            
        }

    /*   CONTACT */
    .contact {
        width: 100%;
        padding: 100px 7%;
        text-align: center;
        background: linear-gradient( 135deg, #222222, #050505 );
    }

        .contact h2 {
            margin: 0;
            color: #ffffff;
            
            font-weight: 700;
        }

        .contact p {
            width: 100%;
            max-width: 700px;
            margin: 25px auto;
            color: #dddddd;
            
            line-height: 1.7;
        }

    .contact-btn {
        display: inline-block;
        margin-top: 20px;
        padding: 16px 40px;
        color: #ffffff;
        background: #15c748;
        border-radius: 12px;
        text-decoration: none;
        
        transition: background 0.3s ease, transform 0.3s ease;
    }

        .contact-btn:hover {
            color: #ffffff;
            background: #0da739;
            transform: translateY(-3px);
        }



    @@media (max-width: 1200px) {

        .hero-content {
            width: 55%;
        }

            .hero-content h1 {
                
            }

            .hero-content p {
                
            }

        .circle {
            width: 700px;
            height: 700px;
            right: -220px;
        }

        .bodybuilder {
            height: 82%;
            right: 0;
        }

        .stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


   
    @@media (max-width: 992px) {

        .hero {
            min-height: auto;
            flex-direction: column;
            justify-content: center;
            padding-top: 30px;
        }

        .hero-content {
            width: 100%;
            max-width: 900px;
            padding: 70px 30px 30px;
            text-align: center;
        }

            .hero-content h1 {
                
            }

            .hero-content p {
                margin-left: auto;
                margin-right: auto;
                max-width: 700px;
            }

        .hero-buttons {
            justify-content: center;
        }

        .hero-image {
            position: relative;
            width: 100%;
            height: 600px;
            right: auto;
            bottom: auto;
        }

        .circle {
            width: 550px;
            height: 550px;
            left: 50%;
            right: auto;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        .bodybuilder {
            left: 50%;
            right: auto;
            transform: translateX(-50%);
            height: 570px;
            max-width: 80%;
        }

        .service-grid,
        .price-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .trainer-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 768px) {

        .hero-content {
            padding-left: 25px;
            padding-right: 25px;
        }

            .hero-content h1 {
                
                line-height: 1.05;
            }

            .hero-content p {
                
                line-height: 1.6;
            }

        .hero-image {
            height: 500px;
        }

        .circle {
            width: 430px;
            height: 430px;
        }

        .bodybuilder {
            height: 480px;
        }

        .stats {
            padding: 40px 20px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .services,
        .pricing,
        .trainers,
        .contact {
            padding: 75px 25px;
        }

        .service-grid,
        .price-grid,
        .trainer-grid {
            grid-template-columns: 1fr;
        }

        .price-card.featured {
            transform: none;
        }

            .price-card.featured:hover {
                transform: translateY(-10px);
            }

        .service-card img {
            height: 300px;
        }
    }

    /*  RESPONSIVE */

    @@media (max-width: 576px) {

        .hero {
            padding-top: 20px;
        }

        .hero-content {
            padding: 40px 20px 20px;
        }

            .hero-content h1 {
                
                line-height: 1.05;
            }

            .hero-content p {
                
                line-height: 1.6;
            }

        .hero-buttons {
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        .btn-green,
        .btn-outline {
            width: 100%;
            max-width: 280px;
        }

        .hero-image {
            height: 430px;
        }

        .circle {
            width: 350px;
            height: 350px;
        }

        .bodybuilder {
            height: 410px;
            max-width: 90%;
        }

        .stats {
            padding: 35px 15px;
            grid-template-columns: 1fr;
        }

        .stat-card {
            width: 100%;
        }

        .services,
        .pricing,
        .trainers,
        .contact {
            padding: 60px 20px;
        }

        .services-title {
            margin-bottom: 40px;
        }

        .service-card img {
            height: 280px;
        }

        .service-content {
            padding: 25px;
        }

        .price-card {
            padding: 35px 20px;
        }

        .trainer-card img {
            height: 300px;
        }

        .contact p {
            
        }
    }

    /*  EXTRA SMALL DEVICES*/

    @@media (max-width: 400px) {

        .hero-content h1 {
            
        }

        .hero-image {
            height: 380px;
        }

        .circle {
            width: 300px;
            height: 300px;
        }

        .bodybuilder {
            height: 360px;
        }

        .services,
        .pricing,
        .trainers,
        .contact {
            padding-left: 15px;
            padding-right: 15px;
        }
    }

    /* Give service images enough vertical space to show the full subject. */
    .service-card img {
        height: 500px;
        object-fit: cover;
        object-position: center center;
    }

    @@media (max-width: 768px) {
        .service-card img { height: 420px; }
    }

    @@media (max-width: 576px) {
        .service-card img { height: 360px; }
    }

    /* Match the role dashboard visual system on the public homepage. */
    body {
        background: #343438 !important;
        color: #fff;
    }

    .hero,
    .services,
    .pricing,
    .trainers,
    .contact,
    .stats {
        background: #343438 !important;
    }

    .hero {
        background: linear-gradient(135deg, #343438 0%, #2b2b2e 62%, #202522 100%) !important;
    }

    .hero-content h1,
    .hero-content p,
    .services-title p,
    .pricing-title p,
    .trainers-title h2,
    .trainers-title p,
    .contact-title h2,
    .contact-title p {
        color: #fff !important;
    }

    .services-title h2,
    .pricing-title h2 {
        color: #b7ff1b !important;
    }

    .service-card,
    .price-card,
    .trainer-card,
    .contact-card,
    .stat-card {
        background: #5e5d63 !important;
        color: #fff !important;
        border: 1px solid #535159;
        box-shadow: 0 8px 20px rgba(0, 0, 0, .42);
    }

    .service-content p,
    .price-card li,
    .trainer-card p,
    .contact-card p,
    .stat-card p {
        color: #d0d5d1 !important;

    }

    .service-content h3,
    .price-card h3,
    .stat-card h2 {
        color: #b7ff1b !important;

    }

    .stat-card h2 {
        
        line-height: 1;
        font-size: 30px !important;

    }


    .stats {
        width: min(1400px, 100%);
        margin: 0 auto;
        padding: 60px 6%;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 32px;
    }

    .stat-card {
        min-height: 170px;
        padding: 34px 28px;
    }

    .stat-card h2 {
            font-size: 30px !important;
        
    }

    .stat-card p {
            font-size: 30px !important;
        
    }

    .service-content h3 {
        
        text-align: center;
    }

    .price-card,
    .price-card.featured {
        border: 2px solid transparent !important;
    }

    .price-card:hover,
    .price-card.featured:hover {
        border-color: #b7ff1b !important;
    }

    .hero {
        padding-top: 0 !important;
    }

    .hero-content {
        padding-top: 0 !important;
    }

    .hero-image {
        overflow: visible;
    }

    main[role="main"] .hero {
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    main[role="main"] .hero .hero-image {
        overflow: visible !important;
    }

    main[role="main"] .hero .bodybuilder {
        left: auto;
        right: -8%;
        bottom: 0;
        height: 100%;
        width: auto;
        max-width: none;
        transform: none;
        z-index: 20 !important;
    }

    .hero-content h1,
    .services-title h2,
    .pricing-title h2 {
        
        text-transform: uppercase;
    }

    @@media (max-width: 768px) {
        .stats { grid-template-columns: 1fr; gap: 20px; }
    }
</style>

<!-- HERO SECTION -->

<section class="hero" id="home">

    <div class="hero-content">

        <h1>
            SCULPT YOUR
            <br />
            DREAM BODY
        </h1>
        <p>
            Real strength starts here.
            Expert coaches.
            Modern equipment.
            A community that pushes you further.
            Your dream body isn't a dream —<br />
            it's a plan.
        </p>

        <div class="hero-buttons">
            <a href="#services" class="btn-green"> GYM SERVICES  </a>
            <a href="#contact" class="btn-outline">  CONTACT US </a>
        </div>
    </div>

    <!-- HERO IMAGES -->
    <div class="hero-image">

        <!-- Background gym circle -->
        <div class="circle">
            <img src="~/images/gym.jpg" alt="Yokok Gym" />
        </div>
        <!-- Bodybuilder -->
        <img src="~/images/yummyable.png" class="bodybuilder" alt="Gym Trainer" />
    </div>
</section>

<!--STATISTICS -->
<section class="stats" id="homepage-statistics">

    <div class="stat-card">
        <h2 data-count-to="@ViewBag.ActiveMembers">@ViewBag.ActiveMembers</h2>
        <p>
            ACTIVE MEMBERS
        </p>
    </div>

    <div class="stat-card">
        <h2 data-count-to="@ViewBag.ActiveTrainers">@ViewBag.ActiveTrainers</h2>
        <p>
            PROFESSIONAL TRAINERS
        </p>
    </div>

    <div class="stat-card">
        <h2 data-count-to="@ViewBag.MonthlyVisits">@ViewBag.MonthlyVisits</h2>
        <p>
            MONTHLY VISITS
        </p>
    </div>

</section>

<!-- SERVICES -->
<section class="services" id="services">

    <div class="services-title">

        <h2>
            OUR SERVICES
        </h2>
        <p>
            Train with expert coaches using
            modern equipment designed to help
            you achieve your fitness goals.
        </p>
    </div>


    <div class="service-grid">
        <!-- WEIGHT LOSS -->
        <div class="service-card">

            <img src="~/images/weightloss.jpg" alt="Weight Loss" />

            <div class="service-content">

                <h3>
                    Weight Loss
                </h3>
                <p>
                    Burn calories through guided
                    cardio, strength training,
                    and customized workout plans.
                </p>

            </div>
        </div>
        <!-- MUSCLE GAIN -->

        <div class="service-card">

            <img src="~/images/musclegain.jpg" alt="Muscle Gain" />
            <div class="service-content">

                <h3>
                    Muscle Gain
                </h3>
                <p>
                    Build lean muscle through
                    progressive strength training
                    and expert coaching.
                </p>

            </div>
        </div>
        <!-- ENDURANCE -->

        <div class="service-card">

            <img src="~/images/endurance.jpg" alt="Endurance Training" />

            <div class="service-content">
                <h3>
                    Endurance Training
                </h3>
                <p>
                    Improve stamina,
                    cardiovascular health,
                    and athletic performance
                    with structured programs.
                </p>

            </div>
        </div>
    </div>
</section>

<!-- PRICING -->

<section class="pricing" id="pricing">

    <div class="pricing-title">
        <h2>
            PAYMENT TYPE
        </h2>
        <p>
            Choose the plan that fits
            your fitness journey.
        </p>

    </div>


    <div class="price-grid">
        @foreach (var plan in (ViewBag.MembershipPlans as IReadOnlyList<(MembershipPlanType Plan, string Name, decimal Price)> ?? Array.Empty<(MembershipPlanType, string, decimal)>()))
        {
            <div class="price-card @(plan.Plan == MembershipPlanType.Monthly ? "featured" : "")">
                <h3>@plan.Name</h3>
                <div class="price">₱@plan.Price.ToString("N0")</div>
                <ul>
                    <li>✔ Gym Access</li>
                    <li>✔ Equipment Use</li>
                    @if (plan.Plan == MembershipPlanType.Monthly)
                    {
                        <li>✔ Personal Trainer</li>
                    }
                    else
                    {
                        <li>✔ Locker</li>
                    }
                </ul>
            </div>
        }

        @foreach (var paymentType in (ViewBag.WalkInPaymentTypes as List<WalkInPaymentType> ?? new List<WalkInPaymentType>()))
        {
            <div class="price-card walk-in-plan">
                <h3>@paymentType.Name</h3>
                <div class="price">₱@paymentType.Amount.ToString("N0")</div>
                <ul>
                    <li>✔ Walk-in gym access</li>
                    <li>✔ Equipment use</li>
                </ul>
            </div>
        }
    </div>
</section>
<!-- CONTACT -->
<section class="contact"
         id="contact">
    <h2>
        READY TO START?
    </h2>
    <p>
        Join Yokoks Gym today and become
        the strongest version of yourself.
    </p>
    <a href="#home" class=" contact-btn"> JOIN NOW </a>
</section>

@section Scripts {
    <script>
        (() => {
            // Keep server-rendered totals when animation is unavailable or unwanted.
            if (!('IntersectionObserver' in window) ||
                window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const animations = new WeakMap();
            const observer = new IntersectionObserver(entries => {
                for (const entry of entries) {
                    const number = entry.target.querySelector('[data-count-to]');
                    if (!entry.isIntersecting) {
                        cancelAnimationFrame(animations.get(entry.target));
                        animations.delete(entry.target);
                        number.textContent = '0';
                        continue;
                    }
                    if (entry.intersectionRatio < 0.35 || animations.has(entry.target)) continue;
                    const total = Number(number.dataset.countTo);
                    const started = performance.now();
                    const tick = now => {
                        const progress = Math.min((now - started) / 1200, 1);
                        number.textContent = String(Math.floor(total * progress));
                        if (progress < 1) animations.set(entry.target, requestAnimationFrame(tick));
                    };
                    animations.set(entry.target, requestAnimationFrame(tick));
                }
            }, { threshold: [0, 0.35] });

            document.querySelectorAll('.stats .stat-card').forEach(card => {
                const number = card.querySelector('[data-count-to]');
                if (!number || !Number.isFinite(Number(number.dataset.countTo))) return;
                number.textContent = '0';
                observer.observe(card);
            });
        })();
    </script>
}
