<style>
    .recovery-card { box-sizing:border-box;width:min(480px,calc(100% - 32px));margin:60px auto;padding:32px;background:#1b201c;color:#fff;border:1px solid #59635c;border-radius:14px; }
    .recovery-card h1 { color:#fff; }
    .recovery-card p { line-height:1.6; }
    .recovery-card label { display:block;margin:18px 0 8px; }
    .recovery-card input:not([type=hidden]) { box-sizing:border-box;width:100%;padding:14px;background:#252b26;color:white;border:1px solid #59635c; }
    @@layer recoveryButtons {
        .reset-password-card h1 { line-height:1.25!important; }
        .reset-password-card label { font-weight:600!important;line-height:1.5!important; }
        .reset-password-card input:not([type=hidden]) { line-height:1.5!important; }
        .reset-password-card a, .reset-password-card p { line-height:1.5!important; }
        .reset-password-card input[name=ConfirmPassword] { margin-bottom:0!important; }
        .reset-password-card .confirm-password-field { margin-bottom:24px!important; }
        .reset-password-card button { margin-top:0!important; }
        .recovery-card input[type=email] { margin-bottom:20px!important; }
        .recovery-card button {
            width:100%;margin:24px 0;background:#b7ff1b!important;color:#182000!important;
            min-height:48px!important;font-weight:700!important;
            border:1px solid #b7ff1b!important;
            transition:background-color .15s,color .15s;
        }
        .recovery-card button:is(:hover, :focus-visible) {
            background:transparent!important;color:#b7ff1b!important;border-color:#b7ff1b!important;
        }
